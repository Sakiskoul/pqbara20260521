@CONFERENCE{Li2025,
	author = {Li, Zhen and Liao, Qi},
	title = {Quantum-Enabled Cybercrime: A Portfolio Analysis of Cryptocurrency Theft and Double-Spending},
	year = {2025},
	journal = {eCrime Researchers Summit, eCrime},
	pages = {},
