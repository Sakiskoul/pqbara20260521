@ARTICLE{Selvaraj20268296,
	author = {Selvaraj, Arikumar K. and Kannan, Karuna Soundari and Krishnamoorthy, Sri Ram and Anandhan, Deepak Kumar and Prathiba, Sahaya Beni and Sah, Dinesh Kumar and Donta, Praveen Kumar},
	title = {QuaRTA-6G: Unified Post-Quantum Security and Quantum Learning for UAVs in 6G IoT},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {5},
	pages = {8296 - 8308},
	doi = {10.1109/JIOT.2025.3631644},
	url = {https://www.scopus.com/pages/publications/105021441725?origin=resultslist},
	affiliations = {College of Engineering and Technology, Srm Institute of Science and Technology (SRMIST), Department of Data Science and Business Systems, Kattankulathur, 603203, India; Vellore Institute of Technology, School of Electronics Engineering, Chennai, 600127, India; St. Joseph's Institute of Technology, Department of Computer Science and Engineering, Chennai, 600119, India; Vellore Institute of Technology, Centre for Cyber Physical Systems, School of Computer Science and Engineering, Chennai, 600127, India; MΓ¤lardalen University, Division of Networked and Embedded Systems, VΓ¤sterΓ¥s, 722 20, Sweden; University of Oulu, Center for Ubiquitous Computing, Oulu, 90014, Finland; Stockholm University, Department of Computer Systems and Sciences, Stockholm, 164 25, Sweden},
	abstract = {Unmanned aerial vehicles (UAVs), as key enablers of 6G-enabled Internet of Things (IoT) ecosystems, facilitate dynamic aerial coverage, seamless edge intelligence, and adaptive routing. However, despite these advantages, the reliability and trustworthiness of UAV swarms in 6G remain critical concerns due to rising quantum threats and limitations of traditional machine learning approaches. This article presents QuaRTA-6G, a quantum-resilient, trust-aware, and accountable framework that provides a unified solution for 6G UAV swarms. QuaRTA-6G achieves security, trust, and efficiency by seamlessly combining post-quantum cryptography (PQC) for secure communication, a decentralized ledger for identity and trust management, and variational quantum federated learning (VQFL) for efficient swarm intelligence. For quantum-resistant authentication and immutable UAV identity verification, QuaRTA-6G leverages CRYSTALS-Kyber with blockchain. Through simulations, QuaRTA-6G achieves secure authentication handshakes in under 2 ms and scales robustly to swarms of more than 100 UAVs, keeping high integrity even under 20% packet loss. Experiments demonstrate that, even under strong data poisoning attacks, the framework achieves 92% accuracy and 85% mission success rate, while comprehensive resource analysis confirms its feasibility across both standard and resource-constrained UAV platforms. Furthermore, an ablation study demonstrates that each module of QuaRTA-6G is essential for ensuring a responsible and trustworthy 6G UAV framework. Β© 2014 IEEE.},
