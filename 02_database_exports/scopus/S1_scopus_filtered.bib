@CONFERENCE{Chalkias20254809,
	author = {Chalkias, Kostas Kryptos},
	title = {Poster: Post-Quantum Readiness in EdDSA Chains},
	year = {2025},
	journal = {CCS 2025 - Proceedings of the 2025 ACM SIGSAC Conference on Computer and Communications Security},
	pages = {4809 - 4811},
