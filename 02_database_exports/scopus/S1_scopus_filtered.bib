}

@CONFERENCE{Jillani2026,
	author = {Jillani, Nosheen and Khattak, Asad Masood and Ullah, Rizwan and Asghar, Muhammad Zubair and Khalil, Ashraf},
	title = {Securing Multi-Agent Networks Against Shadow AI: An Explainable and Quantum-Resilient Framework},
	year = {2026},
