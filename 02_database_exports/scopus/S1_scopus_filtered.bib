	author_keywords = {anomaly detection; cryptography; digital twin; encryption; IEC 62351; Industrial Control Systems; intrusion detection; SCADA security},
	keywords = {Authentication; Digital twin; Industrial management; Industrial research; Intelligent control; Internet protocols; Learning systems; Legacy systems; Network security; Quantum cryptography; SCADA systems; Anomaly detection; Defense research; Early designs; Future research directions; IEC 62351; Industrial control systems; Intrusion-Detection; Legacy protocol; Real time performance; SCADA security; Anomaly detection; Intrusion detection},
