@ARTICLE{Nerem2023,
	author = {Nerem, Robert R. and Gaur, Daya R.},
	title = {Conditions for advantageous quantum Bitcoin mining},
	year = {2023},
	journal = {Blockchain: Research and Applications},
	volume = {4},
	number = {3},
	pages = {},
	doi = {10.1016/j.bcra.2023.100141},
	url = {https://www.scopus.com/pages/publications/85170530734?origin=resultslist},
	affiliations = {Institute for Quantum Science and Technology, University of Calgary, T2N 1N4, AB, Canada; Department of Mathematics, University of California San Diego, 92093, CA, United States; Department of Mathematics and Computer Science, University of Lethbridge, T1K 3M4, AB, Canada},
	abstract = {Our aim is to determine the conditions for quantum computing technology to give rise to the security risks associated with quantum Bitcoin mining. Specifically, we determine the speed and energy efficiency a quantum computer needs to offer an advantage over classical mining. We analyze the setting in which the Bitcoin network is entirely classical except for a single quantum miner with a small hash rate compared to the network. We develop a closed-form approximation for the probability that the quantum miner successfully mines a block, with this probability dependent on the number of Grover iterations the quantum miner applies before making a measurement. Next, we show that for a quantum miner that is β€peacefulβ€, this success probability is maximized if the quantum miner applies Grover iterations for 16 β€‹min before measuring, which is surprising, as the network mines blocks every 10 β€‹min on average. Using this optimal mining procedure, we show that the quantum miner outperforms a classical computer in efficiency (cost per block) if the condition Q β€‹< β€‹Crb is satisfied, where Q is the cost of a Grover iteration, C is the cost of a classical hash, r is the quantum miner's speed in Grover iterations per second, and b is a factor that attains its maximum if the quantum miner uses our optimal mining procedure. This condition lays the foundation for determining when quantum mining and the known security risks associated with it will arise. Β© 2023 The Authors},
	author_keywords = {Bitcoin; Grover search; Quantum algorithms; Quantum attacks; Quantum mining},
	keywords = {Bitcoin; Iterative methods; Quantum computers; Quantum theory; Computing technology; Condition; Grover iterations; Grover's search; Quanta computers; Quantum algorithms; Quantum attack; Quantum Computing; Quantum mining; Security risks; Energy efficiency},
	correspondence_address = {R.R. Nerem; University of California San Diego, United States; email: riley.nerem@gmail.com},
	publisher = {Zhejiang University},
	issn = {20967209},
	language = {English},
	abbrev_source_title = {Blockchain},
