	url = {https://www.scopus.com/pages/publications/105032047255?origin=resultslist},
	affiliations = {Department of Information Security, Omsk State Technical University, Omsk, Russian Federation},
	abstract = {This paper presents a novel hybrid cryptographic architecture for blockchain-based document signing that addresses fundamental interoperability challenges across heterogeneous blockchain platforms. The proposed system introduces technical innovations including a unified cryptographic protocol combining classical ECDSA signatures with post-quantum Dilithium algorithms, biometric authentication mechanisms, and zero-knowledge proof systems. The architecture enables seamless document signing across Ethereum, Hyperledger Fabric, and Solana networks through standardized smart contract interfaces and novel cross-chain verification protocols. Key technical contributions include mathematical formalization of hybrid signature schemes, implementation of privacy-preserving verification using NIZK proofs, and design of platform-agnostic verification mechanisms that maintain cryptographic security across different consensus architectures while achieving sub-second verification times. Β©2025 IEEE.},
	author_keywords = {blockchain; cross-platform verification; hybrid cryptography; post-quantum signatures; smart contracts; zeroknowledge proofs},
	keywords = {Architecture; Authentication; Authentication Protocol; Chains; Ciphertext; Computer architecture; Electronic document identification systems; Interoperability; Network architecture; Network security; Privacy-preserving techniques; Public key cryptography; Quantum cryptography; Smart contract; Block-chain; Cross-platform; Cross-platform verification; Cryptographic architecture; Hybrid cryptography; Post quantum; Post-quantum signature; Quantum signature; Zero knowledge; Zeroknowledge proof; Blockchain},
	correspondence_address = {V.A. Pasenchuk; Department of Information Security, Omsk State Technical University, Omsk, Russian Federation; email: pasenchuk.victor@gmail.com},
