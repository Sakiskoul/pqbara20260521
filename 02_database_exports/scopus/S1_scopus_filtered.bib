@ARTICLE{Sakwa2026,
	author = {Sakwa, Cyprian Omukhwaya and Li, Fagen},
	title = {Survey on post-quantum cryptography implementations and deployment challenges},
	year = {2026},
	journal = {Computer Science Review},
	volume = {61},
	pages = {},
	doi = {10.1016/j.cosrev.2026.100975},
	url = {https://www.scopus.com/pages/publications/105034518632?origin=resultslist},
	affiliations = {South Eastern Kenya University, Department of Mathematics & Actuarial Science, Kitui, Kenya; University of Electronic Science and Technology of China, School of Computer Science and Engineering, Chengdu, China},
	abstract = {Post-quantum cryptography (PQC) is moving rapidly from theoretical development to real-world deployment as quantum computing threatens classical public-key systems. This survey provides a comprehensive and implementation-oriented analysis of NIST-standardized PQC algorithms, including the key encapsulation mechanisms CRYSTALS-Kyber and the code-based HQC scheme, and the digital signature schemes CRYSTALS-Dilithium, FALCON, and SPHINCS+, with a focus on how these schemes perform under practical deployment conditions. This survey makes four primary contributions. First, we present a systematic evaluation of PQC performance across CPUs, GPUs, FPGAs, and microcontrollers, drawing on benchmark results reported for major cryptographic libraries such as OpenSSL, liboqs, and wolfSSL. Second, we identify the fundamental deployment trade-offs involving computational cost, communication overhead, memory footprint, and securityβ€”particularly in relation to side-channel resilience and correctness guarantees. Third, we discuss deployment pathways for scalable PQC adoption across major protocols such as TLS, VPNs, secure messaging, and blockchain infrastructures, with particular emphasis on hybrid migration strategies. Fourth, we highlight the major open challenges in PQC deployment, such as constrained-device integration, hardwareβ€“software co-design, and cross-protocol interoperability. By combining mathematical foundations with empirical implementation insights, this survey delivers a consolidated reference for researchers, standards bodies, and practitioners seeking to deploy quantum-safe cryptography at scale. Β© 2026 Elsevier Inc.},
