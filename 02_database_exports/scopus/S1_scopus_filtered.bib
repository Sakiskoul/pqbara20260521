	title = {Air-FRI: Acceleration ofΒ theΒ FRI Protocol onΒ theΒ GPU forΒ ZkSNARK Applications},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16207 LNCS},
