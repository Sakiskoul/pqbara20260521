@ARTICLE{Li2025,
	author = {Li, Ruifeng and Zhou, Tanping and Han, Yiliang and Che, Xiaoliang and Yang, Xiaoyuan},
	title = {A bimodal lattice-based linearly homomorphic signature for chain-based implicit data storage scheme},
	year = {2025},
	journal = {Discover Computing},
	volume = {28},
	number = {1},
	pages = {},
	doi = {10.1007/s10791-025-09728-6},
	url = {https://www.scopus.com/pages/publications/105017544807?origin=resultslist},
	affiliations = {School of Cryptography and Engineering, Engineering University of Peopleβ€™s Armed Police, Xiβ€™an, 710086, China; Key Lab of the Armed Police Force for Network and Information Security, Xiβ€™an, 710086, China},
	abstract = {As the demand for cross-domain collaborative verification grows in fields such as healthcare and industrial Internet of Things, achieving secure and efficient verification of heterogeneous data has become a critical challenge. Traditional linear homomorphic signature schemes face a dilemma: if multi-modal data is merged into a single signature, although the integrity is preserved, it leads to inefficiencies as the entire dataset must be reconstructed and re-signed upon local updates, making it susceptible to padding rule attacks; if signed independently, the cross-domain logical associations are disrupted, allowing attackers to conduct combinatorial fraud by substituting signatures from individual domains. To address these challenges, this paper proposes an innovative solution. Firstly, based on the lattice intersection method and the Chinese Remainder Theorem, a Bimodal Linearly Homomorphic Signature Scheme (BLHS) is designed: by constructing a bimodal lattice structure using coprime moduli, two types of heterogeneous data are embedded into interlocked algebraic spaces, generating short signatures that satisfy cross-domain constraints. The security of this scheme is reduced to the computational hardness of the Short Integer Solution (SIS) problem, strictly proving its unforgeability, and achieving weak context hiding to ensure the privacy of original data during linear combination operations. Secondly, with the rapid development of distributed technologies such as the Internet of Things and blockchain, the long-term storage of massive amounts of interrelated data faces dual challenges of space efficiency and cross-domain verification. Traditional data storage methods exhibit linear growth in storage overhead with respect to data length. To address the space efficiency bottleneck in long-term data storage, based on the proposed BLHS scheme, a Chain-based Implicit Data Storage Scheme (CIDSS) is introduced. The core idea of this scheme is to compress a data sequence into a single end signature for storage through chain-based recursive binding and implicit encoding, thereby achieving constant-level space complexity. The term "chain-based" refers to the use of NTRU equations over polynomial rings to recursively bind the current signature to the generation process of subsequent data blocks, forming an unforgeable dependency chain. The term "implicit" refers to storing only the end signature and recovering the complete historical data layer by layer through reverse solving of the NTRU equation. Theoretical analysis indicates that the scheme trades computational burden for storage efficiency, reducing the traditional explicit storage's O(k) space overhead to a constant level, making it suitable for long-term data archiving and verification scenarios in resource-constrained environments. Β© The Author(s) 2025.},
	author_keywords = {Lattice-based cryptography; Linearly homomorphic signature; Post-quantum cryptography; Short integer solution problem},
	correspondence_address = {Y. Han; School of Cryptography and Engineering, Engineering University of Peopleβ€™s Armed Police, Xiβ€™an, 710086, China; email: hanyil@163.com; X. Yang; School of Cryptography and Engineering, Engineering University of Peopleβ€™s Armed Police, Xiβ€™an, 710086, China; email: yxyangyxyang@163.com},
	publisher = {Springer Science and Business Media B.V.},
	issn = {29482992},
	language = {English},
	abbrev_source_title = {Discov. Comput},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@BOOK{Sharma2026191,
	author = {Sharma, Nidhi and Tiwari, Poonam and Kumari, Anita and Chudhary, Swati and Mittal, Monika and Saini, Anjali and Rathaur, Preeti and Kumar, Satender and Sharma, Gagan Kumar},
	title = {Securing the Logistics Landscape: Quantum Computing Solutions for Data Integrity and Security},
	year = {2026},
	journal = {Qubits Unveiled: Quantum Computing Solutions for Efficient Supply Logistics},
	pages = {191 - 210},
	url = {https://www.scopus.com/pages/publications/105030420212?origin=resultslist},
	affiliations = {Department of Physics, Dhanauri P. G. College, Dhanauri, Uttarakhand, Haridwar, India; Departmentof Physical Sciences, Banasthali Vidyapith, Rajasthan, India; Department of Physics, S. V. College, Raja Mahendra Pratap Singh State University, Aligarh, India; Departmentof Physics, Constituent Government Degree College, Richha Baheri, Bareilly, India; Departmentof Chemistry, Dhanauri P. G. College, Dhanauri, Uttarakhand, Haridwar, India; Departmentof Botany, Dhanauri P.G. College, Dhanauri, Uttarakhand, Haridwar, India; Departmentof Physics, Hari International Academy, Gagalhri, Saharanpur, India; Department of Materials Science and Nanoengineering, Rice University, Houston, TX, United States},
	abstract = {Data and security integrity, increasingly severe challenges for the logistics industry, are affected by the further development of digital transformation as well as escalating complexity in global supply chains. Emerging cyber threats, particularly with the advent of quantum computing, render current encryption techniques insecure, necessitating the development of new methods to protect logistics networks. This chapter explores how quantum computing can enhance data integrity and security in logistics. Key quantum concepts, such as superposition, entanglement, and quantum parallelism, are explored and discussed in this study regarding their applications in logistics to enhance encryption, validate data, and facilitate secure communication. The idea of using post-quantum algorithms, such as hash-based and lattice-based techniques, to protect logistics data against quantum attacks is examined through the analysis of quantum-resistant cryptography. Quantum Key Distribution (QKD) was introduced as a technique for generating unbreakable quantum keys for confidential data exchange among supply chain actors. Another research trend was investigated through the use of quantum blockchain for transparent and tamper-proof supply chain delivery. Quantum technologies could be applied in practice and solve integration challenges in logistics; some case studies may also provide future directions. Therefore, although quantum computing promises significant advancements, issues such as cost, integration, and expertise need to be addressed for the prospective adoption of quantum computing to become widespread. The combination of innovative security solutions with quantum computing would enable logistics to future-proof their operations through robust data integrity, building a much more resilient global supply chain network. Β© 2026 Nova Science Publishers, Inc.},
