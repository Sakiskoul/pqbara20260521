	title = {Quantum-Enhanced Cooperative Robotics for Disaster Response and Recovery},
	year = {2025},
	journal = {Optical Sensors and Distributed Sensing: Innovations, Techniques, and Applications},
	pages = {259 - 272},
	doi = {10.1201/9781003546719-18},
	url = {https://www.scopus.com/pages/publications/105023750563?origin=resultslist},
	affiliations = {Computing & Engineering, University of West London- RAK Branch Campus, 07 243 20 99, United Arab Emirates; Computing & Engineering, University of West London- RAK Branch Campus, 07 243 20 99, United Arab Emirates},
	abstract = {Disaster response and recovery activities often suffer from challenges such as slow decision-making, mismanagement of resources, and inadequate coordination of robots in dynamic settings. In response to the aforementioned problems, this research presents a new paradigm called Quantum Cooperative Robotics Framework (QCRF) that integrates quantum computing in functional cooperative robotic systems for disaster conditions. QCRF combines quantum-assisted resource management, quantum swarm factor, quantum secure communication, quantum reinforcement learning, and blockchain and advanced decision awareness. Quantum optimization can help with real-time decisions of where to allocate resources so that robots can quickly be dispatched to high-risk areas. Swarm intelligence inspired by quantum computing helps to solve problems associated with robotic tasksβ€™ flexible distribution and path choices in challenging environments. QKD plays a crucial role in assuring communication between robots in dangerous surroundings, since it provides secure and authenticated keys. Also, quantum reinforcement learning enables robots to respond quickly to rather extensive and sudden changes in the environment, for instance, the collapse of a buildings or changing climate. The use of the blockchain also gives openness and traceability in the decision-making process, encouraging the necessity of providing explanations to the parties concerned. The paper also presents real-time solutions of the proposed framework in earthquake response, flood management, and wildfire control that prove the flexibility of the framework. Remote performance evaluations point out increased decision-making speeds, task productivity, and user data security as compared to traditional systems. Simultaneously, the metrics indicated in this study not only solve existing issues in disaster coordination, but also lay the groundwork for the further growth of quantum cooperative robotics, which can be used in smart city development, agriculture, and space exploration. Catering for the integration of two disruptive technologies, i.e., quantum computing and robotic intelligence, this framework poses a revolutionary solution for minimizing the adverse effects of natural disasters, as well as increasing the general resiliency of the world. Β© 2026 Jose Anand A., Shilpa Mehta, Ambarish G. Mohapatra, Anita Mohanty, Nitaigour Premchand Mahalik and Subrat Kumar Mohanty},
	keywords = {Agriculture; Decision making; Emergency services; Intelligent robots; Quantum communication; Quantum computers; Swarm intelligence; Block-chain; Cooperative robotic systems; Cooperative robotics; Decisions makings; Disaster recovery; Disaster-response; Dynamic settings; Functionals; Quantum Computing; Quantum reinforcement learning; Space research},
	correspondence_address = {H. Shaheen; Computing & Engineering, University of West London- RAK Branch Campus, 07 243 20 99, United Arab Emirates; email: h.shaheen@uwl.ac.ae},
	publisher = {CRC Press},
	isbn = {978-104059303-5; 978-104068203-6},
	language = {English},
	abbrev_source_title = {Optical Sensors and Distributed Sensing: Innovations, Techniques, and Applications},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Han20252524,
	author = {Han, Longbo and Hu, Gengran and Li, Xiaoting and Xia, Feifei and Wang, Shengbao and You, Lin},
	title = {A Novel Lattice-Based Blockchain Infrastructure and Its Application on Trusted Data Management},
	year = {2025},
	journal = {IEEE Transactions on Network Science and Engineering},
	volume = {12},
	number = {4},
	pages = {2524 - 2536},
	doi = {10.1109/TNSE.2025.3550158},
	url = {https://www.scopus.com/pages/publications/105000057028?origin=resultslist},
	affiliations = {Hangzhou Dianzi University, School of Cyberspace, Hangzhou, 310018, China; Zhejiang University, Department of Information Center, Hangzhou, 310018, China; Hangzhou Normal University, School of Information Science and Technology, Hangzhou, 310018, China},
	abstract = {As a part of blockchain's infrastructure, the construction of Merkle trees typically relies on secure hash functions, such as SHA256. However, traditional blockchain systems face dual threats: quantum vulnerabilities in hash functions (e.g., Grover's algorithm reduces collision resistance) and inefficiencies in large-scale data verification. To address these challenges, we propose a parameter-hopping Merkle tree framework integrating a pseudo-random number generator (PRNG) with lattice-based cryptography. Our design ensures adaptive security through dynamic basis vector generation. This lattice-based structure offers flexibility in accommodating messages of varying sizes, supports distributed data storage, and enables efficient verification and querying of large-scale information streams. Key contributions include: a). A provably secure hash chain constructed via a family of extended-message-domain lattice-based hash functions (LBHFs), supporting arbitrary-length inputs. b). A variable-parameter Merkle tree protocol enabling efficient distributed data storage and query verification, with proof sizes optimized for P2P networks. c) A trusted data management prototype validated in a cloud storage scenario. Experimental results indicate that our blockchain infrastructure achieves enhanced security while maintaining high efficiency. Β© 2013 IEEE.},
	author_keywords = {Blockchain scalability; lattice-based cryptography; merkle tree; post-quantum security; trusted data management},
	keywords = {Blockchain; Digital storage; Efficiency; Information management; Block-chain; Blockchain scalability; Distributed data storages; Infrastructure applications; ITS applications; Lattice-based; Lattice-based cryptography; Merkle trees; Post-quantum securities; Trusted data management; Random number generation},
	correspondence_address = {L. You; Hangzhou Dianzi University, School of Cyberspace, Hangzhou, 310018, China; email: mryoulin@gmail.com},
	publisher = {IEEE Computer Society},
	issn = {23274697},
	language = {English},
	abbrev_source_title = {IEEE Trans. Netw. Sci. Eng.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Alsubai20246117,
	author = {Alsubai, Shtwai and Alqahtani, Abdullah and Garg, Harish and Sha, Mohemmed and Gumaei, Abdu},
	title = {A blockchain-based hybrid encryption technique with anti-quantum signature for securing electronic health records},
	year = {2024},
	journal = {Complex and Intelligent Systems},
	volume = {10},
	number = {5},
	pages = {6117 - 6141},
	doi = {10.1007/s40747-024-01477-1},
	url = {https://www.scopus.com/pages/publications/85194711451?origin=resultslist},
	affiliations = {Department of Computer Science, College of Computer Engineering and Sciences, Prince Sattam Bin Abdulaziz University, Al-Kharj, 11942, Saudi Arabia; Department of Software Engineering, College of Computer Engineering and Sciences, Prince Sattam Bin Abdulaziz University, Al-Kharj, 11942, Saudi Arabia; Department of Mathematics, Thapar Institute of Engineering and Technology (Deemed University), Punjab, Patiala, 147004, India},
	abstract = {Electronic health records (EHRs) are important for the efficient management of healthcare data. However, Healthcare data travels across an open route, i.e., the Internet, making EHR security a difficult process to do. This puts healthcare data vulnerable to cyber assaults. A possible method for protecting EHRs is blockchain technology. In this work, we develop an EHR architecture based on blockchain, which ensures all stakeholder's safety and privacy. We analyze various security architectures used for EHRs and the standard encryption system is integrated with quantum computing (QC). To safeguard the conventional traditional encrypting system against quantum assaults, we provide a hybrid signature technique that combines the Elliptic Curve Digital Signature Algorithm (ECDSA) andΒ Dilithium within the anti-quantum lattice-based blind signature. Based on the difficulty of lattice problems over finite fields, Dilithium is a lattice-based signature method that is substantially safe against selected message assaults. The developed technique creates high entropy secret keys using the lattice basis delegation mechanism. The combination of ECDSA and Dilithium provides an efficient and secure signature system that is resilient to quantum attacks. The proposed scheme ensures that only authorized users with a defined role can use the database to access the data. We evaluate the efficiency of our scheme by comparing its performance to other state-of-the-art solutions in terms of transaction throughput, resource utilization, and communication cost. Results demonstrate that the developed technique outperforms the existing techniques in terms of efficiency and security. Β© The Author(s) 2024.},
	author_keywords = {Blockchain technology; Dilithium; ECDSA; Electronic health records; Quantum attacks; Quantum computing},
	correspondence_address = {S. Alsubai; Department of Computer Science, College of Computer Engineering and Sciences, Prince Sattam Bin Abdulaziz University, Al-Kharj, 11942, Saudi Arabia; email: sa.alsubai@psau.edu.sa; H. Garg; Department of Mathematics, Thapar Institute of Engineering and Technology (Deemed University), Patiala, Punjab, 147004, India; email: harishg58iitr@gmail.com},
	publisher = {Springer International Publishing},
	issn = {21994536},
	language = {English},
	abbrev_source_title = {Complex Intell. Syst.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 25; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Abdullayev2025123,
	author = {Abdullayev, Vugar and Khang, Alex and Ragimova, Nazila and Almaayah, Mohammed},
	title = {A Novel Authentication Systems in Vehicular Communication: Challenges and Future Directions},
	year = {2025},
	journal = {Journal of Cyber Security and Risk Auditing},
	volume = {2025},
	number = {3},
	pages = {123 - 135},
	doi = {10.63180/jcsra.thestap.2025.3.9},
	url = {https://www.scopus.com/pages/publications/105022927013?origin=resultslist},
	affiliations = {Department of Computer Engineering, Azerbaijan State Oil and Industry University, Baku, Azerbaijan; Department of Information Technology and Systems, Azerbaijan University of Architecture and Construction, Azerbaijan; Global Research Institute of Technology and Engineering, Raleigh, United States; INTI International University, Nilai, 71800, Malaysia},
	abstract = {The emergence of intelligent transportation systems and the widespread deployment of connected and autonomous vehicles (CAVs) have introduced unprecedented security demands in vehicular communication networks. Authentication, as a foundational security service, ensures trust among vehicles, infrastructure, and external entities. However, traditional methods such as Public Key Infrastructure (PKI) often fail to meet the stringent requirements of vehicular environments, including real-time responsiveness, scalability, and user privacy. This paper presents a comprehensive review of novel authentication systems designed for vehicular communication. We classify and analyze state-of-the-art approaches including lightweight cryptographic protocols, group-based schemes, blockchain-integrated authentication, AI-driven behavioral methods, pseudonym-based privacy-preserving mechanisms, and post-quantum crypto-graphic frameworks. Each system is evaluated in terms of latency, privacy, scalability, real-time capability, and maturity level. We further identify key challenges such as certificate revocation, interoperability, and ethical implications. Finally, the paper highlights emerging research directions including federated authentication, quantum-safe security, context-aware mechanisms, and hybrid blockchain-AI solutions. Our analysis serves as a roadmap for researchers and practitioners aiming to develop secure, efficient, and scalable authentication systems for next-generation vehicular networks. Β© 2025, Smart Technologies Academic Press. All rights reserved.},
	author_keywords = {AI-based authentication; authentication systems; blockchain; federated learning; intelligent transportation systems; post-quantum cryptography; privacy preservation; pseudonym schemes; real-time security; V2X security; Vehicular communication},
	correspondence_address = {V. Abdullayev; Department of Computer Engineering, Azerbaijan State Oil and Industry University, Baku, Azerbaijan; email: abdulvugar@mail.ru},
	publisher = {Smart Technologies Academic Press},
	issn = {30795354},
	language = {English},
	abbrev_source_title = {J. cyber secur. risk audit.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14; All Open Access; Gold Open Access}
}

