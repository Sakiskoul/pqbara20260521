	year = {2026},
	journal = {International Conference on Artificial Intelligence, Computer, Data Sciences, and Applications, ACDSA 2026},
	pages = {},
	doi = {10.1109/ACDSA67686.2026.11468117},
	url = {https://www.scopus.com/pages/publications/105037598629?origin=resultslist},
	affiliations = {Ict Polytech Institute of Korea, Dept. of Information Security, Gyunggi, South Korea; Daejeon University, Dept. Military Science, Daejeon, South Korea},
	abstract = {The pervasive deployment of Internet of Things (IoT) devices across diverse critical domains, from smart cities to industrial control systems and healthcare, necessitates robust and efficient authentication mechanisms. Traditional cryptographic protocols often struggle with the resource constraints of IoT devices, while remaining vulnerable to emerging threats such as quantum attacks and sophisticated physical cloning. This paper proposes a novel PUF (Physical Unclonable Function)-based authentication protocol that integrates dynamic response mechanisms and leverages lightweight blockchain for enhanced security and efficiency in resource-constrained IoT environments. We address the limitations of static PUF behaviors, susceptibility to machine learning attacks, and the scalability challenges of centralized authentication systems. Through a comprehensive analysis, including informal and formal security verifications using tools like AVISPA and the Real-or-Random (ROR) model, we demonstrate the protocol's resilience against various attacks, including impersonation, replay, Man-in-the-Middle (MITM), and physical cloning. Furthermore, comparative performance evaluations against state-of-the-art protocols illustrate significant reductions in computational and communication overhead, making our proposed solution highly suitable for latency-sensitive and resource-limited IoT applications. Β© 2026 IEEE.},
	author_keywords = {Authentication Protocol; Dynamic Response Mechanism; IoT Secu-rity; Lightweight Blockchain; Machine Learning Attacks; Physical Unclonable Function (PUF); ResourceConstrained Devices},
