	year = {2022},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
	volume = {13140 LNCS},
	pages = {310 - 318},
	doi = {10.1007/978-3-030-93944-1_21},
	url = {https://www.scopus.com/pages/publications/85124675308?origin=resultslist},
	affiliations = {University of South Florida, Tampa, FL, United States; Information Security Group, Royal Holloway, University of London, Egham, United Kingdom; Purdue University, West Lafayette, IN, United States},
	abstract = {Proof of Work (PoW) protocols, originally proposed to circumvent DoS and email spam attacks, are now at the heart of the majority of recent cryptocurrencies. Current popular PoW protocols are based on hash puzzles. These puzzles are solved via a brute force search for a hash output with particular properties, such as a certain number of leading zeros. By considering the hash as a random function, and fixing a priori a sufficiently large search space, Groverβ€™s search algorithm gives an asymptotic quadratic advantage to quantum machines over classical machines. In this paper, as a step towards a fuller understanding of post quantum blockchains, we propose a PoW protocol for which quantum machines have a smaller asymptotic advantage. Specifically, for a lattice of rank n sampled from a particular class, our protocol provides as the PoW an instance of the Hermite Shortest Vector Problem (Hermite-SVP) in the Euclidean norm, with a small approximation factor. Asymptotically, the best known classical and quantum algorithms that directly solve SVP type problems are heuristic lattice sieves, which run in time 2<sup>0.292</sup> <sup>n</sup> <sup>+</sup> <sup>o</sup> <sup>(</sup> <sup>n</sup> <sup>)</sup> and 2<sup>0.265</sup> <sup>n</sup> <sup>+</sup> <sup>o</sup> <sup>(</sup> <sup>n</sup> <sup>)</sup> respectively. We discuss recent advances in SVP type problem solvers and give examples of where the impetus provided by a lattice based PoW would help explore often complex optimization spaces. Β© 2022, Springer Nature Switzerland AG.},
	author_keywords = {Blockchains; Consensus protocols; Lattice-based cryptography; Post-quantum cryptography; Proof-of-work},
	keywords = {Heuristic algorithms; Quantum cryptography; Quantum theory; Asymptotics; Block-chain; Consensus protocols; E-mail (spam); Lattice-based; Lattice-based cryptography; Post quantum; Post quantum cryptography; Proof of work; Quantum machines; Blockchain},
	correspondence_address = {R. Behnia; University of South Florida, Tampa, United States; email: behnia@usf.edu},
	editor = {Garcia-Alfaro J. and MuΓ±oz-Tapia J.L. and Navarro-Arribas G. and Soriano M.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303093943-4},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11}
}

@CONFERENCE{Chen2021,
	author = {Chen, Jiahui and Gan, Wensheng and Hu, Muchuang and Chen, Chien-Ming},
	title = {On the Construction of a Post-Quantum Blockchain},
	year = {2021},
	journal = {2021 IEEE Conference on Dependable and Secure Computing, DSC 2021},
	pages = {},
	doi = {10.1109/DSC49826.2021.9346253},
