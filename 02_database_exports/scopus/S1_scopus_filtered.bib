	journal = {Leibniz International Proceedings in Informatics, LIPIcs},
	volume = {124},
	pages = {},
	doi = {10.4230/LIPIcs.ITCS.2019.51},
	url = {https://www.scopus.com/pages/publications/85069434983?origin=resultslist},
	affiliations = {Centre for Quantum Software and Information, School of Software, Faculty of Engineering and Information Technology, University of Technology, Sydney, Australia; Centre for Quantum Technologies, National University of Singapore, Singapore; IRIF, Univ. Paris Diderot, CNRS, Paris, 75205, France; Centre for Quantum Technologies and MajuLab, National University of Singapore, 117543, Singapore},
	abstract = {We initiate the study of quantum races, games where two or more quantum computers compete to solve a computational problem. While the problem of dueling algorithms has been studied for classical deterministic algorithms [12], the quantum case presents additional sources of uncertainty for the players. The foremost among these is that players do not know if they have solved the problem until they measure their quantum state. This question of β€when to measure?β€ presents a very interesting strategic problem. We develop a game-theoretic model of a multiplayer quantum race, and find an approximate Nash equilibrium where all players play the same strategy. In the two-party case, we further show that this strategy is nearly optimal in terms of payoff among all symmetric Nash equilibria. A key role in our analysis of quantum races is played by a more tractable version of the game where there is no payout on a tie; for such races we completely characterize the Nash equilibria in the two-party case. One application of our results is to the stability of the Bitcoin protocol when mining is done by quantum computers. Bitcoin mining is a race to solve a computational search problem, with the winner gaining the right to create a new block. Our results inform the strategies that eventual quantum miners should use, and also indicate that the collision probability β€“ the probability that two miners find a new block at the same time β€“ would not be too high in the case of quantum miners. Such collisions are undesirable as they lead to forking of the Bitcoin blockchain. Β© Troy Lee, Maharshi Ray, and Miklos Santha.},
	author_keywords = {Bitcoin mining; Convex optimization; Game theory; Quantum computing},
	keywords = {Bitcoin; Computation theory; Convex optimization; Game theory; Miners; Quantum optics; Qubits; Collision probability; Computational problem; Deterministic algorithms; Game-theoretic model; Nash equilibria; Quantum Computing; Search problem; Sources of uncertainty; Computer games},
