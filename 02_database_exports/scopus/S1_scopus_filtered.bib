	author = {Gharavi, Hadi and Granjal, Jorge and Monteiro, Edmundo},
	title = {PQBFL: A Post-Quantum Blockchain-based protocol for Federated Learning},
	year = {2025},
	journal = {Computer Networks},
	volume = {269},
