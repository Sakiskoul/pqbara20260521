}

@CONFERENCE{DamaΕ΅eviΔius2024356,
	author = {DamaΕ΅eviΔius, Robertas and Maskeliunas, Rytis},
	title = {Leveraging entangled quantum states to develop consensus mechanisms in blockchain networks for smart forestry applications},
	year = {2024},
	journal = {6th International Conference on Computing and Informatics, ICCI 2024},
	pages = {356 - 360},
	doi = {10.1109/ICCI61671.2024.10485031},
