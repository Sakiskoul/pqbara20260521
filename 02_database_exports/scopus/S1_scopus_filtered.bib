	title = {The Impact of Quantum Computing on Blockchain Security and Quantum Resistant Protocols},
	year = {2025},
	journal = {2nd International Conference on Intelligent Systems for Cybersecurity, ISCS 2025},
	pages = {},
	doi = {10.1109/ISCS69371.2025.11386359},
	url = {https://www.scopus.com/pages/publications/105034878293?origin=resultslist},
	affiliations = {Chalapathi Institute of Technology, Dept. of CSE-Data Science, A.P, Guntur, 522016, India; Koneru Lakshmaiah Education Foundation, Dept. of CSE, AP, Vaddeswaram, India; Chalapathi Institute of Technology, Dept. of CSE, A.P, Guntur, 522016, India; KKR & KSR Institute of Technology and Sciences, Dept. of Information Technology, Andhra Pradesh, Guntur, India; RV Institute of Technology, Chebrolu, Dept. of MCA, A.P, Guntur Dist, 522212, India},
	abstract = {The concept of blockchain technology has transformed the digital ecosystem to allow decentralized, transparent and immutable transactions in various sectors. Its security is closely dependent on classical cryptography like ECDSA and RSA to perform digital signatures and SHA-256 to achieve consensus, which are becoming more susceptible to quantum computing. The cryptographic principles underpinning blockchain could be compromised with the emergence of the quantum algorithms of Shor and Grover, endangering the integrity of transactions, authentication and consensus protocols. This paper discusses the implications that quantum computing could have on blockchain security, analyses vulnerabilities of current cryptographic primitives and assesses post-quantum cryptographic (PQC) protocols, including lattice-based protocols, hash-based protocols, and code-based protocols. To guarantee backwards compatibility, as well as a gradual upgrade process to quantum-resistant protocols, a hybrid migration approach that involves transactions with two signatures is suggested. Experimental analysis shows that PQC integration attains reasonable performance trade-offs, that preserve verification costs, block size growth, and throughput effects within feasible limits, and that zero-loss resilience is achieved during reorganization tests. The conclusion is that blockchains with PQC support can reach post-quantum levels of security without major operation interruption, and they provide a viable roadmap to moving towards distributed ledger systems that are future-ready. Β© 2025 IEEE.},
	author_keywords = {Blockchain security; Grover's algorithm; post-quantum cryptography (PQC); Quantum computing; Shor's algorithm},
	keywords = {Authentication; Blockchain; Distributed computer systems; Electronic document identification systems; Network security; Quantum computers; Quantum cryptography; Block-chain; Blockchain security; Decentralised; Digital ecosystem; Grover's Algorithm; Post quantum; Post quantum cryptography; Post-quantum cryptography; Quantum Computing; Shor's algorithms; Economic and social effects},
	correspondence_address = {S.S. Vellela; Chalapathi Institute of Technology, Dept. of CSE-Data Science, Guntur, A.P, 522016, India; email: sais1916@gmail.com},
