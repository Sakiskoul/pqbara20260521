@CONFERENCE{Dhanalakshmi2025,
	author = {Dhanalakshmi, R. and Siyag, Kunal and Sahaya Beni Prathiba, B.},
	title = {A Hardware-Realistic Quantum Web Protocol with Blockchain-Mediated Trust and Verifiable Security Metrics},
	year = {2025},
	journal = {Proceedings of 2025 International Conference on Signal Processing, Computation, Electronics, Power and Telecommunication, IConSCEPT 2025},
	pages = {},
	doi = {10.1109/IConSCEPT66142.2025.11437070},
	url = {https://www.scopus.com/pages/publications/105036486255?origin=resultslist},
	affiliations = {Vellore Institute of Technology (VIT), Centre for Cyber Physical Systems School of Computer Science and Engineering, Chennai, India; Vellore Institute of Technology (VIT), School of Computer Science and Engineering, Chennai, India},
	abstract = {The development of a Quantum Internet that can scale needs to establish secure inter-domain communication methods which operate without needing any prior established trust. The majority of current proposals depend on either perfect quantum channels or a centralized system which quantum attackers can exploit. The paper presents a Quantum Web Protocol (QWP) stack which includes a hardware-based foundation for its development and a blockchain system which enables trustless decentralized access control. We developed four new standardized indices which connect quantum physics to network governance and successfully validated them through testing. Our system uses post-quantum CRYSTALS-Dilithium signatures from on-chain verification to establish trustless coordination which prevents unauthorized node access. The researchers evaluated system performance through a large-scale simulation which tested 100,000 trials under standard hardware noise parameters of T<sub>1</sub> = 100 ΞΌs, 10<sup>-3</sup> gate error. The system achieved a Route Success Rate of 72.0%, with an average end-to-end fidelity of 0.6137. The anomaly detector's built-in machine learning features demonstrated strong performance capabilities, achieving F<sub>1</sub>-Score = 0.7350 (Οƒ = 0.0932) and AUC-ROC = 0.9795 (Οƒ = 0.0096). The blockchain control plane processed over 1.5 million simulated transactions, which produced a cryptographic audit trail that could be digitally verified. The framework underwent comprehensive evaluation together with its measurement system, which will establish essential standards for developing future Quantum Internet systems. Β© 2025 IEEE.},
	author_keywords = {Anomaly Detection; Blockchain; Network Security; Post-Quantum Cryptography; Quantum Internet; Trust Metrics},
	keywords = {Anomaly detection; Computer hardware; Decentralized control; Hardware security; Internet protocols; Network security; Quantum channel; Quantum communication; Quantum cryptography; Quantum theory; Anomaly detection; Block-chain; Communication method; Interdomain communication; Networks security; Post quantum cryptography; Quantum internet; Security metrics; Trust metrics; Web protocols; Blockchain},
	correspondence_address = {R. Dhanalakshmi; Vellore Institute of Technology (VIT), Centre for Cyber Physical Systems School of Computer Science and Engineering, Chennai, India; email: dhanalakshmi.r@vit.ac.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157120-7},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Signal Process., Comput., Electron., Power Telecommun., IConSCEPT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Pongallu2025,
	author = {Pongallu, Darshika Ravindra and Arun, Shreyas Setlur and Verma, Rohit},
	title = {SecureMedZK - A Blockchain-based Approach with Zero-Knowledge Rollups for Secure EHR},
	year = {2025},
	journal = {2025 IEEE 4th International Conference on AI in Cybersecurity, ICAIC 2025},
	pages = {},
	doi = {10.1109/ICAIC63015.2025.10848761},
	url = {https://www.scopus.com/pages/publications/85218019307?origin=resultslist},
	affiliations = {National College of Ireland, School of Computer Science, Dublin, Ireland},
	abstract = {This paper aims to develop SecureMedZK, a blockchain-based framework designed to secure Electronic Health Records (EHRs) using quantum-resistant encryption, privacy-preserving techniques, and HIPAA-compliant data management. The study integrates NTRU lattice-based cryptography, Zero-Knowledge Rollups, and Practical Byzantine Fault Tolerance (PBFT) to address scalability, security, and consensus issues. Performance evaluations were conducted through simulated environments, comparing SecureMedZK with traditional EHR systems on metrics such as scalability, latency, and security. The findings show that SecureMedZK significantly improves scalability by reducing on-chain transaction loads with Zero-Knowledge Rollups, resulting in a 30% improvement in transaction speed. PBFT ensures minimal delays even with increasing transaction volumes, while NTRU lattice-based cryptography offers quantum-resistant encryption, safeguarding EHRs against quantum threats. The system meets HIPAA standards with encrypted data storage, robust access controls, and immutable audit trails, proving its ability to provide secure and compliant healthcare data management. SecureMedZK has the potential for expanding secure healthcare data management, including genomic and imaging data, with future improvements in cryptographic techniques and consensus mechanisms. Β© 2025 IEEE.},
	author_keywords = {Blockchain; Electronic health records; NTRU; Quantum Cryptography; Zero Knowledge Rollups},
	keywords = {Blockchain; Information management; Quantum electronics; Records management; Scalability; Block-chain; Byzantine fault tolerance; Electronic health; Health records; Lattice-based cryptography; NTRU; Performances evaluation; Privacy preserving; Zero knowledge; Zero knowledge rollup; Electronic health record},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151888-2},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. AI Cybersecur., ICAIC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@BOOK{Shaheen2025259,
