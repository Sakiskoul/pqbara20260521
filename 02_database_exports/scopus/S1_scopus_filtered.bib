	keywords = {Blockchain; Cryptography; Intelligent agents; Network security; Block-chain; Blockchain auditing; Data processing units; Explainable AI; Multiagent systems (MASs); Post quantum cryptography; Shadow AI; Trust; WI - FI; Wi-fi 7; Multi agent systems},
