	affiliations = {Chandigarh University, Mohali, India; Chandigarh University, Mohali, India},
	abstract = {The advent of quantum computing poses a threat to the bases of classical cryptographies and thus the RSA and ECC are susceptible to attacks at the time of a poly with Shors algorithm. The present paper proposes QUBE-Crypto (Quantum Unbreakable Blockchain-Enhanced Cryptography) which is a new multi-layered protocol that facilitates a synergistic combination of Quantum Key Distribution (QKD) that can provide information-theoretic key protection, Post-Quantum Digital Signatures (Dilithium-5, SQIsignHD) that offer computational authentication resilience, blockchain-based immutable identity anchoring and Pseudorandom Quantum State (PRS) challenges that can provide unforgeable verification. Unlike existing approaches that address quantum threats in isolation, QUBE-Crypto provides end-to-end quantum-safe communication by combining provably secure key exchange, quantum-resistant signatures, decentralized trust, and clone-proof authentication. The protocol is formally specified through a five-phase algorithm encompassing initialization, QKD-based session key establishment, PRS-based challengeresponse authentication, blockchain-anchored verification, and encrypted message exchange. Applications span IoT security, smart cities, digital voting, and decentralized identity systems requiring resilience against both classical and quantum adversaries. Β© 2025 IEEE.},
	author_keywords = {Blockchain-Based Authentication; Cryptographic Protocol Design; Post-Quantum Cryptography; Quantum Cryptography; Quantum Key Distribution; Quantum-Safe Communication},
