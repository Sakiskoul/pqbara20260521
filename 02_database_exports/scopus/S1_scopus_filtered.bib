@CONFERENCE{Jiang2022134,
	author = {Jiang, Zoe L. and Pan, Yijian and Fan, Maoshun and Yao, Lin and Liu, Yang and Wu, Yulin and Yiu, Siu-Ming and Wang, Xuan and Fang, Junbin},
	title = {Local Energy Trading Platform Based on Privacy-Preserving Blockchain with Linkable Ring Signature},
	year = {2022},
	journal = {Proceedings - 2022 4th International Conference on Data Intelligence and Security, ICDIS 2022},
	pages = {134 - 141},
	doi = {10.1109/ICDIS55630.2022.00028},
	url = {https://www.scopus.com/pages/publications/85146490709?origin=resultslist},
	affiliations = {Shenzhen Guangdong Provincial Key Laboratory of Novel Security Intelligence Technologies, Harbin Institute of Technology, Shenzhen, China; Harbin Institute of Technology, Shenzhen, Shenzhen, China; Harbin Institute of Technology, Harbin, China; Harbin Institute of Technology, Shenzhen Peng Cheng Laboratory, Shenzhen, China; The University of Hong Kong, Hong Kong; Jinan University, Guangzhou, China},
	abstract = {The growing renewable energy source technologies and distributed communication infrastructure call for local energy trading (LET) platform in smart grid to assist prosumers and consumers to trade energy locally and efficiently. Blockchain is essentially a decentralized data storage and processing technology that can be used for transactions of any kind, which makes local energy transactions transparent, traceable and decentralized controlled. However, blockchain essentially presents a conflict between traceability and identity anonymity of transactions, which further brings a challenge for the conjunction of blockchain and the adaptation to various distributed fields, such as smart grid system. This paper proposes a blockchain-based regulated local energy trading platform. Identity anonymity is achieved by replacing traditional signature with ring signature. The traditional signature verification exposes signer's identity while ring signature verification in the latter includes all the identities of the ring, which hides real transaction identity. Further, when suspicious transaction happens, regulator is able to track down the malicious user by asking all the ring members to sign the suspicious transaction. Also, the proposed platform can resist quantum computing attack. We present the comprehensive concept, system design and simulation of the local energy trading platform based on a public blockchain, FISCO BCOS.  Β© 2022 IEEE.},
	author_keywords = {Blockchain; Identity anonymity; Linkable ring signature; Local energy trading; Privacy preserving; Smart grid},
