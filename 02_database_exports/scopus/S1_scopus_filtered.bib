@ARTICLE{Amer2025514,
	author = {Amer, Omar and Chakrabarti, Shouvanik and Chakraborty, Kaushik and Eloul, Shaltiel and Kumar, Niraj and Lim, Charles and Liu, Minzhao and Niroula, Pradeep and Satsangi, Yash and Shaydulin, Ruslan and Pistoia, Marco},
	title = {Applications of certified randomness},
	year = {2025},
	journal = {Nature Reviews Physics},
	volume = {7},
	number = {9},
	pages = {514 - 524},
	doi = {10.1038/s42254-025-00845-1},
	url = {https://www.scopus.com/pages/publications/105009900992?origin=resultslist},
	affiliations = {Global Technology Applied Research, JPMorganChase, New York, NY, United States},
	abstract = {The use of randomness is ubiquitous in our society, including jury pool selection, encryption of digital communications, and many other activities. However, in many applications, there is an incentive for malicious actors to influence or predict the randomness. Therefore, it is beneficial if the trustworthiness, unpredictability and security of the randomness can be certified by any participant that does not trust the randomness provider. Certified randomness can be generated with untrusted remote quantum computers using multiple known protocols, one of which has recently been realized experimentally. Unlike the randomness sources accessible on todayβ€™s classical computers, the output of these protocols can be certified to be random under certain computational hardness assumptions, with no trust required in the hardware generating the randomness. In this Perspective, we explore real-world applications for which the use of certified randomness protocols may lead to improved security and fairness. We identify promising applications in areas including cryptography, differential privacy, financial markets and blockchain. Β© Springer Nature Limited 2025.},
	keywords = {Cryptography; Differential privacy; Random processes; Block-chain; Computational hardness; Differential privacies; Digital communications; Protocol cans; Quanta computers; Real-world; Digital communication systems},
	correspondence_address = {R. Shaydulin; Global Technology Applied Research, JPMorganChase, New York, United States; email: ruslan.shaydulin@jpmorgan.com; M. Pistoia; Global Technology Applied Research, JPMorganChase, New York, United States; email: marco.pistoia@jpmorgan.com},
