@CONFERENCE{Raavi202497,
	author = {Raavi, Manohar and Wuthier, Simeon and Chang, Sang-Yoon},
	title = {Securing Post-Quantum DNSSEC Against Fragmentation Mis-Association Threat},
	year = {2024},
	journal = {IEEE International Conference on Communications},
	pages = {97 - 102},
	doi = {10.1109/ICC51166.2024.10622607},
	url = {https://www.scopus.com/pages/publications/85202832341?origin=resultslist},
	affiliations = {Kennesaw State University, Department of Computer Science, United States; University of Colorado, Department of Computer Science, Colorado Springs, CO, United States},
	abstract = {Domain Name System Security Extensions (DNSSEC) uses public-key digital signatures to provide integrity and authentication for DNS query responses. The current standardized DNS for reliable UDP delivery limits DNS response (including the message, signature, and public key) to a maximum of 1232 bytes. Incorporating NIST's post-quantum digital signatures into the DNS protocol results in a response size that exceeds the limit set by the Ethernet standardization, making PQC incompatible with the current standardized DNS. To address the incompatibility and enable PQC to protect the authenticity against the quantum-equipped adversaries, previous research proposed fragmenting the DNSSEC messages. Fragmentation however exposes DNSSEC to Fragmentation Mis-Association threat, traditionally studied in the broader IP fragmentation contexts and not applicable in the current DNSSEC with classical/pre-quantum cipher (no fragmentation needed). We distinguish our work from the previous research incorporating PQC to DNSSEC to defend against the Fragmentation Mis-Association Threat by chaining the fragments and applying cryptographic commit-and-reveal. We also advance the previous research and further reduce the number of packet fragments, which can be particularly useful as the DNSSEC based on UDP is prone to packet transmission failure increasing the chance of the DNS response failure when sent in multiple fragments, by using blockchain to offload and enable the offline delivery of the public key. Our scheme thus even allows the Falcon-512 PQC cipher incorporation to forgo the fragmentation, in contrast to the previous research requiring fragmentation for Falcon-512; the other PQC ciphers, i.e., Dilithium ciphers and Falcon-1024, still require fragmentation in our scheme due to the standardized signature sizes. We implement our scheme and analyze the effectiveness and performances through experimentation. Β© 2024 IEEE.},
	keywords = {Authentication Protocol; Blockchain; Enterprise resource planning; Network security; Quantum cryptography; Risk management; Static random access storage; 'current; CryptoGraphics; Domain name systems security extensions; Limit sets; Packet transmissions; Post quantum; Public keys; Quantum digital signatures; Quantum domain; Query response; Authentication},
	editor = {Valenti M. and Reed D. and Torres M.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15503607},
	isbn = {978-172819054-9},
	language = {English},
	abbrev_source_title = {IEEE Int Conf Commun},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

@ARTICLE{Yi202514205,
	author = {Yi, Haibo},
	title = {A Supervised Blockchain for Safety and Reliability in Transportation Cyber-Physical Systems},
	year = {2025},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	volume = {26},
	number = {9},
	pages = {14205 - 14214},
	doi = {10.1109/TITS.2025.3563442},
	url = {https://www.scopus.com/pages/publications/105004707500?origin=resultslist},
	affiliations = {Shenzhen Polytechnic University, School of Artificial Intelligence, Shenzhen, 518055, China},
	abstract = {The application of transportation cyber-physical systems is evident in intelligent traffic management, where the integration of physical infrastructure, and control technologies-facilitates real-time monitoring, optimized scheduling, safety alerts, and autonomous driving. However, transportation cyber-physical systems often employ a highly centralized architecture, which inherently exposes them to the risk of single point failures. Moreover, the advent of quantum computing presents a formidable challenge, as quantum computers can exploit the parallelism of quantum bits and quantum entanglement to swiftly decrypt conventional encryption algorithms, thereby jeopardizing system security. Blockchain technology, distinguished by its decentralized and immutable nature, offers a robust foundation of trust for transportation cyber-physical systems. It mitigates the risks associated with centralized systems and quantum computing threats. In this paper, we introduce a supervised blockchain system tailored for transportation cyber-physical systems. Our proposed system harnesses the power of group signature techniques to leverage blockchainβ€™s supervisory capabilities. To surpass the limitations of traditional signature schemes, particularly in the face of quantum computing, we present a novel post-quantum group signature scheme. Building on this post-quantum signature scheme, we unveil a controllable anonymous blockchain model equipped with a supervision mechanism. This model strikes a delicate balance between anonymity and control, making it an ideal solution for the unique challenges faced by transportation cyber-physical systems. The resulting blockchain system is not only secure and reliable but also adaptable and anonymous, ensuring its suitability for the intricate demands of transportation cyber-physical systems. Β© 2000-2011 IEEE.},
	author_keywords = {blockchain; reliability; safety; supervision; Transportation cyber-physical systems},
	keywords = {Air traffic control; Anonymity; Authentication; Freight transportation; Highway traffic control; Navigation; Parking; Quantum channel; Quantum cryptography; Quantum electronics; Quantum entanglement; Railroad traffic control; Railroad transportation; Street traffic control; Block-chain; Cybe-physical systems; Cyber-physical systems; Infrastructure technologies; Intelligent traffic management; Post quantum; Quantum Computing; Signature Scheme; Supervision; Transportation cybe-physical system; Qubits},
	correspondence_address = {H. Yi; Shenzhen Polytechnic University, School of Artificial Intelligence, Shenzhen, 518055, China; email: haiboyi@szpu.edu.cn},
