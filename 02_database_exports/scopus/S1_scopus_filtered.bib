@CONFERENCE{Singh2024,
	author = {Singh, Sakshi and Gupta, Avdhesh and Chaudhary, Anu},
	title = {Enhancing Quantum Resistance: Entanglement Swapping in Quantum key distribution and blockchain infrastructure},
	year = {2024},
	journal = {2024 Asian Conference on Intelligent Technologies, ACOIT 2024},
	pages = {},
	doi = {10.1109/ACOIT62457.2024.10939951},
