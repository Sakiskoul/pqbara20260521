	note = {Cited by: 0}
}

@CONFERENCE{Upadhyaya2025,
	author = {Upadhyaya, Dhruti and Neha, J.C. and Venugopal, K.},
	title = {Beyond Signature Validity: Behavioral Fingerprinting for Fake Device Detection in Post-Quantum IoT Networks},
	year = {2025},
	journal = {2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions, CSITSS 2025},
	pages = {},
	doi = {10.1109/CSITSS67709.2025.11294276},
	url = {https://www.scopus.com/pages/publications/105031398467?origin=resultslist},
	affiliations = {R. V. College of Engineering, Department of ECE, India; R. V. College of Engineering, Department of Mathematics, India},
	abstract = {Traditional cryptographic techniques, including emerging post-quantum algorithms, focus primarily on ensuring message integrity and authenticity in Internet of Things (IoT) deployments. However, these approaches overlook whether the device generating valid signatures is itself genuine or compromised. In scenarios where attackers can clone devices or capture private keys, valid signatures become insufficient indicators of trust. This paper introduces a comprehensive framework that combines post-quantum-style signature emulation with behav-ioral fingerprinting to detect fake or spoofed IoT devices. We simulate a network of ten devices where one adversarial node continually broadcasts repetitive, low-entropy sensor readings. By extracting behavioral metrics such as the proportion of repeated messages, the randomness of message content, and the variability in message timing, and applying an unsupervised anomaly detection model (Isolation Forest), we achieve perfect detection of the spoofed device and maintain a low rate of false positives. To strengthen auditability, we integrate a blockchain-inspired, hash-linked logging mechanism that records each verified interaction. Our results demonstrate that layering behavioral analysis onto cryptographic verification significantly enhances device-level trust in IoT networks.  Β© 2025 IEEE.},
	author_keywords = {Anomaly detection; Behavioral fingerprinting; Blockchain logging; Device authentication; Internet of Things; Post-quantum cryptography},
	keywords = {Anomaly detection; Authentication; Blockchain; Fake detection; Network security; Palmprint recognition; Quantum cryptography; Anomaly detection; Behavioral fingerprinting; Block-chain; Blockchain logging; Cryptographic techniques; Device authentications; Post quantum; Post quantum cryptography; Quantum algorithms; Signature validity; Internet of things},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158894-6},
	language = {English},
	abbrev_source_title = {Int. Conf. Comput. Syst. Inf. Technol. Sustain. Solut., CSITSS},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Amadi20251848,
	author = {Amadi, Chimeremma Sandra and Jun, Taesoo},
	title = {Quantum-Resilient Key and Identity Lifecycle Architecture for Lightweight IIoT Systems},
	year = {2025},
	journal = {International Conference on ICT Convergence},
	pages = {1848 - 1853},
	doi = {10.1109/ICTC66702.2025.11388284},
	url = {https://www.scopus.com/pages/publications/105035060438?origin=resultslist},
	affiliations = {Kumoh National Institute of Technology, Department of It Convergence Engineering, Gumi, South Korea},
	abstract = {Post-quantum cryptography (PQC) is fast becoming a necessity for the Industrial Internet of Things (IIoT), where security requirements must align with strict latency and resource constraints. Traditional security protocols relying on static identities, centralized revocation, and bulky ciphertexts are ill-suited for dynamic and distributed IIoT systems. This paper introduces a quantum-resilient identity and key management architecture optimized for constrained industrial environments. We propose a lightweight entropy-seeded identity model that leverages biometric, device, and environmental randomness to generate spoof-resistant identities. A compressed key encapsulation delivery protocol based on CRYSTALS Kyber512 is developed using delta encoding, fragmentation, and ZLIB compression to minimize ciphertext overhead. Although a hybrid blockchain integration is conceptually discussed to outline revocation and trust enforcement, our implementation on constrained IIoT devices demonstrates over 48% ciphertext size reduction, 30% latency improvement compared to baseline Kyber, and real-time trust scoring based on behavioral analysis, showing strong potential for scalable, bandwidth-aware, and future-proof security deployment in post-quantum IIoT ecosystems. Β© 2025 IEEE.},
	author_keywords = {Compressed Key Encapsulation; CRYSTALS-Kyber512; Entropy-Seeded Identity; Industrial Internet of Things (IIoT); Lightweight Security Framework; Post-Quantum Cryptography (PQC)},
	keywords = {Blockchain; Ciphertext; Computer architecture; Data encapsulation; Encapsulation; Entropy; Internet of things; Internet protocols; Life cycle; Network architecture; Network security; Ciphertexts; Compressed key encapsulation; CRYSTALS-kyber512; Entropy-seeded identity; Industrial internet of thing; Lightweight securities; Lightweight security framework; Post quantum cryptography; Post-quantum cryptography; Security frameworks; Quantum cryptography},
