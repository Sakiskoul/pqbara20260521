	title = {Quantum-based Secure Authentication Mechanism using Dilithium and Blockchain for Internet of Vehicle (IoV) Environment},
	year = {2025},
	journal = {1st IEEE International Conference on Data Science and Intelligent Network Computing, ICDSINC 2025},
	pages = {557 - 562},
	doi = {10.1109/ICDSINC66221.2025.11448192},
	url = {https://www.scopus.com/pages/publications/105037464073?origin=resultslist},
	affiliations = {Department of C.S.E., SRM University - AP, Amaravati, India; School of Computer Engineering, Manipal Institute of Technology Bengaluru, Manipal Academy of Higher Education, Manipal, India},
	abstract = {Vehicle-to-Vehicle (V2V) communication plays a major role in smart transportation systems for autonomous and connected vehicles, which requires confidentiality and data integrity. Data sharing occurs over an insecure channel using conventional cryptography, which is prone to quantum attacks. Therefore, V2V needs a secure authentication scheme. This model proposes a lightweight quantum-resistant V2V authentication scheme that integrates lattice signatures with a superdense coding quantum communication channel through the blockchain. The proposed model uses blockchain technology to securely store and share lattice signatures and keys. For secure communication, authentication is performed between vehicles and roadside units using the Dilithium lattice signature through a decentralized system for data integrity and confidentiality. The experimental analysis states that using the authentication scheme, the proposed model has low latency between V2V and RSU. The security analysis of the proposed model is performed through formal security verification using the Scyther tool and informal security analysis. The security analysis proves that the proposed protocol is resistant to well-known attacks. Β© 2025 IEEE.},
	author_keywords = {Blockchain Technology; Dilithium signature; superdense coding; V2V authentication},
	keywords = {Authentication; Codes (symbols); Data Sharing; Electronic document identification systems; Intelligent vehicle highway systems; Network protocols; Network security; Quantum communication; Quantum cryptography; Security systems; Vehicle to vehicle communications; Vehicles; Authentication scheme; Block-chain; Blockchain technology; Data integrity; Dilithium; Dilithium signature; Secure authentications; Security analysis; Superdense coding; V2V authentication; Blockchain},
	correspondence_address = {V. Manojkumar; School of Computer Engineering, Manipal Institute of Technology Bengaluru, Manipal Academy of Higher Education, Manipal, India; email: manojkumar.v@manipal.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156524-4},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Data Sc. Intell. Netw. Comput., ICDSINC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Pasenchuk2025,
