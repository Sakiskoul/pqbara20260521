	keywords = {Parallel processing systems; Quantum cryptography; Wireless sensor networks; Computational demands; Cryptography over elliptic curve; Curve cryptography; EC space reduction; Elliptic curve; Its efficiencies; Scalar multiplication; Sensors network; Space reductions; Wireless sensor; Side channel attack},
