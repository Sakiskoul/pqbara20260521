	author_keywords = {Dilithium; Drones; Hyperledger fabric blockchain; Internet of Drones (IoD); Kyber; Physical Unclonable Functions (PUF); Post Quantum Cryptography (PQC); Secure communication; Unmanned Aerial Vehicles (UAVs)},
