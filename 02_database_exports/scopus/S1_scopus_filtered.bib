@CONFERENCE{Srujana2025,
	author = {Srujana, K. and Joginpelly, Swarun Kumar and Ramachandra, A.C. and Kavyashree, G.M. and Shanmuga Sundaram, K.},
	title = {PQ-FIM-PCES: Enhancing Privacy Compliance in Global Cloud Systems using Post-Quantum Cryptography and Federated Identity Management},
	year = {2025},
	journal = {International Conference on Software, Systems and Information Technology, SSITCON 2025},
	pages = {},
	doi = {10.1109/SSITCON66133.2025.11342266},
