@CONFERENCE{Rasool2024653,
	author = {Rasool, Motashim and Khatri, Arun and Maaliw, Renato R. and Manjula, G. and Varma, M. S. Kishan and Agarwal, Sohit},
	title = {Blockchain-Aware secure lattice aggregate signature scheme},
	year = {2024},
	journal = {Artificial Intelligence, Blockchain, Computing and Security - Proceedings of the International Conference on Artificial Intelligence, Blockchain, Computing and Security, ICABCS 2023},
	volume = {1},
	pages = {653 - 661},
	doi = {10.1201/9781003393580-98},
	url = {https://www.scopus.com/pages/publications/85186737855?origin=resultslist},
	affiliations = {Computer Science and Engineering, SR Institute of Management and Technology, Uttar Pradesh, Lucknow, India; JK Business School, Gurgaon, India; College of Engineering, Southern Luzon State University, Quezon, Lucban, Philippines; RMK College of Engineering and Technology, Thiruvallur, India; Department of Management Studies, VFSTR Deemed to be University, India; Department of Computer Engineering and Information Technology, Suresh Gyan Vihar University, Jaipur, India},
	abstract = {In the Forward Secure Ordered Aggregation (FssAgg) signature system, the signer gradually and orderly aggregates the signatures under different keys in different periods into one signature in a hierarchical β€onion-likeβ€ manner. Among them, the innermost signature is the first signature. In addition, compared with ordinarily ordered aggregate signatures, forward secure requested aggregate signatures are the aggregation of different signatures of the same signer rather than the signatures of additional signers so that the signature verifier can use public key complete verification of all aggregation processes. The forward-safe ordered aggregate signature has the advantages of both forward-secure signature and aggregate signature. It has been widely used in many application scenarios, such as log systems and blockchains. Several existing forward-safe ordered aggregate signatures are based on traditional number theory problems, which will no longer be problematic in the post-quantum era. Therefore, finding a forward-safe requested aggregate signature in the quantum computing environment is imminent. Based on the small integer solution problem on the lattice, a forward-secure lattice-based rated aggregate signature scheme under the standard model is constructed. To achieve high efficiency, the system uses fixed-dimensional lattice-based delegation technology to realize critical updates and achieve forward security; then, the message to be signed and the difficulty problem on the lattice are respectively embedded into the signature using message addition technology and preimage sampling algorithm, making the signature unforgeable under the standard model. Β© 2024 The Author(s).},
	author_keywords = {aggregation processes; Blockchain; forward-safe ordered; secure Lattice; Signature Scheme},
	keywords = {Aggregates; Authentication; Computation theory; Network security; Number theory; Quantum computers; Aggregate signature; Aggregation process; Block-chain; Forward-safe ordered; Forward-secure; Lattice-based; Public keys; Secure lattice; Signature Scheme; The standard model; Blockchain},
	correspondence_address = {M. Rasool; Computer Science and Engineering, SR Institute of Management and Technology, Lucknow, Uttar Pradesh, India; email: mail2motashim@gmail.com; A. Khatri; JK Business School, Gurgaon, India; email: khatriarun@yahoo.com; R.R. Maaliw; College of Engineering, Southern Luzon State University, Lucban, Quezon, Philippines; email: rmaaliw@slsu.edu.ph; G. Manjula; RMK College of Engineering and Technology, Thiruvallur, India; email: manjulacse@rmkcet.ac.in; M.S.K. Varma; Department of Management Studies, VFSTR Deemed to be University, India; email: mskishanvarma@gmail.com; S. Agarwal; Department of Computer Engineering and Information Technology, Suresh Gyan Vihar University, Jaipur, India; email: sohit.agarwal@gmail.com},
