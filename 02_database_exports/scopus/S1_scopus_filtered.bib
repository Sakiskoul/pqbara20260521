@ARTICLE{Reddy2025189,
	author = {Reddy, Smitha S. and Sapna, R.},
	title = {IoT and Edge Computing Security: Essential Aspects of 6G Networks},
	year = {2025},
	journal = {Advanced Sciences and Technologies for Security Applications},
	volume = {Part F458},
	pages = {189 - 206},
	doi = {10.1007/978-3-031-85008-0_9},
