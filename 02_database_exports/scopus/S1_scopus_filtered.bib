@CONFERENCE{Kasu2025,
	author = {Kasu, Venugopala Reddy and Deepalakshmi, P.},
	title = {Equipment Security for Internet of Things: Defending IoT Devices in Exposure-Risk Edge Computing Settings using Artificial Intelligence and Cryptographic Protocols},
	year = {2025},
	journal = {2025 International Conference on Smart and Sustainable Technology, INCSST 2025},
	pages = {},
	doi = {10.1109/INCSST64791.2025.11210318},
	url = {https://www.scopus.com/pages/publications/105024936308?origin=resultslist},
	affiliations = {3809 Jan Camille Ct, Celina, 75009, TX, United States; Kalasalingam Academy of Research and Education, School of Computing, Virudhunagar (Dist), Tamil Nadu, Krishnankoil, 626126, India},
	abstract = {The Internet of Things (IoT) is expanding at an unprecedented rate, bringing new and serious security threats, especially in exposure-risk edge computing environments with devices working in spread and sometimes bad conditions. The resource-constrained nature of IoT devices and the growing complexity of cyber-attacks make it difficult for existing security mechanisms to offer effective protection. The proposed approach focuses on enhancing the security of equipment in IoT systems in edge computing environments through the integration of artificial intelligence (AI) and cryptographic protocols. AI-based anomaly detection, machine learning-based intrusion prevention, and adaptive authentication mechanisms are utilized to identify and mitigate security threats in realtime. The combination of cryptographic methods such as lightweight encryption, secure key management, and blockchain-based authentication guarantees data integrity, confidentiality, and secure communication between IoT devices. This research shows that by integrating AI with cryptographic protocols, it provides a multi-layered approach to ensure security against threats like unauthorized access, man-in-the-middle attacks, data tampering, and DDoS (distributed denial-of-service) attacks. With continuously analyzing network traffic, device behavior, and historic attack patterns, AI algorithms improves threat detection accuracy and allows for pro-active measures against upcoming security threats. Post-quantum cryptographic algorithms implementation adds another layer of future-proofing against upcoming cryptographic attacks. Furthermore, decentralized, secure authentication is addressed by employing federated learning and edge-based AI solutions to mitigate latencies and computational overheads. The experimental results show that the introduced hybrid model: AI-cryptography for DDoS detection methods, has a better performance in terms of detection accuracy, false positive rate, data security and energy consumption for IoT devices. This research has made a notable contribution to the field of IoT security by the development of a scalable, intelligent and cryptographically secure defense mechanism for protecting the IoT devices in exposure risk edge computing environments. Overall, the results emphasize the promise of AI and cryptographic integration toward a robust IoT ecosystem, leading to the implementation of secure and smart IoT infrastructures. Β© 2025 IEEE.},
	author_keywords = {Anomaly Detection; Cryptographic Protocols; Cyber Threats; Federated Learning; Intrusion Prevention; Lightweight Encryption; Post-Quantum Cryptography; Secure Authentication},
	keywords = {Authentication; Denial-of-service attack; Edge computing; Green computing; Internet protocols; Intrusion detection; Learning systems; Network intrusion; Network security; Quantum cryptography; Security systems; Anomaly detection; Computing environments; Cryptographic protocols; Cyber threats; Edge computing; Intrusion prevention; Lightweight encryption; Post quantum cryptography; Secure authentications; Security threats; Anomaly detection},
	correspondence_address = {V.R. Kasu; Celina, 3809 Jan Camille Ct, 75009, United States; email: venugopal.15583@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
