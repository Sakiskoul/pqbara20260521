@CONFERENCE{Esgin20221281,
	author = {Esgin, Muhammed F. and Steinfeld, Ron and Zhao, Raymond K.},
	title = {MatRiCT+: More Efficient Post-Quantum Private Blockchain Payments},
	year = {2022},
	journal = {Proceedings - IEEE Symposium on Security and Privacy},
	volume = {2022-May},
	pages = {1281 - 1298},
	doi = {10.1109/SP46214.2022.9833655},
	url = {https://www.scopus.com/pages/publications/85135886705?origin=resultslist},
	affiliations = {Monash University and CSIRO's Data61, Australia; Monash University, Australia},
	abstract = {We introduce MatRiCT+, a practical private blockchain payment protocol based on 'post-quantum' lattice assumptions. MatRiCT+ builds on MatRiCT due to Esgin et al. (ACM CCS'19) and, in general, follows the Ring Confidential Transactions (RingCT) approach used in Monero, the largest privacy-preserving cryptocurrency. In terms of the practical aspects, MatRiCT+ has 2-18Γ— shorter proofs (depending on the number of input accounts, M) and runs 3-11Γ— faster (for a typical transaction) in comparison to MatRiCT. A significant advantage of MatRiCT+ is that the proof length's dependence on M is very minimal (only O(logM)), while MatRiCT has a proof length linear in M. To support its efficiency, we devise several novel techniques in our design of MatRiCT+ to achieve compact lattice-based zeroknowledge proof systems, exploiting the algebraic properties of power-of-2 cyclotomic rings commonly used in practical latticebased cryptography. Along the way, we design a family of 'optimal' challenge spaces, using a technique we call partition-and-sample, with minimal \ell_{1}-norm and invertible challenge differences (with overwhelming probability), while supporting highly-splitting power-of-2 cyclotomic rings. We believe all these results to be widely applicable and of independent interest.  Β© 2022 IEEE.},
	author_keywords = {Blockchain; Lattice; Post-Quantum; Ring Signature; RingCT; Zero-Knowledge},
	keywords = {Privacy-preserving techniques; Quantum efficiency; Block-chain; Lattice; Payment protocol; Post quantum; Power; Privacy preserving; Proof-length; Ring confidential transaction; Ring signatures; Zero knowledge; Blockchain},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {10816011},
	isbn = {978-166541316-9},
	language = {English},
	abbrev_source_title = {Proc. IEEE Symp. Secur. Privacy},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 41}
}

@ARTICLE{Wu2023957,
