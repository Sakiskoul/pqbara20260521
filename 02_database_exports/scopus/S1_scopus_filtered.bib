@ARTICLE{Jiang2022,
	author = {Jiang, Yongbo and Zhou, Yuan and Feng, Tao},
	title = {A Blockchain-Based Secure Multi-Party Computation Scheme with Multi-Key Fully Homomorphic Proxy Re-Encryption},
	year = {2022},
	journal = {Information (Switzerland)},
	volume = {13},
	number = {10},
	pages = {},
