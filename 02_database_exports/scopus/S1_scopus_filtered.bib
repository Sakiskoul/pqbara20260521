@ARTICLE{Wang2024,
	author = {Wang, Xiayu and Chen, Yineng and Zhu, Xinghui and Li, Cheng and Fang, Kui},
	title = {A Redactable Blockchain Scheme Supporting Quantum-Resistance and Trapdoor Updates},
	year = {2024},
	journal = {Applied Sciences (Switzerland)},
	volume = {14},
	number = {2},
	pages = {},
	doi = {10.3390/app14020832},
