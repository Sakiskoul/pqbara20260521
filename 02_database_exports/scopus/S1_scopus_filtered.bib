	url = {https://www.scopus.com/pages/publications/105015503758?origin=resultslist},
	affiliations = {Manav Rachna University, Department of Computer Science & Technology, India},
	abstract = {In the age of digital transformation, the integrity and security of online voting systems have become a growing concern. Traditional cryptography methods are vulnerable to advances in quantum computing, demanding the need for more secure alternatives. This paper explores the application of quantum cryptography in enhancing the security of blockchain-based voting systems, a decentralized and transparent approach to conduct elections. We introduce a novel quantum-resistant voting protocol that integrates Quantum Key Distribution (QKD) with post-quantum cryptographic algorithms, ensuring secure voter authentication, vote casting, and tallying. The methodology combines quantum encryption with blockchain's immutability to create a tamper-proof voting ledger, preventing unauthorized access and vote manipulation. It gives an analysis of potential real-world implementations, positioning a hybrid quantum-blockchain framework as a promising solution for future secure electronic voting systems.  Β© 2025 IEEE.},
	author_keywords = {Blockchain-ledger; Decentralization; Post-Quantum Cryptography; Quantum Cryptography; Quantum Entanglement; Quantum Key Distribution (QKD)},
	keywords = {Authentication; Blockchain; Decentralized systems; Electronic voting; Network security; Online systems; Quantum computers; Voting machines; Block-chain; Blockchain-ledger; Decentralisation; Digital transformation; Key distribution; Post quantum cryptography; Quantum Computing; Quantum key; Quantum key distribution; Voting systems; Quantum cryptography; Quantum entanglement},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
