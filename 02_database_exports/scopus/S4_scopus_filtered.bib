@CONFERENCE{Wawage2025,
	author = {Wawage, Pawan and Ikhar, Sharyu and Manhas, Rashmi and Sudarson, Jenefar and Rahmatullayev, Bobir and Maratuly, Shanazarov Nursultan},
	title = {Quantum Key Distribution for Secure Financial Data Exchange},
	year = {2025},
	journal = {15th International Conference on Mathematics, Actuarial Science, Computer Science and Statistics, MACS 2025},
	pages = {},
	doi = {10.1109/MACS68476.2025.11453349},
	url = {https://www.scopus.com/pages/publications/105036715084?origin=resultslist},
	affiliations = {Vishwakarma Institute of Technology, Information Technology, Maharashtra, Pune, 411037, India; Researcher Connect Innovations and Impact Private Limited, India; School of Business Management, Noida International University, India; Saveetha University, Department of Biochemistry, Chennai, 600077, India; Termez University of Economics and Service, Department of Finance and Tourism, Termez, Uzbekistan; Karakalpak State University, Department of Construction, Nukus, Uzbekistan},
	abstract = {The modern banking, stock trading and digital payment systems are banks and financial data exchange. Nevertheless, the advent of quantum computing can be a major challenge to the conventional cryptographic systems, as it may allow attackers to crack the popular encryption systems like RSA and ECC. Quantum Key Distribution (QKD) is an innovative method that can be used to provide a high degree of confidentiality and integrity to an encryption key exchange by utilizing quantum mechanics. The context of this paper is the possibility of using QKD in the context of financial data exchange, such as interbank transfer, SWIFT transfer, blockchain security, and real-Time trading data. A comparative study is done on the QKD vs classical cryptographic, with real world case studies given on the implementation of the methods into practice in the financial sector. Other integration issues such as infrastructure costs, distance, regulatory issues, and compatibility with the existing network are also discussed. Lastly, the hybrid models that can be used as transitional models between QKD and post-quantum cryptography are discussed. The results indicate that even though QKD is an effective method to improve the safety of data, its implementation at a large scale would require the development of quantum repeater devices, uniformity, and affordability. Quantum Key Distribution is poised as a strategic requirement to the protection of the future of financial data exchange. Β© 2025 IEEE.},
	author_keywords = {Blockchain Security; Digital Banking; Financial Data Security; Interbank Settlement; Post-Quantum Cryptography; Quantum Communication; Quantum Cryptography},
	keywords = {Banking; Blockchain; Electronic money; Electronic trading; Financial markets; Network security; Quantum communication; Quantum computers; Quantum theory; Block-chain; Blockchain security; Digital banking; Financial data; Financial data security; Interbank settlement; Key distribution; Post quantum cryptography; Quantum key; Stock trading; Quantum cryptography},
