@CONFERENCE{Mounira2025,
	author = {Mounira, Redjimi and Majda, Maatallah and Abdelmadjid, Benmachiche and Oumaima, Boufaida Soundes and Derdour, Makhlouf},
	title = {A Comprehensive Survey on Blockchain, Federated Learning, and AI for Securing the Internet of Medical Things},
	year = {2025},
