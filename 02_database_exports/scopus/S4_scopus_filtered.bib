	keywords = {Network security; Quantum computers; Quantum cryptography; Quantum efficiency; CryptoGraphics; Deterministic wallet; Deterministics; Digital signature schemes; Isogeny-based signature; Post quantum; Post-quantum securities; Signature Scheme; Threshold signature; Threshold signature with rerandomizable key; Authentication},
