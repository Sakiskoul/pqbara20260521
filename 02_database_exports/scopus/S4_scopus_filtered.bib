@CONFERENCE{Talapatra2025283,
	author = {Talapatra, Debadrita and Mishra, Nimish and Mukhopadhyay, Debdeep},
	title = {Ring-LWR based Commitments and ZK-PoKs with Application to Verifiable Quantum-Safe Searchable Symmetric Encryption},
	year = {2025},
	journal = {Proceedings of the ACM Conference on Computer and Communications Security},
	pages = {283 - 297},
	doi = {10.1145/3708821.3736223},
	url = {https://www.scopus.com/pages/publications/105015977086?origin=resultslist},
	affiliations = {Indian Institute of Technology Kharagpur, Kharagpur, India},
	abstract = {Prior research on ensuring trust in delegated computation through lattice-based zero-knowledge proofs mostly rely on Learning-With-Errors (LWE) assumption. In this work, we propose a zero-knowledge proof of knowledge using the Ring Learning with Rounding (RLWR) assumption for an interesting and useful class of statements: linear relations on polynomials. We begin by proposing, to the best of our knowledge, the first efficient commitment scheme in literature based on the hardness of RLWR assumption. We establish two properties on RLWR that aid in the construction of our commitments: (1) closure under addition with double rounding, and (2) closure under multiplication with a short polynomial. Building upon our RLWR commitment scheme, we consequently design a RLWR based Ο‚<sub>2</sub> protocol for proving knowledge of a single committed message under linear relations with public polynomials. As an use-case of our proposed Ο‚<sub>2</sub> protocol, we showcase a construction of a quantum-safe Searchable Symmetric Encryption (SSE) scheme by plugging a prior LWR based SSE scheme from (EuroS&P 2023) with our Ο‚<sub>2</sub> protocol. Concretely, using our Ο‚<sub>2</sub> protocol for linear relations, we prove the correctness of an encrypted search result in a zero-knowledge manner. We implement our verifiable SSE framework and show that the overhead of an extra verification round is negligible (0.0023 seconds) and retains the asymptotic query execution time complexity of the original SSE scheme. Our work establishes results on zero-knowledge proof systems that can be of independent interest. By shifting the setting from RLWE to RLWR, we gain significant (1) efficiency improvements in terms of communication complexity by O(M) (since some prior works on RLWE require rejection sampling by a factor of M), as well as (2) very short proof size (8.4 KB) and tighter parameters (since RLWR does not explicitly manipulate error polynomials like RLWE).  Β© 2025 Copyright held by the owner/author(s).},
	author_keywords = {Proofs of Knowledge; RLWR; Searchable Symmetric Encryption},
	keywords = {Knowledge based systems; Light water reactors; Polynomials; Query processing; Theorem proving; Commitment scheme; Lattice-based; Learning with Errors; Linear relation; Proof of knowledge; Ring learning with rounding; Searchable symmetric encryption; Symmetric encryption; Symmetric encryption schemes; Zero-knowledge proofs; Cryptography},
	correspondence_address = {D. Talapatra; Indian Institute of Technology Kharagpur, Kharagpur, India; email: debadritat.fg2219@kgpian.iitkgp.ac.in},
