}

@ARTICLE{Jha2025,
	author = {Jha, Devtosh Kumar and Jindal, Tanvi and Mittal, Amit},
	title = {Post-quantum secured blockchain framework equipped by cuttlefish optimization for sustainable supply chain performance in Indian retail industry},
	year = {2025},
	journal = {International Journal of Information Technology (Singapore)},
	pages = {},
	doi = {10.1007/s41870-025-02887-1},
	url = {https://www.scopus.com/pages/publications/105026286728?origin=resultslist},
	affiliations = {Chitkara University, Punjab, Rajpura, India},
	abstract = {The fragmented network and intricate logistics of the Indian retail industry are mounting pressure to go green. Blockchain technology holds out the potential to enhance transparency, trust, and operational agilityβ€”major pillars of sustainable supply chain performance. Threats to scalability and long-term security come in the form of vulnerabilities to quantum attacks and inefficient consensus mechanisms. This paper puts forward a new blockchain-based paradigm for Indian retail sustainable supply chain performance by combining post-quantum cryptographic (PQC) method with a metaheuristic optimizer based on Cuttlefish algorithm. The framework employs a semi-layered structure to synchronize cryptographic security with sustainability indicators like traceability, supplier coordination, and dynamic flexibility. We break down the synergistic functions of trust, flexibility, and transparency (TFT) to motivate supply chain performance while illustrating how our framework outperforms existing solutions in routing, authentication, and data encryption against possible quantum attacks. The results of simulations and security analysis affirm the outperformance of the hybrid method in energy efficiency, throughput, trust, and adaptability. Β© Bharati Vidyapeeth's Institute of Computer Applications and Management 2025.},
	author_keywords = {Blockchain; Cuttlefish algorithm; Indian retail; Post-quantum cryptography (PQC); Quantum-secure blockchain; Supply chain resilience},
	correspondence_address = {D.K. Jha; Chitkara University, Rajpura, Punjab, India; email: devtoshjha@gmail.com},
