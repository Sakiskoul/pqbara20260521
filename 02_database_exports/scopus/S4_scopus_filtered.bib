	title = {Post-quantum zero-knowledge and signatures from symmetric-key primitives},
	year = {2017},
	journal = {Proceedings of the ACM Conference on Computer and Communications Security},
	pages = {1825 - 1842},
	doi = {10.1145/3133956.3133997},
