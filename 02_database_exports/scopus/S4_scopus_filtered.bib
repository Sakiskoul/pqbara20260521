	title = {Using Lotka-Volterra Equations and Lightweight Post-Quantum Algorithm to Develop Lightweight Blockchain Security},
	year = {2025},
	journal = {Fusion: Practice and Applications},
	volume = {19},
	number = {1},
	pages = {128 - 143},
