	keywords = {Blockchain; Chains; Computer privacy; Data Sharing; Differential privacy; Digital storage; Network security; Privacy by design; Privacy-preserving techniques; Quantum communication; Quantum computers; Quantum cryptography; Quantum theory; Query processing; Throughput; Block-chain; Consortium chain; Data Sharing; Genomic data; Genomic data privacy; Genomics; Mutation detection; Post quantum; Post quantum cryptography; Privacy preserving; Genes},
	correspondence_address = {P. Das; Department of CSE-CPS, Jain University, Bengaluru, Kanakapura Rd, Karnataka, 562112, India; email: pujadas.wbut@gmail.com},
