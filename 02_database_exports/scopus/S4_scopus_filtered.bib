	author = {To, Thanh Hai and Le, Vu Trung Duong and Nguyen, Van Tinh and Luu, Van-Tuan and Pham, Hoai Luan and Nakashima, Yasuhiko},
	title = {Zk-STARKs in Action: Real-Time and Post-Quantum Verification for Banking Transactions},
	year = {2025},
