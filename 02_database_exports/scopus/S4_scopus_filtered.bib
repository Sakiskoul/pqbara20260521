	url = {https://www.scopus.com/pages/publications/105035360206?origin=resultslist},
	affiliations = {Gla University, Department of Computer Engineering and Applications, Mathura, India; Marathwada University, Kohinoor College Khuldabad. Affiliated to Dr.Babasaheb Ambedkar, Maharashtra, Aurangabad, India; Mlr Institute of Technology, Department of Ece, Hyderabad, India; Panimalar Engineering College, Chennai, India; Siksha O Anusandhan Deemed to Be University, Faculty of Management Sciences, Bhubaneswar, India; K.Ramakrishnan College of Engineering, Department of Ece, Trichy, India},
	abstract = {The rapid advancement of quantum computing threatens the security of classical public-key cryptosystems widely used for secure communications in Internet of Things (IoT) and electric vehicle (EV) battery swapping networks. Existing methods, including traditional cryptography and some early post-quantum algorithms, often struggle with high latency, excessive energy consumption, and limited suitability for resource-constrained IoT devices, hindering their practical deployment. This paper proposes PostQ-SwapNet, a novel hybrid framework designed to secure IoT-based EV battery swapping stations against both classical and quantum cyber threats. The system integrates CRYSTALS-Kyber for quantum-resistant key exchange, Dilithium digital signatures for mutual authentication, AES-128 encryption for data confidentiality, and a BiLSTM-based anomaly detection module for real-time threat identification. Additionally, it leverages a private blockchain with smart contracts to ensure transaction immutability and traceability. The objective is to deliver a secure, efficient, and scalable solution compatible with current IoT hardware constraints. This framework reduces latency to 1 2 0 ~ m s, energy use to 1 5 ~ m J and memory use to 2 5 6 ~ K B and still maintains a strong level of security. Python and TensorFlow were used for coding the AI side of the project. The results affirm that PostQ-SwapNet effectively balances security and performance, making it a practical solution for future-proofing EV energy networks against quantum and conventional cyberattacks. Β© 2025 IEEE.},
