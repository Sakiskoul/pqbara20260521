	pages = {1152 - 1158},
	doi = {10.1109/IC3SE62002.2024.10593272},
	url = {https://www.scopus.com/pages/publications/85200668581?origin=resultslist},
	affiliations = {Institute Of Aeronautical Engineering, Department Of Computer Science And Engineering, Telangana, Hyderabad, India; New Horizon College Of Engineering, Department Of Applied Sciences, Bangalore, India; Lovely Professional University, Phagwara, India; Gl Bajaj Institute Of Technology & Management, U.P., Greater Noida, India; Mlr Institute Of Technology, Department Of Computer Science And Engineering, Telangana, Hyderabad, India; The Islamic University, Medical Laboratory Technology Department, College Of Medical Technology, Najaf, Iraq},
	abstract = {This piece describes a complicated blockchain-based system for keeping data safe that is not controlled by a single entity. The suggested design is made up of DKM, SCAC, ILE, QRC, and DAE. These stand for Decentralized Key Management and Immutable Ledger Encryption, Smart Contract Access Control, and Quantum-Resistant Cryptography. The goal of every program is to make data safer. The ILE algorithm uses the DKM algorithm's randomized key sharing to store data that can't be changed. As a part of a full security system, the SCAC Algorithm uses smart contracts to flexibly limit user access. To protect against possible quantum threats, QRC uses lattice-based encryption. Dynamic encryption based on agreement is made possible by the DAE algorithm. The study on ablation shows that these ways make the design safer. The suggested system works better than the most recent ones in terms of speed, storage efficiency, decentralization, resistance to quantum attacks, access control freedom, and the usefulness of an audit record. Finally, the suggested design is useful in many situations because it meets both current and future protection needs. As blockchain technology grows, our proactive method guard's data security and makes it more resistant to new cryptographic flaws. This makes decentralized safe data management possible. Β© 2024 IEEE.},
	author_keywords = {Adaptive Encryption; Blockchain; Data Security; Decentralized Key Management; Immutable Ledger Encryption; Quantum-Resistant Cryptography; Smart Contracts},
	keywords = {Access control; Blockchain; Cloud storage; Cryptography; Distributed ledger; Information management; Storage efficiency; Adaptive encryption; Block-chain; Decentralised; Decentralized key management; Encryption algorithms; Immutable ledg encryption; Key sharing; Key-management; Quantum-resistant cryptography; Users access; Smart contract},
