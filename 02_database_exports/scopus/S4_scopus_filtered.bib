@ARTICLE{Alias Gurulakshmi2026365,
	author = {Alias Gurulakshmi, G. Archana},
	title = {Cryptography with Elliptic Curves: Enhancing Security through Advanced Mathematical Techniques},
	year = {2026},
	journal = {International Journal of Drug Delivery Technology},
	volume = {16},
