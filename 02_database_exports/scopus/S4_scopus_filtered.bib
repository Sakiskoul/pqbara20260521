	correspondence_address = {M.A. Razzaque; School of Computing, Engineering and Digital Technologies, Teesside University, Middlesbrough, United Kingdom; email: m.razzaque@tees.ac.uk},
	publisher = {Elsevier Ltd},
	issn = {03062619},
	coden = {APEND},
	language = {English},
	abbrev_source_title = {Appl. Energy},
	type = {Article},
	publication_stage = {Final},
