	keywords = {Computational complexity; Hamiltonians; Polynomial approximation; Quantum computers; Clifford operations; Commitment scheme; Complexity class; Local hamiltonians; Quantum complexity; Quantum interactive proof systems; Quantum zero-knowledge proofs; Zero knowledge proof; Quantum cryptography},
