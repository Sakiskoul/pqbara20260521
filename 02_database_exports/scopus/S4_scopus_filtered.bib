@CONFERENCE{Lakshmanan2025890,
	author = {Lakshmanan, Murugan},
	title = {Quantum-Safe Fuzzy Transformers for Crossborder Settlement in Decentralized Finance},
	year = {2025},
	journal = {2025 IEEE 4th World Conference on Applied Intelligence and Computing, AIC 2025},
	pages = {890 - 896},
