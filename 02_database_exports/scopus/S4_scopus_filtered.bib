	source = {Scopus},
	note = {Cited by: 34}
}

@CONFERENCE{Balasubramaniam202394,
	author = {Balasubramaniam, Akoramurthy and Surendiran, B.},
	title = {Quantum-resistant Blockchain Cryptography-based Smart City Transactions},
	year = {2023},
	journal = {ACM International Conference Proceeding Series},
	pages = {94 - 101},
	doi = {10.1145/3607947.3607965},
