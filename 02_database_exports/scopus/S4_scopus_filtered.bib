	title = {Quantum Enhanced Energy Blockchain for Peer-to-Peer Trading},
	year = {2025},
	journal = {16th International Conference on Information, Intelligence, Systems and Applications, IISA 2025},
	pages = {},
	doi = {10.1109/IISA66859.2025.11311303},
	url = {https://www.scopus.com/pages/publications/105031895580?origin=resultslist},
	affiliations = {Technical University of Cluj-Napoca, Computer Science Department, Cluj-Napoca, Romania; School of Electrical & Computer Engineering, National Technical University of Athens, Decision Support Systems Laboratory, Athens, Greece},
	abstract = {In urban contexts the buildings' energy demand is quite significant, therefore their energy flexibility is important for successful Demand Response (DR) programs. Despite its promising features, blockchain adoption in DR poses significant security and privacy concerns, its long-term reliability being increasingly challenged by the rise of quantum computing, which threatens conventional cryptographic methods. Existing approaches do not adequately address this emerging vulnerability in the context of peer-to-peer (P2P) energy trading and buildinglevel flexibility aggregation. To bridge this gap, in this paper we propose the integration of a Quantum Random Number Generator (QRNG) into a blockchain platform, enhancing security and P2P energy flexibility transactions between residents and buildings. We show how quantum seeds can support the account generation and hashing of energy transactions in P2P energy trading. The Ethereum Keccak algorithm was adapted to incorporate a random quantum seed generated, reinforcing the blockchain's resilience against quantum computing threats and ensuring the integrity and immutability of energy transaction data. The evaluation results show quantum energy blockchain feasibility in managing energy flexibility transactions inside a building while featuring low additional overheads.  Β© 2025 IEEE.},
	author_keywords = {energy blockchain; energy wallet; hash function; Quantum Random Number Generator; quantum resistant},
	keywords = {Blockchain; Computer privacy; Distributed computer systems; Number theory; Quantum computers; Quantum cryptography; Quantum theory; Random number generation; Block-chain; Energy; Energy blockchain; Energy flexibility; Energy trading; Energy wallet; Quantum Computing; Quantum random number generators; Quantum resistant; Hash functions},
