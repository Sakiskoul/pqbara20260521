	year = {2026},
	journal = {Multimedia And Multimodal Intelligence For Sustainable Development},
	pages = {23 - 46},
	doi = {10.1201/9781003634522-2},
	url = {https://www.scopus.com/pages/publications/105026649468?origin=resultslist},
	affiliations = {James Watt School of Engineering, University of Glasgow United Kingdom, United Kingdom; Department of Communications and Electronics Engineering, Air Defense College EMA, Cairo, Egypt; Electronics and Communication Engineering Department, GLA, Uttar Pradesh, Mathura, India; Department of Communications and Electronics Engineering, Air Defense CollegeEMA, Cairo, Egypt; Department of Information Technology, University Menoufia, Menoufia, Egypt; Cybersecurity Center, Prince Mohammad Bin Fahd University, Al Jawharah, KhobarDhahran, Saudi Arabia; School of Computer Science and Electronic Engineering, University of Essex, Colchester, United Kingdom},
	abstract = {The fast-growing use of artificial intelligence (AI) in multimedia communication systems has generated seismic change across areas such as smart cities, e-health, and environmental monitoring. While the advantages are clear, and efficiencies generated through AI integration are significant, they can also create severe vulnerabilities-in this case, adversarial attacks and deepfakes, as well as energy inefficiencies that hinder security and global sustainability efforts. This chapter provides a framework for secured AI-based multimedia communication that links advancement with sustainable development and security measures. By integrating AI technologies with cybersecurity methods and environmental impact assessment, it aims to achieve meaningful guidance for building resilient and energy-efficient systems. The chapter begins with a section underpinned by more fundamental definitions and general issues that surround AI-enabled multimedia processing technologies (e.g., convolutional neural networks (CNNs), transformers, generative adversarial networks (GANs)), as well as the emergence of 5G/6G and edge computing architectures in enabling high-fidelity communication with low latency. Then, it examines aspects of the rapidly changing landscape of security threats (e.g., data poisoning attacks, adversarial perturbations in visual and audio processing models, and breaches of privacy in biometric and internet-of-things (IoT)-enabled data environments) and supplies some potential defensive mechanisms, such as homomorphic encryption for privacy-preserving AI, blockchain-based decentralized trust approaches, and federated learning (FL)-based solutions that limit data exposure but maintain compliance with general data protection regulation (GDPR) and the AI Act. We then provide examples that illustrate the practical implementation of these approaches in smart cities (AI-based anomaly detection with blockchain), e-health (encrypted FL with diagnostic imaging), and climate (low-power analysis of remote satellite imagery). Next, a framework for assessing aspects of performance, such as robustness, explainable AI (XAI), cost of computation, and energy consumption, is proposed. This framework aligns with the United Nations (UN) sustainable development goals (SDGs). Finally, the chapter concludes with a research roadmap for secured and sustainable multimedia systems via quantum-safe AI, XAI, and cross-modal security for hybrid data streams. Β© 2026 selection and editorial matter, [Vinay Kumar Srivastava, Priyank Khare, Divyanshu Awasthi, Lalit Garg]; individual chapters, the contributors.},
	keywords = {Edge computing; Environmental impact assessments; Green computing; Internet of things; Multimedia systems; Network security; Neural networks; Privacy-preserving techniques; Security systems; Smart city; Sustainable development; Block-chain; E health; Ehealth; Energy; Environmental Monitoring; Global sustainability; Health monitoring; Intelligence integration; Multi-media communications; Multimedia communication systems; Blockchain},
	publisher = {CRC Press},
	isbn = {978-104057882-7; 978-104106250-9},
	language = {English},
	abbrev_source_title = {Multimedia And Multimodal Intelligence For Sustainable Development},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

