@CONFERENCE{Chhibber2025,
	author = {Chhibber, Navin and Rastogi, Amber and Mahida, Ankur and Gupta, Vatsal and Ranjan, Piyush},
	title = {Quantum-Resistant Cryptographic Models for Next-Gen Cybersecurity},
