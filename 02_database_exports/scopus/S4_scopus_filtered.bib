@ARTICLE{Chen2025,
	author = {Chen, Chao and Zhang, Fangguo and An, Zhiyuan and Zhang, Jing},
	title = {ISH: Isogeny-based Secret Handshakes with friendly communication costs},
	year = {2025},
	journal = {Computer Standards and Interfaces},
	volume = {91},
	pages = {},
	doi = {10.1016/j.csi.2024.103880},
	url = {https://www.scopus.com/pages/publications/85196711384?origin=resultslist},
	affiliations = {School of Computer Science and Engineering, Sun Yat-sen University, Guangzhou, 510006, China; Guangdong Key Laboratory of Information Security, Guangzhou, 510006, China; Modern Industrial Innovation Practice Center, Dongguan Polytechnic, Dongguan, 523808, China},
	abstract = {Secret handshake schemes allow members from the same organization to authenticate each other anonymously. After its proposal, various schemes have been introduced to achieve advanced privacy protection. Regrettably, all the schemes based on number theoretic assumptions are insecure under quantum computers, and the known post-quantum designs are impractical because of the overhead cost (> 10 MB). To fill the gap, we present the first isogeny-based secret handshake scheme (i.e., ISH) with a friendly communication cost (67 KB). In particular, we apply the CSI-FiSh signature scheme to generate group keys and credentials. For each zero-knowledge transcript in the credential, we generate a signature for handshake via the Fiatβ€“Shamir paradigm, while it fails anonymous authentication. To fix the issue, we modify the Fiatβ€“Shamir-type signature by embedding the CSIDH ephemeral private key into the challenge space. After verifying the modified signatures, two users recover the right ephemeral private key if they are in the same group, then they can negotiate a session key and authenticate each other. Our scheme is proved secure under the Group Action Inverse Problems (GAIP) in the random oracle model, and deniability, as an attractive property, also holds for ISH, enabling user's ability to deny their interactions in the finished handshakes. Via choosing appropriate parameters, the communication cost surpasses all the existing post-quantum secret handshakes. Β© 2024 Elsevier B.V.},
	author_keywords = {CSI-FiSh; Group actions; Isogeny-based cryptography; Post-quantum cryptography; Privacy-preserving; Secret handshake schemes},
	keywords = {Authentication; Fish; Quantum computers; Quantum cryptography; Communication cost; CSI-fish; Fiat-Shamir; Group actions; Isogeny-based cryptography; Post quantum; Post quantum cryptography; Privacy preserving; Secret handshake; Secret handshake scheme; Inverse problems},
	correspondence_address = {F. Zhang; School of Computer Science and Engineering, Sun Yat-sen University, Guangzhou, 510006, China; email: isszhfg@mail.sysu.edu.cn},
	publisher = {Elsevier B.V.},
