	title = {Post Quantum Zero Knowledge Consensus for Cooperative Malware Verdicts},
	year = {2025},
	journal = {Proceedings of 10th International Conference on Communication and Electronics Systems, ICCES 2025},
	pages = {2039 - 2046},
	doi = {10.1109/ICCES67310.2025.11337122},
