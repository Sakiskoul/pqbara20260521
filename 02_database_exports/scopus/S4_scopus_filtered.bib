}

@ARTICLE{Gvili2021365,
	author = {Gvili, Yaron and Ha, Julie and Scheffler, Sarah and Varia, Mayank and Yang, Ziling and Zhang, Xinyuan},
	title = {TurboIKOS: Improved Non-interactive Zero Knowledge and Post-quantum Signatures},
	year = {2021},
