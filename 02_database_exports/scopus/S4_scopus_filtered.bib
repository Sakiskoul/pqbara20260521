	year = {2025},
	journal = {2025 7th International Conference on Blockchain Computing and Applications, BCCA 2025},
	pages = {851 - 856},
	doi = {10.1109/BCCA66705.2025.11229675},
	url = {https://www.scopus.com/pages/publications/105026929085?origin=resultslist},
	affiliations = {Faculty of Computer Science and Engineering, Kuwait College of Science and Technology (KCST), Kuwait-City, Kuwait},
	abstract = {EMV chip technology is widely deployed in Automated Teller Machines (ATMs) and Kuwait Civil IDs to enhance transaction security; however, threats such as cloning, shimming, and pre-play attacks remain a concern. Existing logging and forensic methods often rely on centralised databases and classical cryptography (e.g., RSA, ECC), which are vulnerable to future quantum attacks. This work introduces a private, permissioned blockchain ledger secured with post-quantum cryptographic (PQC) primitives-CRYSTALS-Kyber for key establishment and CRYSTALS-Dilithium for transaction attesta-tion-ensuring tamper-resistant, quantum-safe recording of EMV transaction metadata. The ledger integrates behavioural log analytics to detect anomalies, including irregular Application Transaction Counter (ATC) sequences, replayed cryptograms, and firmware changes. Using a single-ATM testbed in the KCST Cyber Security Laboratory, we simulate EMV transaction streams derived from the IEEE-CIS Fraud Detection dataset to evaluate latency, detection accuracy, and forensic verification. Results show that the approach reliably detects ATC rollback and excess-jump anomalies, strong indicators of cloning activity. The proposed solution offers a resilient audit trail to support Security Operations Centre (SOC) investigations and compliance reporting, providing a future-ready defence against evolving EMV threats. Β© 2025 IEEE.},
	author_keywords = {ATM security; blockchain; EMV; fraud detection; post-quantum cryptography},
	keywords = {Automatic teller machines; Cloning; Computer crime; Crime; Firmware; Forensic engineering; Forensic science; Hardware security; Network security; Quantum cryptography; Automated teller machine security; Automated teller machines; Block-chain; Centralized data-base; Chip technology; Cryptographic primitives; EMV; Fraud detection; Post quantum; Post quantum cryptography; Blockchain},
