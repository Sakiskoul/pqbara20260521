	title = {Updatable, Aggregatable, Succinct Mercurial Vector Commitment fromΒ Lattice},
	year = {2024},
	journal = {Lecture Notes in Computer Science},
	volume = {14602 LNCS},
	pages = {3 - 35},
	doi = {10.1007/978-3-031-57722-2_1},
	url = {https://www.scopus.com/pages/publications/85190991557?origin=resultslist},
	affiliations = {The University of Hong Kong, Hong Kong; Harbin Institute of Technology, Shenzhen, China},
	abstract = {Vector commitments (VC) and their variants attract a lot of attention due to their wide range of usage in applications such as blockchain and accumulator. Mercurial vector commitment (MVC), as one of the important variants of VC, is the core technique for building more complicated cryptographic applications, such as the zero-knowledge set (ZKS) and zero-knowledge elementary database (ZK-EDB). However, to the best of our knowledge, the only post-quantum MVC construction is trivially implied by a generic framework proposed by Catalano and Fiore (PKC β€™13) with lattice-based components which causes large auxiliary information and cannot satisfy any additional advanced properties, that is, updatable and aggregatable. A major difficulty in constructing a non-black-box lattice-based MVC is that it is not trivial to construct a lattice-based VC that satisfies a critical property called β€mercurial hidingβ€. In this paper, we identify some specific features of a new falsifiable family of basis-augmented SIS assumption (BASIS) proposed by Wee and Wu (EUROCRYPT β€™23) that can be utilized to construct the mercurial vector commitment from lattice satisfying updatability and aggregatability with smaller auxiliary information. We first extend stateless update and differential update to the mercurial vector commitment and define a new property, named updatable mercurial hiding. Then, we show how to modify our constructions to obtain the updatable mercurial vector commitment that satisfies these properties. To aggregate the openings, our constructions perfectly inherit the ability to aggregate in the BASIS assumption, which can break the limitation of weak binding in the current aggregatable MVCs. In the end, we show that our constructions can be used to build the various kinds of lattice-based ZKS and ZK-EDB directly within the existing framework. Β© International Association for Cryptologic Research 2024.},
	author_keywords = {Lattice; Mercurial commitment; Vector commitment; Zero-knowledge elementary database},
	keywords = {Aggregates; Security of data; Auxiliary information; Block-chain; Lattice; Lattice-based; Mercurial commitments; Property; Vector commitment; Zero knowledge; Zero-knowledge elementary database; Zero-knowledge set; Vectors},
	correspondence_address = {S.-M. Yiu; The University of Hong Kong, Hong Kong; email: smyiu@cs.hku.hk},
	editor = {Tang Q. and Teague V.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303157721-5},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Bronze Open Access}
}

