@ARTICLE{Iavich2025209921,
	author = {Iavich, Maksim and Kuchukhidze, Tamari and Bocu, Razvan},
	title = {Fractional Verkle Trees for Scalable Post-Quantum Signatures},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {209921 - 209937},
	doi = {10.1109/ACCESS.2025.3640288},
	url = {https://www.scopus.com/pages/publications/105024135912?origin=resultslist},
	affiliations = {Caucasus University, Department of Computer Science, Tbilisi, 0102, Georgia; Transilvania University of Brasov, Department of Mathematics and Computer Science, Brasov, 500036, Romania},
	abstract = {Quantum computers threaten to break widely used cryptosystems like RSA and ECC, forcing us to develop new quantum-resistant alternatives. While hash-based signatures like SPHINCS+ offer a proven solution, their reliance on Merkle trees result in large signature sizes and memory-intensive verification, which hinders scalability. We present a novel approach that replaces Merkle trees with Fractional Verkle Trees (FVTs), a hierarchical structure where a large Verkle tree is decomposed into smaller, more manageable pieces, which we call hypertrees. This approach provides fast verification and smaller signatures, while preserving the required level of security. Our FVT construction offers a useful basis for scalable verifiable data structures while lowering memory and verification costs without sacrificing security. Validation by way of a functional prototype shows that the derived Fractal Verkle-Based Digital Signature (FVDS) scheme achieves signature sizes of about 16.2 KB, which is 2.5Γ— smaller than SPHINCS+, while maintaining localized updates and scalable verification. This makes it especially appropriate for bandwidth-constrained applications, such as IoT firmware updates and blockchain light clients. Β© 2013 IEEE.},
	author_keywords = {Cryptographical application; fractional Verkle trees; hash-based digital signatures; HORS; HORST; Merkle tree; quantum cryptography; Verkle tree; Verkle-based HORST},
	keywords = {Authentication; Bandwidth; Electronic document identification systems; Forestry; Network security; Quantum computers; Quantum theory; Cryptographical application; Fractional verkle tree; Hash-based digital signature; HORS; HORST; Merkle trees; Post quantum; Quantum signature; Verkle tree; Verkle-based HORST; Quantum cryptography},
	correspondence_address = {M. Iavich; Caucasus University, Department of Computer Science, Tbilisi, 0102, Georgia; email: miavich@cu.edu.ge},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
