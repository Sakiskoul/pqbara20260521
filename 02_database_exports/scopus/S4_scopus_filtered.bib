@CONFERENCE{Del Pino2018574,
	author = {Del Pino, RafaΓ«l and Lyubashevsky, Vadim and Seiler, Gregor},
	title = {Lattice-based group signatures and zero-knowledge proofs of automorphism stability},
	year = {2018},
	journal = {Proceedings of the ACM Conference on Computer and Communications Security},
	pages = {574 - 591},
	doi = {10.1145/3243734.3243852},
