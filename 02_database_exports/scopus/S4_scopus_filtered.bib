	affiliations = {Zayed University, College of Interdisciplinary Studies, Abu Dhabi, United Arab Emirates; Higher Colleges of Technology, Faculty of Computer Information Systems, Falaj Hazza Campus, Al Ain, United Arab Emirates},
	abstract = {In an era where securing Internet of Things (IoT) devices within Metaverse environments is increasingly critical, existing frameworks often lack robust, quantum-resistant protection suitable for resource-constrained devices. This study aims to develop a comprehensive quantum-resistant security framework designed for IoT-enabled Metaverse applications. Our multilayered architecture incorporates Ideal Coset Lattice Cryptography (ICLC) and a Hypercomplex Multivariate Encryption Scheme (HMES) across the Device, Network, and Metaverse layers. ICLC provides lightweight, quantum-resistant encryption for devices with limited computational resources, while HMES enhances security through complex algebraic structures resistant to quantum attacks. We implement a Zero-Knowledge Proof Authentication mechanism over Hypercomplex Algebras (ZKPHA) to authenticate devices without exposing private keys. An edge computing strategy that employs convex optimization minimizes latency and computational load, ensuring scalability and efficiency. Simulations over a 260-minute period compared our framework with six state-of-the-art methods under various conditions. The results show that our framework reduces the rate of successful cyberattacks on encrypted data to 0.15%, achieves encryption and decryption times of 2.2 milliseconds per operation, and maintains 98.5% system availability during attacks. Β© 1975-2011 IEEE.},
	author_keywords = {computational resources; Internet of Things; metaverse; Quantum computing; scalability; security},
	keywords = {Authentication; Edge computing; Quantum computers; Quantum cryptography; Quantum electronics; Scalability; Algebraic structures; Computational resources; Encryption schemes; Metaverses; Multilayered architecture; Quantum Computing; Resourceconstrained devices; Security; Security frameworks; Zero-knowledge proofs; Convex optimization},
	correspondence_address = {M. Adnan; Higher Colleges of Technology, Faculty of Computer Information Systems, Al Ain, Falaj Hazza Campus, United Arab Emirates; email: madnan@hct.ac.ae},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
