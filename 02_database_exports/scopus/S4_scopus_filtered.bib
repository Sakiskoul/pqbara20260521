	affiliations = {Department of Embedded Technology, School of Electronics Engineering, Vellore Institute of Technology, Vellore, 632014, India; Institute for Sustainable Industries and Liveable Cities, Victoria University, Melbourne, 8001, VIC, Australia},
	abstract = {In recent, rapidly emerging cloud-native microservice architectures, there have been very strenuous requirements for maintaining secure, verifiable identity frameworks, but with quantum computing looming in the background, the requirements have become an even bigger challenge. Present models of identity in the edge environment are centralized trust dependency models and insecure static authentication mechanisms vulnerable to identity spoofing. To overcome these limitations, this study puts forward a Blockchain Driven Quantum Identity Verification Framework designed for microservice-to-microservice authentication between financial cloud infrastructures. This framework introduces quantum-resistant digital identities based on blockchain to enhance trustworthiness, adaptability, and confidentiality: Quantum Hash Anchoring with Adaptive Commitments (QHA-AC) utilizes quantum random walks to bind identities with temporal quantum hashes, which reduce the possibility of hash collisions to below 1e-18 and spoofing to 78%. Federated Quantum Entangled Tokens (FQET) enable decentralized mutual authentication through entangled quantum key pairs across cloud zones, effectively cutting cross-cluster ID spoofing by roughly 91%. Temporal Blockchain Quantum Graph Signatures (TBQGS) model service behavior using dynamic identity graphs verified through quantum gates and blockchain consensus, enhancing traceability with minimal overheads. Quantum Zero-Knowledge Identity Tree (QZKIT) constructs Merkle-like trees from fragmented quantum IDs validated through a zero-knowledge proof method, ensuring identity privacy with less than 0.5% leakages. Using Reinforcement Learning-based Quantum Identity Drift Analysis (RL-QIDA), deep RL is applied to monitor identity behavior in real-time with a 92.4% drift detection accuracy and a minimal false positive ratio. This framework improves authentication reliability and prepares infrastructures for the next-generation secure edge computing. Β© 2025 IEEE.},
	author_keywords = {Blockchain; Cloud Microservices; Edge Security; Federated Authentication Process; Quantum Hashing; Quantum Identity},
	keywords = {Authentication; Edge computing; Electronic document identification systems; Forestry; Network security; Quantum channel; Quantum cryptography; Quantum entanglement; Anchorings; Block-chain; Cloud microservice; Drift analysis; Edge security; Federated authentication process; Quantum entangled; Quantum hashing; Quantum identity; Reinforcement learnings; Blockchain},
