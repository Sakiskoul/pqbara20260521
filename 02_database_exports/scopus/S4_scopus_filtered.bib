@ARTICLE{Li20192026,
	author = {Li, Chao-Yang and Chen, Xiu-Bo and Chen, Yu-Ling and Hou, Yan-Yan and Li, Jian},
	title = {A New Lattice-Based Signature Scheme in Post-Quantum Blockchain Network},
	year = {2019},
