	number = {6},
	pages = {},
	doi = {10.1007/s44443-025-00140-0},
	url = {https://www.scopus.com/pages/publications/105011342605?origin=resultslist},
	affiliations = {Department of Information and Computer Science, College of Computer Science and Engineering, University of Haβ€™il, Haβ€™il, Haβ€™il, 81481, Saudi Arabia; Department of Computer Science, College of Computer Science and Information, University of Basrah, Basrah, 61004, Iraq; Information Technology Management Department, Southern Technical University, Basrah, Iraq; Department of Electronic Technologies, Basra Technical Institute, Southern Technical University, Basra, 61001, Iraq; Department of Computer Engineering, College of Computer Science and Engineering, University of Haβ€™il, Haβ€™il, Haβ€™il, 81481, Saudi Arabia; Department of Education Technology, College of Education, University of Haβ€™il, Haβ€™il, Haβ€™il, 81481, Saudi Arabia; Department of Software Engineering, College of Computer Science and Engineering, University of Haβ€™il, Haβ€™il, Haβ€™il, 81481, Saudi Arabia},
	abstract = {The rapid adoption of Internet of Medical Things (IoMT) devices enables real-time patient monitoring and remote diagnostics and has revolutionized healthcare delivery. Traditional cryptographic schemes like RSA and ECC, which rely on meaningful mathematical challenges, are under great threat from quantum computing, threatening sensitive medical data confidentiality and integrity. This paper proposes a quantum-resistant healthcare security framework based on lattice-based cryptographic primitives such as Learning With Errors (LWE), Ring-LWE (RLWE), and Short Integer Solution (SIS). To this end, we design a five-phase IoMT-friendly frameworkβ€”Initialization, Registration, Authentication, Data Exchange, and Treatmentβ€”where each phase is backed up by lightweight cryptography primitives that can be easily implemented on the low-resource IoMT devices. Relative to the state-of-the-art lattice- and hash-based constructions, our framework involves 50-75% smaller ciphertext sizes, up to a 50% reduction of the communication overhead, and nearly 60% less in computational cost. Furthermore, the solution relies on zero-knowledge proofs, homomorphic encryption as well and attribute-based access control to guarantee strong security and privacy. Using the AVISPA tool, the framework is formally verified, showing its resistance against classical and quantum adversaries. Focusing on tangible healthcare threats, including data tampering and unlicensed access to patient diagnostics, this research paves the way for scalable, efficient, and quantum-resistant medical data protection. Our results pave the way for future investigations into secure post-quantum healthcare and IoT applications. Β© The Author(s) 2025.},
	author_keywords = {Fully homomorphic encryption; Healthcare data security; Internet of medical things (IoMT); Lattice-based cryptography; Post-quantum cryptography; Quantum attack resilience},
	correspondence_address = {M.A. Al-Shareeda; Department of Electronic Technologies, Basra Technical Institute, Southern Technical University, Basra, 61001, Iraq; email: Mahmood.alshareedah@stu.edu.iq},
	publisher = {Springer International Publishing},
	issn = {13191578},
	language = {English},
