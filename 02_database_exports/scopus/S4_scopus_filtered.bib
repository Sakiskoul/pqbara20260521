	year = {2026},
	journal = {IEEE Internet of Things Journal},
	pages = {},
	doi = {10.1109/JIOT.2026.3667814},
	url = {https://www.scopus.com/pages/publications/105031526604?origin=resultslist},
	affiliations = {School of Cyberspace, Hangzhou Dianzi University, Zhejiang, Hangzhou, 310018, China; Zhejiang University, Department of Information Center, Zhejiang, Hangzhou, 310018, China; Chief Engineer at Zhejiang Dongβ€™an Testing Technology Co., Ltd, Hangzhou, 310018, China},
	abstract = {Vehicular ad-hoc networks (VANETs) require authentication mechanisms that simultaneously deliver privacy, accountability, and timely cross-domain synchronization. The existing schemes struggle to balance unlinkable anonymity with effective tracing. They are also vulnerable to future quantum adversaries and rely on slow and costly revocation workflows. We present ZebraCPA, a decentralized conditional privacy-preserving authentication (CPPA) framework that combines lattice-based traceable ring signatures (TRS) with zero-knowledge (ZK) proofs and a consortium blockchain. Our TRS design removes linkability tags and embeds a tracing trapdoor only recoverable by the authorized auditors. It naturally extends to threshold tracing for multi-auditor settings. To avoid the plain-text key escrow, ZebraCPA leverages the additively homomorphic property of the commitments to support the ciphertext-only key updates by the vehicles, preventing the catastrophic key leakage at authorities. A hierarchical blockchain layer provides fast, consistent synchronization of active-key status across regions. The experiments show 1.7Γ—β€“7.0Γ— speedups over state-of-the-art baselines in signing/verification while retaining an anonymity-set size of N=10. The network-level simulations further indicate that ZebraCPA reduces an average packet delay by 30.7% - 61.6% compared with the baselines under moderate traffic densities. Moreover, the security of ZebraCPA is validated through our informal analysis under the Dolev-Yao model. Overall, ZebraCPA achieves post-quantum security, strong anonymity with conditional traceability, and practical deployment efficiency for VANETs, outperforming the existing solutions in terms of both latency and robustness. Β© 2014 IEEE.},
	author_keywords = {Conditional Privacy-preservation Authentication; Lattice-based Ring Signature; Vehicular Ad-Hoc Networks},
	keywords = {Anonymity; Authentication; Blockchain; Electronic document identification systems; Network security; Privacy-preserving techniques; Quantum cryptography; Block-chain; Conditional privacies; Conditional privacy-preservation authentication; Decentralised; Lattice-based; Lattice-based ring signature; Privacy preservation; Privacy-preserving authentication; Ring signatures; Vehicular Adhoc Networks (VANETs); Vehicular ad hoc networks},
