	author = {Iovane, Gerardo and Amatore, Riccardo},
	title = {A Decentralized Storage and Security Engine (DeSSE) Using Information Fusion Based on Stochastic Processes and Quantum Mechanics},
	year = {2025},
	journal = {Applied Sciences (Switzerland)},
	volume = {15},
	number = {2},
	pages = {},
	doi = {10.3390/app15020759},
