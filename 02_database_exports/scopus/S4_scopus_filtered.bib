	title = {LatInc: A Practical Lattice-Based Privacy-Preserving Incentive System},
	year = {2026},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	pages = {},
	doi = {10.1109/TDSC.2026.3686763},
	url = {https://www.scopus.com/pages/publications/105037078618?origin=resultslist},
	affiliations = {Hainan University, School of Cyberspace Security (School of Cryptography), Hainan, Haikou, 570228, China; Xidian University, State Key Laboratory of Integrated Services Networks, Shaanxi, Xi'an, 710071, China; Singapore Management University, School of Computing and Information Systems, 188065, Singapore},
	abstract = {Incentive (or point) systems are widely deployed across industries such as retail, tourism, and finance to enhance customer loyalty and create benefits for service providers. However, their operation typically requires the collection and processing of sensitive customer data, leading to significant privacy concerns. Existing privacy-preserving incentive systems predominantly rely on bilinear pairings and the discrete logarithm assumption, which, while efficient in classical settings, are vulnerable to quantum adversaries and thus lack long-term security guarantees. To address this limitation, we present LatInc, a practical lattice-based privacy-preserving incentive system. LatInc integrates state-of-the-art lattice-based signatures with efficient protocols, the ABDLOP commitment, and efficient lattice zero-knowledge proofs, achieving a robust balance between post-quantum security and efficiency. Relying on the hardness of the MLWE and MSIS problems, we formally prove that LatInc achieves unforgeability, anonymity, and framing-resistance in the random oracle model. We implement a demo of the system and evaluate its performance on a standard laptop platform. Experimental results show that the communication overheads for the Earning and Spending protocols are approximately 99 KB and 140 KB, respectively, with execution times of 610 ms and 900 ms, highlighting significant efficiency gains over previous lattice-based incentive constructions. Β© 2004-2012 IEEE.},
	author_keywords = {anonymous authentication; incentive system; lattice-based cryptography; privacy-preserving},
	keywords = {Anonymity; Authentication; Network security; Privacy-preserving techniques; Quantum cryptography; Quantum efficiency; Quantum theory; Sensitive data; Anonymous authentication; Bilinear pairing; Customer data; Customer loyalty; Incentive systems; Lattice-based; Lattice-based cryptography; Privacy concerns; Privacy preserving; Service provider; Sales},
	correspondence_address = {C. Cao; Hainan University, School of Cyberspace Security (School of Cryptography), Haikou, Hainan, 570228, China; email: caochunjie_hnu@126.com},
