@ARTICLE{Aurangzeb20242493,
	author = {Aurangzeb, Muhammad and Wang, Yifei and Iqbal, Sheeraz and Naveed, Ausnain and Ahmed, Zeeshan and Alenezi, Mohammed and Shouran, Mokhtar},
	title = {Enhancing cybersecurity in smart grids: Deep black box adversarial attacks and quantum voting ensemble models for blockchain privacy-preserving storage},
	year = {2024},
	journal = {Energy Reports},
	volume = {11},
	pages = {2493 - 2515},
