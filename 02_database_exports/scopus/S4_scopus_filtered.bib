	url = {https://www.scopus.com/pages/publications/105002594655?origin=resultslist},
	affiliations = {Ritsumeikan University, Department of Information Science and Engineering, Osaka, Ibaraki, 567-8570, Japan; The University of Osaka, Graduate School of Engineering, Department of Information and Communications Technology, Osaka, Suita, 565-0871, Japan},
	abstract = {A blockchain is an important component in the design of secure distributed file systems, such as cryptocurrencies. One of the key components of the blockchain is the key-value commitment scheme, which constructs a commitment value from two inputs: a key and a value. In a conventional commitment scheme, a single user constructs a commitment value from an input value, whereas in a key-value commitment scheme, multiple users construct a commitment value from their keys and values. Both conventional and key-value commitment schemes must satisfy binding and hiding properties. The key-binding and key-hiding properties guarantee that neither the sender nor the verifier can act maliciously. The concept of a key-value commitment scheme was first proposed by Agrawal et al. in 2020 using a strong RSA assumption. Their scheme satisfies the key-binding but not key-hiding properties. In this paper, we propose two lattice-based key-value commitment schemes, Insert-KVC<sub>m</sub>/<sub>2,n,q,Ξ²</sub> and KVC<sub>m</sub><sub>,n,q</sub>,Ξ², that satisfy both the key-binding and the key-hiding properties. The key-binding property of both Insert-KVC<sub>m</sub>/<sub>2,n,q,Ξ²</sub> and KVC<sub>m</sub><sub>,n,q,Ξ²</sub> are proven under the short integer solution (SIS<sup>β</sup><sub>n</sub><sub>,m,q,Ξ²</sub>) problem. The key-hiding property of both Insert-KVC<sub>m</sub>/<sub>2,n,q,Ξ²</sub> and KVC<sub>m</sub><sub>,n,q,Ξ²</sub> are proven under the Decisional-SIS<sup>β</sup><sub>n</sub><sub>,m,q,Ξ²</sub>-form problem, which is newly defined in this paper. We demonstrate the difficulty of the Decisional-SIS<sup>β</sup><sub>n</sub><sub>,m,q,Ξ²</sub>-form problem by showing that the Decisional-SIS<sup>β</sup><sub>n</sub><sub>,m,q,Ξ²</sub>-form problem is secure when the SIS<sup>β</sup><sub>n</sub><sub>,m,q</sub>,Ξ² problem is secure. Finally, we analyze the computational costs of Insert-KVC<sub>m</sub>/<sub>2,n,q,Ξ²</sub> and KVC<sub>m</sub><sub>,n,q</sub>,Ξ². Our method is the first lattice-based key-value commitment scheme with proven the key-binding and the key-hiding properties. Β© 1963-2012 IEEE.},
	author_keywords = {applied cryptography; applied to blockchain; key-binding; key-hiding; lattice-based key-value commitment scheme; post quantum cryptography; Security},
	keywords = {Blockchain; Applied cryptography; Applied to blockchain; Block-chain; Commitment scheme; Key binding; Key values; Key-hiding; Lattice-based; Lattice-based key-value commitment scheme; Post quantum cryptography; Security; Quantum cryptography},
	correspondence_address = {H. Miyaji; Ritsumeikan University, Department of Information Science and Engineering, Ibaraki, Osaka, 567-8570, Japan; email: h-miyaji@fc.ritsumei.ac.jp},
