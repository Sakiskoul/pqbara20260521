@CONFERENCE{Agrawal2025,
	author = {Agrawal, Arun and Jena, Akankshya and Mohanty, Pratyusha},
	title = {Quantum-Secure Blockchain Authentication Protocol for 6G Devices},
	year = {2025},
	journal = {International Conference on Emerging Technologies in Electronics and Green Energy, ICETEG 2025},
	pages = {},
	doi = {10.1109/ICETEG66194.2025.11473057},
