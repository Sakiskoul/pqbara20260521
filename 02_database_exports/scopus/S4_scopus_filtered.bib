	year = {2025},
	journal = {Advanced Sciences and Technologies for Security Applications},
	volume = {Part F458},
	pages = {189 - 206},
	doi = {10.1007/978-3-031-85008-0_9},
	url = {https://www.scopus.com/pages/publications/105007250637?origin=resultslist},
	affiliations = {Department of Electrical Engineering, College of Technology and Engineering, National Taiwan Normal University, Taipei, Taiwan; Department of Information Technology, Manipal Institute of Technology Bengaluru, Manipal Academy of Higher Education, Manipal, India},
	abstract = {The combination of edge computing alongside the Internet of Things (IoT) into 6G networks will transform how we process, store, and secure data. As the quantity of connected devices grows, IoT devices will produce and transmit vast volumes of data to cloud infrastructure. This rise in data will further lead to several challenges, a few being, increased latency, limited bandwidth, high costs of transmission, increased power consumption, and security and privacy issues. These issues are effectively addressed by edge computing, a framework in which data is processed and stored nearer to end-users and IoT devices. This chapter explores the essential security aspects of IoT and edge computing within 6G networks. We discuss the traditional security models applied in the cloud and previous generations of networks and compare them with the new demands of 6G. Furthermore, we briefly give insights on some of the innovative solutions for securing the 6G ecosystem, including zero-trust architectures, blockchain technologies, and quantum-resistant encryption. Β© The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {6G networks; Edge computing; Internet of Things (IoT); Security},
	correspondence_address = {S.S. Reddy; Department of Electrical Engineering, College of Technology and Engineering, National Taiwan Normal University, Taipei, Taiwan; email: smithasreddy13@gmail.com},
	publisher = {Springer},
	issn = {16135113},
	language = {English},
	abbrev_source_title = {Adv. Sci. Tech. Sec. Appl.},
	type = {Book chapter},
