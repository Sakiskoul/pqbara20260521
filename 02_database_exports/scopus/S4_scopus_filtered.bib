@BOOK{Garg202539,
	author = {Garg, Neha and Datta, Priyanka and Aggarwal, Amitesh and Kaur, Amanpreet and Gulzar, Yonis},
	title = {Innovating Securely: 6G and IoT for Immersive Futures},
	year = {2025},
	journal = {Secure Communication for the 6G and the Internet of Things Networks: Advances and Applications},
	pages = {39 - 53},
	doi = {10.1201/9781003586456-3},
	url = {https://www.scopus.com/pages/publications/105025844449?origin=resultslist},
	affiliations = {Chitkara University Institute of Engineering and Technology, Chitkara University, Rajpura, India; Department of Management Information Systems, College of Business Administration, King Faisal University, Al Ahsa, Saudi Arabia},
	abstract = {The emergence of 6 Generation (6G) and the Internet of Things (IoT) is accelerating the development of immersive technologies such as virtual, augmented, and extended reality (VR, AR, and XR, respectively) by enabling new levels of connectivity, real-time interactions, and ultra-low latency. However, this progress also opens a new frontier of security and privacy issues that need to be solved to fully unleash the potential of immersive ecosystems. This chapter investigates the 6G, IoT, and immersive technology nexus and argues that robust security frameworks are critically needed. It first describes the generic vulnerabilities of 6Gβ€™s ultra-dense networks and a huge number of IoT devices, and the dangers of data breaches, unauthorized access, and cyber-physical threats. Then, it discourses on the advanced solutions which include quantum-resistant cryptography, blockchain-based trust management, and artificial intelligence (AI)-based threat detection and analysis suitable for immersive applications such as AR, VR, and XR. The chapter also examines the ethical issues, the regulatory aspects, and the need for international cooperation to make sure that the development is secure and sustainable. In this chapter, technical and practical aspects of securing 6G and IoT systems are identified, and a guideline for providing reliable and safe immersive experiences is proposed. Β© 2026 selection and editorial matter, Gaganpreet Kaur, A.V. Senthil Kumar, G. Prasanna Lakshmi, and Rakesh Nyayapati individual chapters, the contributors.},
