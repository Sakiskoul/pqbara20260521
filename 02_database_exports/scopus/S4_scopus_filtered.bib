@ARTICLE{Azhar2025,
	author = {Azhar, Hafiz Burhan and Butt, Khushbu Khalid and Awan, Nazish Umar and Irshad, Omer},
	title = {Quantum-Resistant Merkle Trees Enhancing Data Integrity with Post-Quantum Cryptography and Zero-Knowledge Proof},
