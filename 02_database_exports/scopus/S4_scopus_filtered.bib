	year = {2025},
	journal = {3rd International Conference on Electronics and Renewable Systems, ICEARS 2025 - Proceedings},
	pages = {995 - 1002},
	doi = {10.1109/ICEARS64219.2025.10940216},
	url = {https://www.scopus.com/pages/publications/105002712541?origin=resultslist},
	affiliations = {Rajalakshmi Engineering College, Tamil Nadu, Chennai, India; Rajalakshmi Engineering College, Computer Science and Engineering, Tamil Nadu, Chennai, India},
	abstract = {A new end-to-end encrypted chat application emerges with the purpose of solving security issues created by quantum computing and advanced cyber threats. Reliability of privacy and data integrity and authentication relies on three elements from the proposed framework which combines post-quantum cryptography with zero-knowledge authentication service along with hardware-based key protection methods. The key exchange depends on CRYSTALS-Kyber-1024 which follows NIST standards for quantum resistance yet supports X25519 with Kyber because of backward compatibility needs. Hardware-based AES-256 encryption with OCB mode enables parallel processing which provides a multi-core architecture speed of 3.8 GB/s. The symmetric key derivation process employs HKDF-SHA3-512 although secret data is protected through hardware enclaves including Intel SGX and ARM TrustZone which makes it resistant to physical extraction. The use of zk-SNARKs makes it possible for users to authenticate for passwordless access without revealing the account credentials. The Noise Protocol Framework with the ProVerif tool verifies correct protocol execution and testing reveals key exchange with Kyber-1024 requires 1.5 ms and message encryption with AES-OCB takes 0.02 ms for each 1 KB. The encryption rate at 20% faster leads to 256-bit quantum security capability higher than Signal's X3DH or WhatsApp's AES-128-ECB encryption systems. The security solution prevents nonce reuse attacks and tampering attempts as well as man-in-the-middle interceptions while meeting NIST post-quantum standard criteria. The research development creates improved secure communication technologies by integrating quantum readiness solutions with practical usage requirements. Β© 2025 IEEE.},
	author_keywords = {AES-OCB; CRYSTALS-Kyber; End-to-end encryption; Post-quantum cryptography; Secure Communication through End-to-End Encryption; Secure enclaves; zk-SNARKs},
	keywords = {Authentication; Data privacy; Digital storage; Hardware security; Nanocrystallization; Network security; Quantum communication; Quantum electronics; Secure communication; AES-OCB; CRYSTALS-kyber; End to end; End-to-end encryption; Key-exchange; Post quantum cryptography; Secure communication through end-to-end encryption; Secure enclave; Zk-SNARK; Quantum cryptography},
	correspondence_address = {R. Muthu Pandeeswari; Rajalakshmi Engineering College, Chennai, Tamil Nadu, India; email: muthupandeeswari.r@rajalakshmi.edu.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833150967-5},
	language = {English},
	abbrev_source_title = {Int. Conf. Electron. Renew. Syst., ICEARS - Proc.},
	type = {Conference paper},
