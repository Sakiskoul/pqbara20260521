@ARTICLE{Singamaneni2025135722,
	author = {Singamaneni, Kranthi Kumar and Kumar, Budati Anil and Kolandaisamy, Raenu A.L. and Dommeti, Vijaya Saradhi and Katragadda, Swetha},
	title = {An Efficient Quantum Blockchain Framework With Edge Computing for Privacy-Preserving 6G Networks},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {135722 - 135740},
