@CONFERENCE{Liu202467,
	author = {Liu, Keyang and Takagi, Tsuyoshi},
	title = {A Transparent Zero-Knowledge Dual Membership Set Commitment based on Perfect Hash Function},
	year = {2024},
	journal = {Proceedings - 2024 12th International Symposium on Computing and Networking, CANDAR 2024},
	pages = {67 - 76},
