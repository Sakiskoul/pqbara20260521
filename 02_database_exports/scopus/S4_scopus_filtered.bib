@ARTICLE{Chia2021315,
	author = {Chia, Nai-Hui and Chung, Kai-Min and Yamakawa, Takashi},
	title = {A Black-Box Approach to Post-Quantum Zero-Knowledge in Constant Rounds},
	year = {2021},
	journal = {Lecture Notes in Computer Science},
	volume = {12825 LNCS},
	pages = {315 - 345},
	doi = {10.1007/978-3-030-84242-0_12},
