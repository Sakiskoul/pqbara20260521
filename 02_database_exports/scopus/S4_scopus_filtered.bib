	affiliations = {QuICS, University of Maryland, College Park, United States; Luddy School of Informatics, Computing, and Engineering, Indiana University, Bloomington, United States; Institute of Information Science, Academia Sinica, Taiwan, Taiwan; NTT Secure Platform Laboratories, Tokyo, Japan},
	abstract = {In a recent seminal work, Bitansky and Shmueli (STOC β€™20) gave the first construction of a constant round zero-knowledge argument for NP secure against quantum attacks. However, their construction has several drawbacks compared to the classical counterparts. Specifically, their construction only achieves computational soundness, requires strong assumptions of quantum hardness of learning with errors (QLWE assumption) and the existence of quantum fully homomorphic encryption (QFHE), and relies on non-black-box simulation. In this paper, we resolve these issues at the cost of weakening the notion of zero-knowledge to what is called Οµ -zero-knowledge. Concretely, we construct the following protocols: β€“ We construct a constant round interactive proof for NP that satisfies statistical soundness and black-box Οµ -zero-knowledge against quantum attacks assuming the existence of collapsing hash functions, which is a quantum counterpart of collision-resistant hash functions. Interestingly, this construction is just an adapted version of the classical protocol by Goldreich and Kahan (JoC β€™96) though the proof of Οµ -zero-knowledge property against quantum adversaries requires novel ideas. β€“ We construct a constant round interactive argument for NP that satisfies computational soundness and black-box Οµ -zero-knowledge against quantum attacks only assuming the existence of post-quantum one-way functions. At the heart of our results is a new quantum rewinding technique that enables a simulator to extract a committed message of a malicious verifier while simulating verifierβ€™s internal state in an appropriate sense. Β© 2021, International Association for Cryptologic Research.},
	keywords = {Quantum cryptography; Quantum theory; Black box approach; Black boxes; Classical counterpart; Computational soundness; First constructions; Fully homomorphic encryption; Hardness of learning; Learning with Errors; Post quantum; Zero knowledge; Hash functions},
	correspondence_address = {N.-H. Chia; QuICS, University of Maryland, College Park, United States; email: naichia@iu.edu},
	editor = {Malkin T. and Peikert C.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
