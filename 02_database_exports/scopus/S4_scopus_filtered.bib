	author = {Santhiya, S. and Madhankumar, S. and Poongodi, K.},
	title = {An Integrated Adaptive Security Framework for Data Security Posture Management with AI-Driven Orchestration and Quantum-Resistant Capabilities},
	year = {2026},
	journal = {Proceedings of 2nd International Conference on Visual Analytics and Data Visualization, ICVADV 2026},
	pages = {322 - 327},
