@CONFERENCE{Aditya2025,
	author = {Aditya and Meerasha, Islabudeen Mohamed},
	title = {Biometric-Controlled, Quantum-Safe ABE with Blockchain for Secure Healthcare Data},
	year = {2025},
	journal = {2nd International Conference on Intelligent Systems for Cybersecurity, ISCS 2025},
	pages = {},
	doi = {10.1109/ISCS69371.2025.11386444},
	url = {https://www.scopus.com/pages/publications/105034881102?origin=resultslist},
	affiliations = {Vellore Institute of Technology, School of Computer Science and Engineering, Tamil Nadu, Vellore, India},
	abstract = {Quantum computing advancements are a significant threat to Electronic Health Record (EHR) security, posing a 'harvest now, decrypt later' threat that exposes patient data to being compromised for decades. Guaranteeing the integrity of this lifetime medical data is therefore essential because their unauthorized disclosure can expose patients to severe risks, from insurance discrimination to social stigma and professional reprisal. In addition, traditional access control frameworks fall short of offering actual data sovereignty and lack verifiable accountability mechanisms. In this paper, we introduce a new framework that couples quantum-safe cryptography with patient-driven control to address both concerns at hand. Our solution is based on a post-quantum Module-Learning with Errors (M-LWE) lattice-based Attribute-Based Encryption (ABE) scheme, hence, sensitive health data is securely and forever shielded. The framework has two fundamental contributions. First one is an access model controlled by biometrics where patients themselves manage and withdraw access to their information from user devices via secure off-chain authentication. This implies that no sophisticated key management systems are required and control is in the hands of the user. Second, a blockchain-audited ledger that securely stores every access event, such as grants and revocations, with an immutable trail for regulatory compliance and trust. In addition to this our architecture is also able to handle a decentralized multi-authority model for scalability across diverse healthcare institutions. The outcome is a holistic framework that ensures data confidentiality against future attack while establishing a new standard for auditable, patient-initiated health information exchange. Β© 2025 IEEE.},
	author_keywords = {Attribute-Based Encryption (ABE); Blockchain; Electronic Health Records; Post-Quantum Cryptography; Privacy-preserving healthcare; Quantum-safe cryptography},
	keywords = {Biometrics; eHealth; Electronic health record; Health risks; Hospital data processing; Information management; Medical computing; Network security; Privacy-preserving techniques; Quantum computers; Quantum cryptography; Regulatory compliance; Attribute-based encryption; Attribute-based encryptions; Block-chain; Electronic health; Health records; Post quantum cryptography; Privacy preserving; Privacy-preserving healthcare; Quantum Computing; Quantum-safe cryptography; Blockchain},
