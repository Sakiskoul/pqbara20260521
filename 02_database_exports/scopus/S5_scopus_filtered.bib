@CONFERENCE{Bonagiri2025747,
	author = {Bonagiri, Krishna and Deepalakshmi, P.},
	title = {Cybersecurity with Blockchain: Strengthening the Privacy and Security of Data in Internet of Things Networks},
	year = {2025},
	journal = {IEEE International Conference on "Computational, Communication and Information Technology", ICCCIT 2025},
	pages = {747 - 752},
	doi = {10.1109/ICCCIT62592.2025.10928036},
	url = {https://www.scopus.com/pages/publications/105002235557?origin=resultslist},
	affiliations = {Quadrant Technologies, Redmond, 98052, WA, United States; School of Computing, Kalasalingam Academy of Research and Education, Virudhunagar (Dist), Tamil Nadu, India},
	abstract = {The explosion of Internet of Things (IoT) devices has changed the way people interact with technology by making data-driven decisions and smart environments feasible. The exponential growth in the number of linked devices has also increased the attack surface for cyber assaults, leading to significant concerns about the privacy and security of Internet of Things networks. Conventional security measures aren't always up to the task of dealing with the unique challenges posed by the Internet of Things (IoT), such as resource scarcity, unpredictable network topologies, and the generation of massive volumes of data. Increasing the cybersecurity posture of Internet of Things networks is the focus of this research, which investigates the possibility of incorporating blockchain technology as a promising solution. We propose a novel design that leverages the immutability, decentralization, and data encryption features of blockchain technology to secure data from the Internet of Things (IoT). Using smart contracts to automate security protocols, the framework creates a trustless environment where Internet of Things devices can securely share information. We analyze common Internet of Things weaknesses such as the framework's ability to prevent data modification, unauthorized access. We undertake a detailed examination of the performance of the framework. All things considered, our research shows that the blockchain-based approach greatly improves the privacy and security of IoT data. Decentralized consensus methods fortify the system against weak points, and an immutable ledger ensures that all data transfers are secure. Access control and authentication procedures are simplified by the utilization of smart contracts, which in turn reduces the likelihood of unauthorized data breaches occurring. Both the scalability and processing overhead concerns that are involved with the application of blockchain technology in Internet of Things networks are addressed by this research. We offer optimization methods to overcome these challenges, so the suggested framework will remain functional and beneficial for Internet of Things applications in the actual world. This research provides strong evidence in support of using blockchain technology to secure Internet of Things networks. The proposed architecture not only strengthens the cybersecurity infrastructure, but also allows for the creation of more private and secure Internet of Things applications. Findings from this study add to the continuing efforts to safeguard the digital environment against cyber threats that are always developing.  Β© 2025 IEEE.},
