	correspondence_address = {I. Opirskyy; Lviv Polytechnic National University, Lviv, 12 Stepan Bandera str., 79013, Ukraine; email: ivan.r.opirskyi@lpnu.ua},
	editor = {Osadcha K. and Vakaliuk T. and Osadchyi V.},
