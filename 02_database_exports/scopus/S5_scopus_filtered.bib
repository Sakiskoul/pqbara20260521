@ARTICLE{Zhu2026506,
	author = {Zhu, Xudong and Zhang, Xinxuan and Song, Xuyang and Deng, Yi and Wei, Yuanju and Yang, Liuyu},
	title = {Extending Groth16 forΒ Disjunctive Statements},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16054 LNCS},
	pages = {506 - 527},
	doi = {10.1007/978-3-032-07891-9_26},
	url = {https://www.scopus.com/pages/publications/105020689685?origin=resultslist},
	affiliations = {Key Laboratory of Cyberspace Security Defense, Institute of Information Engineering, CAS, Beijing, China; School of Cyber Security, University of Chinese Academy of Sciences, Beijing, China; Anoma, Beijing, China},
	abstract = {Two most common ways to design non-interactive zero knowledge (NIZK) proofs are based on Sigma (Ξ£)-protocols (an efficient way to prove algebraic statements) and zero-knowledge succinct non-interactive arguments of knowledge (zk-SNARK) protocols (an efficient way to prove arithmetic statements). However, in the applications of cryptocurrencies such as privacy-preserving credentials, privacy-preserving audits, and blockchain-based voting systems, the zk-SNARKs for general statements are usually implemented with encryption, commitment, or other algebraic cryptographic schemes. Moreover, zk-SNARKs for many different arithmetic statements may also be required to be implemented together. Clearly, a typical solution is to extend the zk-SNARK circuit to include the code for algebraic part. However, complex cryptographic operations in the algebraic algorithms will significantly increase the circuit size, which leads to impractically large proving time and CRS size. Thus, we need a flexible enough proof system for composite statements including both algebraic and arithmetic statements. Unfortunately, while the conjunction of zk-SNARKs is relatively natural and numerous effective solutions are currently available (e.g. by utilizing the commit-and-prove technique), the disjunction of zk-SNARKs is rarely discussed in detail. In this paper, we mainly focus on the disjunctive statements of Groth16, and we propose a Groth16 variantβ€”CompGroth16, which provides a framework for Groth16 to prove the disjunctive statements that consist of a mix of algebraic and arithmetic components. Specifically, we could directly combine CompGroth16 with Ξ£-protocol or even CompGroth16 with CompGroth16 just like the logical composition of Ξ£-protocols. From this, we can gain many good properties, such as broader expression, better proverβ€™s efficiency and shorter CRS. In addition, for the combination of CompGroth16 and Ξ£-protocol, we also present two representative application scenarios to demonstrate the practicality of our construction. Β© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {Disjunctive statement; Logical composition; Sigma protocol; Zk-SNARK},
	keywords = {Blockchain; Chromium compounds; Cryptocurrency; Privacy-preserving techniques; Theorem proving; Block-chain; Disjunctive statement; Knowledge protocols; Logical composition; Non-interactive zero-knowledge proofs; Privacy preserving; Sigma protocols; Voting systems; Zero knowledge; Zk-SNARK; Algebra},
	correspondence_address = {Y. Deng; Key Laboratory of Cyberspace Security Defense, Institute of Information Engineering, CAS, Beijing, China; email: deng@iie.ac.cn},
	editor = {Nicomette V. and Benzekri A. and Boulahia-Cuppens N. and Vaidya J.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303207890-2},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
