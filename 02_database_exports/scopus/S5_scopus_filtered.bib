@ARTICLE{Gamboa-Cruzado2026,
	author = {Gamboa-Cruzado, Javier and Pineda-Delacruz, Victor and Salcedo-Mera, Humberto and Alzamora Rivero, Cristina and CoveΓ±as Lalupu, JosΓ© and Narro-Andrade, Manuel},
	title = {Blockchain and Data Management Security for Sustainable Digital Ecosystems: A Systematic Literature Review},
	year = {2026},
