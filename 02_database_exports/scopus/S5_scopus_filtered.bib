	keywords = {Blockchain; Data privacy; Integration; Mapping; Public key cryptography; Quantum computers; Quantum cryptography; Block-chain; Blockchain security; Key distribution; Post quantum cryptography; Post-quantum cryptography; Quantum key; Quantum threat model; Quantum-safe blockchain; Threat modeling; Economic and social effects},
