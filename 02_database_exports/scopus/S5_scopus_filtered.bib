@ARTICLE{Chinh20254807,
	author = {Chinh, Huynh Nguyen and Tam, Huynh Thanh and Doan, Dinh Cong},
	title = {A Blockchain-based Framework for Securing and Auditing Routing Table Updates},
	year = {2025},
	journal = {IAENG International Journal of Computer Science},
	volume = {52},
	number = {12},
	pages = {4807 - 4814},
	url = {https://www.scopus.com/pages/publications/105024062173?origin=resultslist},
	affiliations = {Ho Chi Minh City University of Technology and Education, Viet Nam; Mien Trung University of Civil Engineering, Viet Nam},
	abstract = {Routing stability is crucial for reliable data transmission in enterprise networks. However, the processes of constructing and maintaining routing tables are susceptible to security threats such as unauthorized injections and data tampering, which can lead to service disruption and traffic hijacking. To mitigate these risks, we present a novel blockchain-based framework for securely archiving and verifying the historical updates of routing tables. Our solution leverages the immutability of a blockchain ledger and the decentralized storage capabilities of the InterPlanetary File System (IPFS) to store encrypted routing table data. Essential metadata, including cryptographic hashes, update timestamps, and IPFS links, are immutably recorded on the blockchain, ensuring tamper resistance and transparent auditing. Experimental results confirm that our framework achieves low latency with a total processing time of under 5.5 seconds for a 1024-kilobyte file, and demonstrates a predictable transaction cost of 176,513 gas units regardless of file size. In addition, the framework satisfies core security objectives, including data integrity, confidentiality, anonymity, and access control. This approach provides robust support for network forensics and operational accountability, thereby making a significant contribution to secure and verifiable routing infrastructure management. Β© 2025, International Association of Engineers. All rights reserved.},
	author_keywords = {blockchain; IPFS; router; Routing; security},
	keywords = {Access control; Cryptography; Digital storage; Information management; Network routing; Network security; Routers; Block-chain; Enterprise networks; Filesystem; Interplanetary file system; Reliable data transmission; Routing stability; Routing table; Routings; Security; Table updates; Blockchain},
	correspondence_address = {H.T. Tam; Mien Trung University of Civil Engineering, Viet Nam; email: huynhthanhtam@muce.edu.vn},
	publisher = {International Association of Engineers},
