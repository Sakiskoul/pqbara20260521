	title = {ASTERISK: Space Protocol's quantum-resilient space and air safety framework for trusted operations},
	year = {2025},
	journal = {Proceedings of the International Astronautical Congress, IAC},
	pages = {49 - 62},
	doi = {10.52202/083095-0006},
