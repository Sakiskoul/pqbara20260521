@CONFERENCE{Saroopa2024,
	author = {Saroopa, P. and Poongodi, K. and Saranya, V. and Subaash, S.},
	title = {Securing Drones with Blockchain-Enabled Privacy-Preserving Authentication},
	year = {2024},
	journal = {2024 International Conference on Knowledge Engineering and Communication Systems, ICKECS 2024},
	pages = {},
	doi = {10.1109/ICKECS61492.2024.10616927},
