	keywords = {Computational efficiency; Distributed computer systems; Learning systems; Privacy-preserving techniques; Random processes; Block-chain; Computational overheads; CryptoGraphics; Distributed models; Model training; Probabilistic verification; Probabilistics; Reputation systems; Zero knowledge; Zero-knowledge proofs; Economic and social effects},
