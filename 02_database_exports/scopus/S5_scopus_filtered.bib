	keywords = {Access control; Cybersecurity; Digital storage; eHealth; Electronic health record; Information management; Medical computing; Medical informatics; Network security; Privacy-preserving techniques; Records management; Regulatory compliance; Block-chain; Cyber security; Cyber-defense; Electronic health; Electronic health record; Health care informatics; Health records; Privacy preservation; Proof of work; Proof-of-work; Blockchain},
	correspondence_address = {A. Kaliappan; SRM Institute of Science and Technology, School of Computing, Dept. of Computer Science and Engineering, Tiruchirappalli, Tamilnadu, 621105, India; email: kaliappantpr@gmail.com},
