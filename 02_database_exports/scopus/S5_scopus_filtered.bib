	journal = {3rd International Conference on Emerging Applications of Material Science and Technology, ICEAMST 2025},
	pages = {1013 - 1018},
	doi = {10.1109/ICEAMST67459.2025.11335953},
	url = {https://www.scopus.com/pages/publications/105033694775?origin=resultslist},
	affiliations = {Department of Computer Science, Dr.SNS Rajalakshmi College of Arts and Science (Autonomous), Coimbatore, India; Department of Computer Applications, Dr.SNS Rajalakshmi College of Arts and Science (Autonomous), Coimbatore, India},
	abstract = {Vehicular Ad-hoc Networks (VANETs) serve as the foundation for Intelligent Transportation Systems (ITS) and provide communication between vehicles and infrastructure. However, they are essentially dynamic and distributed, possessing weak security that renders them susceptible to many security threats, including message tampering, packet loss, and insider attacks. The conventional trust model employs a unidimensional metric, resulting in elevated false positive rates, diminished accuracy in attack detection, and inadequate privacy preservation. Consequently, policy-aware systems must be privacy-conscious and reliable. PriMT-Eval (Privacy-preserving) This research introduces a privacy-preserving multi-dimensional trust evaluation framework to improve secure communication in VANETs. Furthermore, the trust model evaluates a vehicle's dependence by taking into account all pertinent factors, including Packet Forwarding Ratio (PFR), Message Integrity Check (MIC), Node Behavior Consistency (NBC), communication protocols (CPs), and response time (RT); additionally, it utilizes token mechanisms among adjacent vehicles. This approach facilitates a lightweight trust exchange employing pseudonym-based cryptographic techniques, supplemented by lightweight homomorphic encryption to safeguard the identities of the vehicles involved in the process. A weighted trust fusion method is utilized, integrating direct and indirect trust values to compute an overall trust value, hence facilitating the accurate identification of malicious nodes. Simulation results demonstrate that PriMT-Eval exhibits superiority with enhancements of up to 9% and 14% in accuracy and false positive rates, respectively, along with higher precision, recall, and F1-score compared to previous trust assessment methodologies. These significant findings indicate that PriMTEval enhances detection capabilities and offers a viable alternative to provide privacy and scalability in the high mobility of VANETs. The forthcoming task is to enhance PriMT-Eval by integrating blockchain for secure, tamper-proof trust storage and implementing federated learning in extensive vehicle deployments. Β© 2025 IEEE.},
	author_keywords = {Malicious Node Detection; Multi-Dimensional Trust; Privacy Preservation; Trust Evaluation; Vehicular Ad-Hoc Networks (VANETs)},
	keywords = {Intelligent systems; Intelligent vehicle highway systems; Network security; Privacy-preserving techniques; Secure communication; Vehicle to vehicle communications; Vehicles; Evaluation models; False positive rates; Malicious node detections; Multi-dimensional trust; Privacy preservation; Privacy preserving; Trust evaluation; Trust models; Vehicular ad-hoc network; Vehicular Adhoc Networks (VANETs); Vehicular ad hoc networks},
