@CONFERENCE{Kobayashi2026,
	author = {Kobayashi, Masashi and Miyaji, Hideaki and Yamamoto, Hiroshi},
	title = {Zero-Knowledge Proof-based Verification Method for Reliable Spatial Information Distribution},
