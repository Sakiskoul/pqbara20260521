@ARTICLE{Yoo202638361,
	author = {Yoo, Soonduck and Kim, Dae-Yeol and Kim, Do-Yup},
	title = {A Procedural Architecture for Agent Trust and Credibility Verification in Distributed Ledger-Based Federated Learning},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {38361 - 38374},
	doi = {10.1109/ACCESS.2026.3671712},
