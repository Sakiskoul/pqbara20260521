	author = {Melhem, Abdullah and Aleroud, Ahmed and Al-Mamun, Abdullah and Ibrahem, Mohamed I.},
	title = {Clustered Federated Learning for Healthcare Analytics: A Dual Blockchain-Functional Encryption Method for Fortified Aggregation},
