@ARTICLE{Devaraj2026,
	author = {Devaraj, Poojitha and Chaman Basha, Syed Abrar and Panarkuzhiyil Santhosh, Nithesh Nair and Panda, Niharika},
	title = {A Post-Quantum Secure Architecture for 6G-Enabled Smart Hospitals: A Multi-Layered Cryptographic Framework},
	year = {2026},
	journal = {Future Internet},
	volume = {18},
	number = {3},
	pages = {},
	doi = {10.3390/fi18030165},
