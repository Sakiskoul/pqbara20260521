	keywords = {Artificial intelligence; Cloud computing; Computer architecture; Privacy-preserving techniques; Quantum cryptography; Search engines; Accountability; Block-chain; Blockchain auditing; Cloud-computing; Explainable AI; Federated architecture; Multi tenants; Multi-tenant cloud computing; Post quantum cryptography; Privacy preserving; Privacy-preserving search; Verifiable keyword encryption; Blockchain},
