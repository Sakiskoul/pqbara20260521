	title = {Toward Vehicular Digital Forensics from Decentralized Trust: An Accountable, Privacy-Preserving, and Secure Realization},
	year = {2022},
	journal = {IEEE Internet of Things Journal},
	volume = {9},
	number = {9},
	pages = {7009 - 7024},
	doi = {10.1109/JIOT.2021.3116957},
