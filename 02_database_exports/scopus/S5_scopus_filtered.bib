	title = {From One Bit to Meaningful Self: Recursive Identity Formation for Decentralized Digital Trust},
	year = {2025},
	journal = {2025 7th International Conference on Blockchain Computing and Applications, BCCA 2025},
	pages = {818 - 824},
	doi = {10.1109/BCCA66705.2025.11229562},
	url = {https://www.scopus.com/pages/publications/105026943084?origin=resultslist},
	affiliations = {University of Ljubljana, Faculty of Computer and Information Science, Ljubljana, Slovenia},
	abstract = {We propose a minimal, physics-inspired model for digital identity in decentralized systems, where the entire identity lifecycle originates from a single bit and recursively grows into higher-level semantic structures. Our framework extends our previous work on recursive lambda-calculus identity functions (Ξ»x.x) and context-sensitive gate selection over finite subgroups of the unitary group U(1), applying it to blockchainbased trust infrastructures. The model treats the evolving identity as the result of interactions between an epistemic potential (context) and a normative potential F (rules or constraints), which together guide the semantic collapse from continuous phase states to discrete symbolic representations. This process is analogous to quantum measurement, where coherence preservation maintains identity and phase transformations encode updates. By mapping these symbolic states onto cryptographic commitments and verifiable credentials, we describe how a blockchain can anchor the evolution of identity from its minimal seed into rich, multi-layered semantic constructs. This recursive growth enables adaptive, privacypreserving, and context-aware digital identities that can operate reliably in decentralized, trustless environments. We further discuss implications for self-sovereign identity (SSI), crossdomain trust interoperability, and resilience in adversarial conditions. The result is a unifying model that connects physical principles, symbolic computation, and decentralized trust mechanisms, offering a foundation for identity systems that evolve coherently from a single bit to complex semantic entities. Β© 2025 IEEE.},
	author_keywords = {artificial intelligence; blockchain; Digital identity; quantum gates; recursion},
	keywords = {Decentralized systems; Differentiation (calculus); Electronic document identification systems; Interoperability; Phase transitions; Quantum theory; Semantics; Trusted computing; Block-chain; Decentralised; Decentralized system; Digital identity; High level semantics; Identity formation; Quantum gates; Recursions; Semantic structures; Single-bit; Artificial intelligence; Blockchain},
	correspondence_address = {V. Stankovski; University of Ljubljana, Faculty of Computer and Information Science, Ljubljana, Slovenia; email: vlado.stankovski@fri.uni-lj.si},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
