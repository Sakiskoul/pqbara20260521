@CONFERENCE{Upadhyaya2025,
	author = {Upadhyaya, Dhruti and Neha, J.C. and Venugopal, K.},
	title = {Beyond Signature Validity: Behavioral Fingerprinting for Fake Device Detection in Post-Quantum IoT Networks},
	year = {2025},
	journal = {2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions, CSITSS 2025},
	pages = {},
	doi = {10.1109/CSITSS67709.2025.11294276},
	url = {https://www.scopus.com/pages/publications/105031398467?origin=resultslist},
	affiliations = {R. V. College of Engineering, Department of ECE, India; R. V. College of Engineering, Department of Mathematics, India},
	abstract = {Traditional cryptographic techniques, including emerging post-quantum algorithms, focus primarily on ensuring message integrity and authenticity in Internet of Things (IoT) deployments. However, these approaches overlook whether the device generating valid signatures is itself genuine or compromised. In scenarios where attackers can clone devices or capture private keys, valid signatures become insufficient indicators of trust. This paper introduces a comprehensive framework that combines post-quantum-style signature emulation with behav-ioral fingerprinting to detect fake or spoofed IoT devices. We simulate a network of ten devices where one adversarial node continually broadcasts repetitive, low-entropy sensor readings. By extracting behavioral metrics such as the proportion of repeated messages, the randomness of message content, and the variability in message timing, and applying an unsupervised anomaly detection model (Isolation Forest), we achieve perfect detection of the spoofed device and maintain a low rate of false positives. To strengthen auditability, we integrate a blockchain-inspired, hash-linked logging mechanism that records each verified interaction. Our results demonstrate that layering behavioral analysis onto cryptographic verification significantly enhances device-level trust in IoT networks.  Β© 2025 IEEE.},
