	keywords = {Anomaly detection; Authentication; Blockchain; Fake detection; Network security; Palmprint recognition; Quantum cryptography; Anomaly detection; Behavioral fingerprinting; Block-chain; Blockchain logging; Cryptographic techniques; Device authentications; Post quantum; Post quantum cryptography; Quantum algorithms; Signature validity; Internet of things},
