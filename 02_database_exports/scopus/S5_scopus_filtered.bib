	author = {Paulin, Dylan and Hennebert, Christine and Franco-Rondisson, Thibault and Jayles, Romain and Loubier, Thomas and Collado, RaphaΓ«l},
	title = {HistoTrust: Ethereum-Based Attestation ofΒ aΒ Data History Built withΒ OP-TEE andΒ TPM},
