	title = {Immutable Audit of EV Charging Sessions Using Blockchain and IPFS},
	year = {2025},
	journal = {2025 6th International Conference on Communications, Information, Electronic and Energy Systems, CIEES 2025 - Conference Proceedings},
	pages = {},
	doi = {10.1109/CIEES66347.2025.11300081},
	url = {https://www.scopus.com/pages/publications/105032387236?origin=resultslist},
	affiliations = {University of Tetova, Faculty of Natural Sciences and Mathematics, Tetovo, North Macedonia; American University of Europe - Fon, Faculty of Informatics, Skopje, North Macedonia; University of Skopje, Faculty of Economics, Skopje, North Macedonia; Tarmac Llc, Tetovo, North Macedonia; Ss. Cyril and Methodius University, Faculty of Electrical Engineering and Informations Technologies, Skopje, North Macedonia},
	abstract = {As electric vehicles (EVs) become more prevalent, ensuring secure and transparent tracking of their charging activities has emerged as a critical challenge. Traditional centralized methods are vulnerable to data integrity issues and lack resilience, raising concerns about trustworthiness. This work presents a blockchain-enhanced architecture for auditing EV charging sessions. It offloads Charging Data Records (CDRs) to the InterPlanetary File System (IPFS), while preserving their integrity through cryptographic anchors recorded on an Ethereum-compatible smart contract. This approach strikes a balance between decentralization and system performance. A prototype was developed featuring OCPP-based session simulation and automated verification via smart contracts. Experimental evaluation across thousands of test cases confirmed the system's ability to detect data tampering with minimal processing overhead, especially when integrated with Layer-2 scaling technologies. These results demonstrate the framework's potential to improve transparency and trust in EV charging networks. Β© 2025 IEEE.},
	author_keywords = {blockchain; EV charging; IPFS; OCPP; smart contracts},
	keywords = {Charging (batteries); Data integrity; Internet protocols; Smart contract; Block-chain; Centralised; Charging Data Records; Critical challenges; CryptoGraphics; Data integrity; Electric vehicle charging; Filesystem; Interplanetary file system; OCPP; Blockchain},
	correspondence_address = {N. Sejfuli-Ramadani; University of Tetova, Faculty of Natural Sciences and Mathematics, Tetovo, North Macedonia; email: nexhibe.sejfuli@unite.edu.mk},
