@ARTICLE{Shrivastava2024,
	author = {Shrivastava, Pranav and Alam, Bashir and Alam, Mansaf},
	title = {Blockchain assisted blind signature algorithm with data integrity verification scheme},
	year = {2024},
	journal = {Concurrency and Computation: Practice and Experience},
	volume = {36},
	number = {13},
	pages = {},
	doi = {10.1002/cpe.8071},
	url = {https://www.scopus.com/pages/publications/85187119773?origin=resultslist},
	affiliations = {Department of Computer Engineering, Jamia Millia Islamia, Delhi, India},
	abstract = {As the demand for cloud storage systems increases, ensuring the security and integrity of cloud data becomes a challenge. Data uploaded to cloud systems are vulnerable to numerous sorts of assaults, which must be handled appropriately to avoid data tampering issues. In addition, quantum computers are expected to be introduced soon, which may face multiple security issues by destroying all traditional cryptosystems. This work introduces a quantum-resistant blockchain centered data integrity verification system with the use of several techniques. Initially, the keys and signatures are generated by the users with the help of the lattice-based blind signature algorithm (L_BSA), which is a combination of lattice cryptography and a blind signature algorithm. From the generated random keys, the most optimal key is then selected by the Puzzle Optimization Algorithm (POA), which is then made available to the encryption phase. Then, the upgraded Merkle tree-assisted vacuum filter (Vac-UMT) algorithm is executed to accomplish the encryption task. Then the data are converted into blocks using blockchain technology and uploaded to the cloud. When receiving the audit requests, the verification process is carried out, and the evidence report is generated for the users. The proposed work is simulated in JAVA and assessed with the UNSW-NB15 dataset, and the outcomes demonstrated that the system is highly efficient and secure. Β© 2024 John Wiley & Sons Ltd.},
	author_keywords = {blind signature algorithm; blockchain; data integrity verification; evidence generation; lattice cryptography; puzzle optimization algorithm; upgraded Merkle tree; vacuum filter},
	keywords = {Blockchain; Cloud storage; Computer software; Network security; Quantum computers; Trees (mathematics); Blind signature algorithm; Blind signatures; Block-chain; Data integrity; Data integrity verification; Evidence generation; Integrity verifications; Lattice cryptography; Merkle trees; Optimization algorithms; Puzzle optimization algorithm; Signature algorithms; Upgraded merkle tree; Vacuum filters; Cryptography},
	correspondence_address = {P. Shrivastava; Department of Computer Engineering, Jamia Millia Islamia, New Delhi, Delhi, 110025, India; email: pranav.paddy@gmail.com},
	publisher = {John Wiley and Sons Ltd},
	issn = {15320626},
	coden = {CCPEB},
