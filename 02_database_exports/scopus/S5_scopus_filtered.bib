	title = {Blockchain-driven privacy-preservation of healthcare insurance data using improved ECC based encryption and deep learning based key tuning},
	year = {2025},
	journal = {Knowledge-Based Systems},
	volume = {327},
	pages = {},
	doi = {10.1016/j.knosys.2025.114078},
	url = {https://www.scopus.com/pages/publications/105012019211?origin=resultslist},
	affiliations = {Department of Computer Science and Engineering, Sri Venkateswara College of Engineering, Tamil Nadu, Pennalur-Sriperumbudur, 602 117, India; Department of Electronics and Communication Engineering, Sri Venkateswara College of Engineering, Tamil Nadu, Pennalur-Sriperumbudur, 602 117, India},
	abstract = {In the digital age, safeguarding the confidentiality and integrity of health insurance data is crucial, especially when considering blockchain technology. Although blockchain technology provides cryptographic protection, maintaining the privacy of private medical data is still quite difficult. In response, the Blockchain-driven Policy Preservation of Healthcare Insurance data via Multi-Head Attention SqueezeNet Model (BPPHIM) is a unique framework that is proposed in this research. The three main phases of the BPPHIM system are proxy, data storage, and data encryption. Data from the Data Owner (DO) is first encrypted using an Improved ECC technique aided by optimization and DL approach. Data partitioning using a K-means clustering technique is the first step in the encryption process. The partitioned data has optimal keys produced by a Self-Improving Coati Optimization Algorithm (SI-COA) and adjusted using the Multi-Head Attention SqueezeNet (M-HAS) model. The customized keys are then safely saved in the Blockchain after being encrypted using the Improved ECC method. The Proxy, a key management and distribution entity, receives the tuned keys at the same time. It uses a Modified Chaotic Map (MCM) to encrypt the keys and keeps itself updated. Encrypted data is obtained from the Block Chain Center (BCC) upon the Data User's authorized request. The original sensitive healthcare data is then obtained by the DU using the encrypted tuned keys to decrypt the data. Thus, the proposed framework offers enhanced data security through advanced encryption techniques and efficient key management, guaranteeing the protection of health insurance data privacy. By integrating blockchain, it ensures decentralized and tamper-proof storage. The use of deep learning models optimizes key generation, improving encryption efficiency. Additionally, the system enables secure and controlled access to sensitive healthcare data, enhancing privacy and accessibility. Β© 2025},
	author_keywords = {Blockchain-driven policy preservation; Modified chaotic map and improved elliptic curve cryptography; Multi-head attention SqueezeNet; Self-improving coati optimization algorithm},
	keywords = {Blockchain; Deep learning; Digital storage; Health care; Health insurance; Information management; K-means clustering; Learning systems; Medical computing; Optimization; Privacy-preserving techniques; Public key cryptography; Sensitive data; Block-chain; Blockchain-driven policy preservation; Chaotic map; Curve cryptography; Elliptic curve; Health-care insurance; Modified chaotic map and improved elliptic curve cryptography; Multi-head attention squeezenet; Optimization algorithms; Self-improving coati optimization algorithm; Curve fitting},
	correspondence_address = {J. Buvana; Department of Computer Science and Engineering, Sri Venkateswara College of Engineering, Pennalur-Sriperumbudur, Tamil Nadu, 602 117, India; email: buvana@svce.ac.in},
