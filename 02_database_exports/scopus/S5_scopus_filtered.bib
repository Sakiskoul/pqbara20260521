@CONFERENCE{Ahmad Sharawardi2025867,
	author = {Ahmad Sharawardi, Nur Shidah and Liew, Siaw-Hong and Turumugon, Punitha and Subramaniam, Angkay},
	title = {Review of Deepfake Detection Techniques and Challenges},
	year = {2025},
	journal = {Proceedings of the 2025 IEEE International Conference on Computation, Big-Data and Engineering, ICCBE 2025},
	pages = {867 - 872},
