@BOOK{Channi2024153,
	author = {Channi, Harpreet Kaur and Kumar, Pulkit},
	title = {Automating and Streamlining Drug Payments Through Smart Contracts},
	year = {2024},
	journal = {Blockchain-Enabled Solutions for the Pharmaceutical Industry},
	pages = {153 - 173},
	doi = {10.1002/9781394287970.ch8},
	url = {https://www.scopus.com/pages/publications/85215249124?origin=resultslist},
	affiliations = {Department of Electrical Engineering, Chandigarh University, Gharuan, Mohali, India},
	abstract = {In the healthcare industry, the payment process for drugs often encounters inefficiencies, delays, and mistakes because of the participation of several middlemen, manual reconciliation procedures, and separate systems. This abstract proposes a way to tackle these difficulties by using smart contracts, harnessing the power of blockchain technology. Smart contracts provide an automated and transparent system for carrying out and enforcing agreements between parties, eliminating the need for middlemen. By incorporating smart contracts into the medicine payment process, several advantages are achieved. To begin with, the implementation of automated payment processes simplifies the whole process, lessening the administrative workload and mitigating the possibility of mistakes or delays. Smart contracts enable instantaneous verification of transactions, guaranteeing timely and precise payments to pharmaceutical suppliers. Moreover, smart contracts improve openness and accountability in pharmaceutical payments. Every transaction recorded on the blockchain is unchangeable and easily visible, creating an indisputable record of payment activity. This level of openness promotes confidence amongst all parties involved and reduces the risk of fraudulent behaviour. Furthermore, smart contracts provide conditional payments that are contingent upon predetermined conditions, such as the receipt of pharmaceuticals or compliance with quality benchmarks. By using programmable logic, payments are automatically initiated if certain requirements are met, reducing the need for human involvement and facilitating efficient dispute-resolution methods. Moreover, the use of blockchain technology guarantees the preservation of data integrity and enhances security throughout the payment procedure. Smart contracts use cryptographic algorithms and decentralised consensus procedures to protect sensitive payment information from unauthorised access or alteration. Ultimately, integrating smart contracts into medicine payments presents an innovative remedy for optimising and mechanising payment processes within the healthcare industry. Through the use of blockchain technology, those involved in the medication payment process may achieve notable improvements in efficiency, transparency, and security. This, in turn, leads to better patient outcomes and a strengthened sense of confidence within the healthcare system. Β© 2025 Scrivener Publishing LLC.},
	author_keywords = {Artificial intelligence; Automation; Drug; Healthcare; Smart contracts},
