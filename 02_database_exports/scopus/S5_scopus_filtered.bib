	year = {2026},
	journal = {Transforming Global Healthcare: The Role of AI and IoT in Modern Medical Systems},
	pages = {292 - 303},
	doi = {10.1201/9781003635215-15},
	url = {https://www.scopus.com/pages/publications/105026517571?origin=resultslist},
	affiliations = {Department of Computational Sciences, Brainware University, Barasat, 700125, India; Department of Computer Science Engineering, Brainware University, Barasat, 700125, India; IEEE, NC, United States},
	abstract = {The advent of Healthcare 5.0 has transformed clinical decision-making by harnessing advanced data visualization and analytics, yet it has also widened the cybersecurity threat landscape, putting sensitive patient data and critical systems at risk. While early research identified vulnerabilities in digital healthcare systems and IoT-based patient monitoring, subsequent technological advances have not fully addressed several persistent challenges. Robust encryption and blockchain methods, although secure, tend to increase latency and diminish system usability, and AI-based anomaly detection, despite its high accuracy, remains susceptible to adversarial manipulation. Additionally, issues related to scalability and the absence of standardized cybersecurity protocols further complicate the secure deployment of these technologies in healthcare environments. We have proposed an integrated cybersecurity framework that combines lightweight cryptographic protocols, AI-driven anomaly detection, and blockchain-based audit trails, while also incorporating emerging approaches such as federated learning and quantum- safe cryptography. Our objective is to validate the proposed framework through comprehensive simulation experiments using realistic healthcare datasets. These simulations are designed to demonstrate that it is possible to achieve robust security with minimal latency overhead while maintaining high usability. Ultimately, this study aims to provide new insights by addressing multiple overlooked aspects of previous research, offering a roadmap for future studies and recommendations for developing scalable, standardized cybersecurity protocols tailored to the evolving needs of Healthcare 5.0. Β© 2026 Anindya Nag, Md. Mehedi Hassan, Riya Sil and Asif Karim.},
	keywords = {Advanced Analytics; Anomaly detection; Artificial intelligence; Cryptography; Cybersecurity; Data visualization; Decision making; Health care; Medical computing; Network security; Patient monitoring; Usability engineering; Anomaly detection; Block-chain; Clinical decision making; Critical systems; Cyber security; Data systems; Healthcare systems; Patient data; Security technology; Technological advances; Blockchain},
