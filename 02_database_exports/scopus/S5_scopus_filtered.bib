@CONFERENCE{Ding2025760,
	author = {Ding, Rui and Xu, Shoujue and Wu, Liyan},
	title = {Cryptographically Enforced Cross-Border Data Governance Through Transmission Attestation Verification Coupling},
	year = {2025},
	journal = {2025 10th International Conference on Signal and Image Processing, ICSIP 2025},
	pages = {760 - 766},
