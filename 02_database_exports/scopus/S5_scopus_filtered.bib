@CONFERENCE{Renuka2025,
	author = {Renuka, Golla Bala and Gnanavel, S.},
	title = {Leveraging Block Chain for Scalable and Transparent Cloud Security},
	year = {2025},
	journal = {2025 2nd International Conference on Computing and Data Science, ICCDS 2025},
