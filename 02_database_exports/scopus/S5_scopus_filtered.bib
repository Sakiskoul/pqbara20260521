	keywords = {Authentication; Chains; Computer architecture; Cost effectiveness; Interoperability; Privacy-preserving techniques; Block-chain; Cross-chain bridge; CryptoGraphics; Decentralised; Digital identity; Performance; Privacy preserving; Protocol state; Unified system; Zero-knowledge proofs; Electronic document identification systems},
