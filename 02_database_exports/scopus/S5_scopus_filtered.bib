@CONFERENCE{Tran2025274,
	author = {Tran, Tuan-Dung and Le, Quoc-Khoi and Do, Uyen and Pham, Van-Hau},
	title = {Mitigating HTLC Griefing Attacks with Commitment Bonds: A Game-Theoretic and Empirical Analysis},
	year = {2025},
	journal = {Proceedings - 2025 RIVF International Conference on Computing and Communication Technologies, RIVF 2025},
	pages = {274 - 279},
	doi = {10.1109/RIVF68649.2025.11365154},
	url = {https://www.scopus.com/pages/publications/105034472782?origin=resultslist},
	affiliations = {University of Information Technology, Ho Chi Minh City, Viet Nam; Vietnam National University, Ho Chi Minh City, Viet Nam},
	abstract = {Hashed Timelock Contracts (HTLCs) underpin atomic swaps and payment channel networks by combining a hashlock with a timelock, yet their economic soundness remains fragile under rational adversarial behavior. We analyze the griefing attack, in which an adversary withholds the preimage until expiry to immobilize an honest counterparty's liquidity at negligible cost, thereby imposing material opportunity loss without risking principal. To formalize this asymmetry, we develop a game-theoretic model together with a Python-based, discrete-time simulation framework that quantifies both the attacker's cost and the victim's lock duration under realistic protocol timelines. Building on this foundation, we propose the Commitment Bond HTLC (CB-HTLC), a lightweight mitigation that requires the initiator to post a small, non-refundable bond prior to lock creation. This bond introduces an unavoidable, upfront cost that converts strategic delay into a strictly loss-making action, restoring incentive alignment for rational participants. Empirical evaluation demonstrates that, whereas the classic HTLC permits zero-cost griefing with full-duration liquidity lock, CB-HTLC reshapes the payoff landscape: the attacker's inaction becomes economically irrational while atomicity and liveness for honest participants remain intact. Crucially, the mechanism is lightweight, protocol-agnostic, and immediately deployable, offering a rare example of a security enhancement that is both effective and practical without disruptive network-wide upgrades. Our contri-butions-formalization of griefing as a strategic game, development of an open simulation tool, and empirical evidence that commitment bonds realign incentives-advance HTLC-based systems toward genuine economic robustness rather than cryptographic sufficiency alone. Β© 2025 IEEE.},
	author_keywords = {Atomic Swaps; Blockchain Economics; Commitment Bond; Cross-chain Interoperability; Game Theory; Griefing Attack; Hashed Timelock Contract; Lightning Network; Payment Channel Security},
	keywords = {Blockchain; Computer crime; Computer games; Costs; Cryptography; Economic analysis; Electronic money; Internet protocols; Interoperability; Locks (fasteners); Network security; Atomic swap; Block-chain; Blockchain economic; Channel securities; Commitment bond; Cross-chain interoperability; Griefing attack; Hashed timelock contract; Lightning network; Payment channel security; Game theory},
	editor = {Bao V.N.Q. and Nguyen H.T. and Hai H.T. and Khang K.T. and Tu N.H. and Thanh T.T.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157790-2},
	language = {English},
	abbrev_source_title = {Proc. - RIVF Int. Conf. Comput. Commun. Technol., RIVF},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Tosh2017458,
	author = {Tosh, Deepak K. and Shetty, Sachin and Liang, Xueping and Kamhoua, Charles A. and Kwiat, Kevin A. and Njilla, Laurent},
	title = {Security Implications of Blockchain Cloud with Analysis of Block Withholding Attack},
	year = {2017},
	journal = {Proceedings - 2017 17th IEEE/ACM International Symposium on Cluster, Cloud and Grid Computing, CCGRID 2017},
	pages = {458 - 467},
	doi = {10.1109/CCGRID.2017.111},
	url = {https://www.scopus.com/pages/publications/85023742198?origin=resultslist},
	affiliations = {Department of Computer Science, Norfolk State University, Norfolk, VA, United States; Virginia Modeling Analysis and Simulation Center, Old Dominion University, Norfolk, VA, United States; College of Engineering, Tennessee State University, Nashville, TN, United States; Cyber Assurance Branch, Air Force Research Laboratory, Rome, NY, United States},
	abstract = {The blockchain technology has emerged as an attractive solution to address performance and security issues in distributed systems. Blockchain's public and distributed peer-To-peer ledger capability benefits cloud computing services which require functions such as, assured data provenance, auditing, management of digital assets, and distributed consensus. Blockchain's underlying consensus mechanism allows to build a tamper-proof environment, where transactions on any digital assets are verified by set of authentic participants or miners. With use of strong cryptographic methods, blocks of transactions are chained together to enable immutability on the records. However, achieving consensus demands computational power from the miners in exchange of handsome reward. Therefore, greedy miners always try to exploit the system by augmenting their mining power. In this paper, we first discuss blockchain's capability in providing assured data provenance in cloud and present vulnerabilities in blockchain cloud. We model the block withholding (BWH) attack in a blockchain cloud considering distinct pool reward mechanisms. BWH attack provides rogue miner ample resources in the blockchain cloud for disrupting honest miners' mining efforts, which was verified through simulations. Β© 2017 IEEE.},
	author_keywords = {Block mining; Block withholding; Blockchain; Blockchain security and vulnerability; Cloud computing; Data provenance; Distributed ledger; Pool mining; Proof-of-work},
	keywords = {Cloud computing; Cluster computing; Grid computing; Miners; Network security; Block withholding; Block-chain; Data provenance; Distributed ledger; Proof of work; Distributed computer systems},
