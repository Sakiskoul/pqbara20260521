@CONFERENCE{Reddy2025,
	author = {Reddy, C. Lakshminatha and Malathi, K.},
	title = {A Robust Defense Mechanism Design for Side-Channel Attacks Cover Cloud E-Health Environments},
	year = {2025},
	journal = {Proceedings ICECONF 2025 - 2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering},
	pages = {},
	doi = {10.1109/ICECONF65644.2025.11379579},
	url = {https://www.scopus.com/pages/publications/105034742457?origin=resultslist},
	affiliations = {Saveetha School of Engineering, Saveetha Institute of Medical and Technical Sciences, Department of Cse, Chennai, India},
	abstract = {Cloud-based e-Health systems have transformed modern healthcare by offering scalable access to electronic health records (EHR), medical imaging, and remote diagnostics. These systems are however becoming more susceptible to side-channel attacks, which are based on micro architectural leakages including cache timing, memory access patterns and electromagnetic emanations. Conventional cryptographic protection and access control systems do not have the capacity to ward off these covert data exfiltration channels. This research proposes an effective multi-layered defense system that is specifically designed to curb the threats posed by side-channels in cloud-based healthcare systems. The proposed system will combine dynamic runtime obfuscation, deep learning-based anomaly detection and blockchain-based audit trails with federated learning of adaptive response to threats. A hybrid LSTM-CNN autoencoder is used to make predictions on normal system behavior using side-channel telemetry allowing the identification of subtle deviations with a high sensitivity. Obfuscation mechanisms like cache flushing, noise inj ection and randomized scheduling are activated when they are identified, to tamper with attack vectors on-the-fly. Lightweight blockchain records all security events in a way that enables forensic traceability, and federated learning ascertains that defense models are developed without centralizing the sensitive data. The framework proves to be effective in an experimental setting of simulated e-health cloud environment. The system proposed has a detection accuracy of 97.66, which is higher than base formulations of CNN, LSTM, and classical classifiers. The design is operationally efficient and has low overhead resources. These results lay the groundwork of proving the feasibility of AI-based, privacy-sensitive security architectures in the future e-health ecosystems. The framework has a potential in its implementation in telemedicine, PACS, and real-time applications of clinical-monitoring with the help of IoT. Β© 2025 IEEE.},
	author_keywords = {anomaly detection; blockchain audit; cache timing; cloud e-health; EM leakage; federated learning; LSTM-CNN autoencoder; MIMIC-III; side-channel attacks; telemedicine security},
	keywords = {Anomaly detection; Blockchain; Cache memory; Data obfuscation; Diagnosis; eHealth; Learning systems; Long short-term memory; Medical computing; Memory architecture; Network security; Sensitive data; Telemedicine; Telemetering; Anomaly detection; Auto encoders; Block-chain; Blockchain audit; Cache timing; Cloud e-health; E health; Ehealth; EM leakage; LSTM-CNN autoencoder; MIMIC-III; Side-channel attacks; Telemedicine security; Side channel attack},
