	year = {2026},
	journal = {Computer Networks},
	volume = {282},
	pages = {},
	doi = {10.1016/j.comnet.2026.112243},
	url = {https://www.scopus.com/pages/publications/105034745005?origin=resultslist},
	affiliations = {School of Software, Yunnan University, Yunnan, Kunming, 650500, China; Yunnan information technology security evaluation center, Yunnan, Kunming, 650001, China; School of Information, Yunnan University of Finance and Economics, Yunnan, Kunming, 650221, China},
	abstract = {In this study, we propose TEBP-UAVs, a hybrid authentication protocol that delivers lightweight intra-domain efficiency and robust cross-domain trust. The design couples simple local cryptographic primitives with a decentralized, federated blockchain to manage cross-domain credentials and revocation. For intra-domain operations, TEBP-UAVs relies solely on bitwise exclusive OR (XOR) and one-way hash functions, minimizing computation on resource-constrained UAVs. For cross-domain access, we introduce an on-chain authentication workflow that eliminates a single point of failure, provides auditable trust establishment, and lowers overall computational and communication costs. Security is validated under the Real-or-Random (ROR) model and through an informal analysis, demonstrating resistance to replay, impersonation, and man-in-the-middle attacks. We implement and evaluate TEBP-UAVs, showing that it ensures security while keeping communication overhead and runtime low. Compared with typical baselines, TEBP-UAVs reduces intra-domain mutual authentication computation time to 3.1121 ms (22.6% and 58.1% lower respectively), while for cross-domain operations, it achieves 24.0%-55.0% CPU time improvement and supports decentralized authorization by leveraging blockchain to lower total verification latency by approximately 13%. The protocol fits heterogeneous UAV deployments and dynamic air-ground networks where devices frequently roam across administrative boundaries. Overall, TEBP-UAVs offers a practical path to secure, low-latency authentication in complex UAV environments, combining minimal local costs with decentralized, verifiable cross-domain trust. Our architecture separates fast local admission from slower inter-domain federation, enabling real-time missions as trust synchronizes. Tests on hardware and simulated links show stable throughput under mobility. Β© 2026 Elsevier B.V.},
	author_keywords = {Authentication protocol; Blockchain; Cross-domain; Digital signature; UAVs},
	keywords = {Authentication; Authentication Protocol; Cryptography; Electronic document identification systems; Internet protocols; Network architecture; Network security; Unmanned aerial vehicles (UAV); Authentication protocols; Block-chain; Cross-domain; Cross-domain authentication; Cryptographic primitives; Decentralised; Exclusive-OR; Intra-domain; One-way Hash function; Simple++; Blockchain},
