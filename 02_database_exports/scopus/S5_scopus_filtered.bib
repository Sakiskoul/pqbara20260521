	issn = {18688969},
	isbn = {978-395977413-0},
	language = {English},
	abbrev_source_title = {Leibniz Int. Proc. Informatics, LIPIcs},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

