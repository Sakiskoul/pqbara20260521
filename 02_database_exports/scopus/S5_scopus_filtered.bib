@ARTICLE{Ciampi2022428,
	author = {Ciampi, Michele and Ishaq, Muhammad and Magdon-Ismail, Malik and Ostrovsky, Rafail and Zikas, Vassilis},
	title = {FairMM: A Fast andΒ Frontrunning-Resistant Crypto Market-Maker},
	year = {2022},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {13301 LNCS},
	pages = {428 - 446},
	doi = {10.1007/978-3-031-07689-3_31},
	url = {https://www.scopus.com/pages/publications/85134157290?origin=resultslist},
	affiliations = {The University of Edinburgh, Edinburgh, United Kingdom; Purdue University, West Lafayette, United States; Rensselaer Polytechnic Institute (RPI), Troy, United States; University of California, Los Angeles (UCLA), Los Angeles, United States},
	abstract = {Frontrunning is a major problem in DeFi applications, such as blockchain-based exchanges. Albeit, existing solutions are not practical and/or they make external trust assumptions. In this work we propose a market-maker-based crypto-token exchange, which is both more efficient than existing solutions and offers provable resistance to frontrunning attack. Our approach combines in a clever way a game theoretic analysis of market-makers with new cryptography and blockchain tools to defend against all three ways by which an exchange might front-run, i.e., (1) reorder trade requests, (2) adaptively drop trade requests, and (3) adaptively insert (its own) trade requests. Concretely, we propose novel light-weight cryptographic tools and smart-contract-enforced incentives to eliminate reordering attacks and ensure that dropping requests have to be oblivious (uninformed) of the actual trade. We then prove that with these attacks eliminated, a so-called monopolistic market-maker has no longer incentives to add or drop trades. We have implemented and benchmarked our exchange and provide concrete evidence of its advantages over existing solutions. Β© 2022, Springer Nature Switzerland AG.},
	author_keywords = {Blockchain; Fairness; Front-running; Market maker},
	keywords = {Commerce; Cryptography; Drops; Game theory; Block-chain; CryptoGraphics; Fairness; Front runnings; Game theoretic analysis; Light weight; Market-maker; Monopolistic markets; Trust assumptions; Blockchain},
