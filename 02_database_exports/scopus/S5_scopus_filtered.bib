@CONFERENCE{Uslu2024,
	author = {Uslu, Erkan and Yayla, Oguz},
	title = {Dilithium-Based Verifiable Timed Signature Scheme},
	year = {2024},
	journal = {2024 17th International Conference on Security of Information and Networks, SIN 2024},
	pages = {},
	doi = {10.1109/SIN63213.2024.10871762},
	url = {https://www.scopus.com/pages/publications/86000015737?origin=resultslist},
	affiliations = {Aselsan Inc., Turkey; Institute of Applied Mathematics, Middle East Technical University, Ankara, Turkey},
	abstract = {Verifiable Timed Signatures (VTS) are crypto-graphic constructs that enable obtaining a signature at a specific time in the future and provide evidence that the signature is legitimate. This framework particularly finds utility in applications such as payment channel networks, multiparty signing operations, or multiparty computation, especially within blockchain architectures. Currently, VTS schemes are based on signature algorithms such as BLS signature, Schnorr signature, and ECDSA. These signature algorithms are considered insecure against quantum attacks due to the effect of Shor's Algorithm on the discrete logarithm problem. We present a new VTS scheme called VT-Dilithium based on CRYSTALS-Dilithium Digital Signature Algorithm that has been selected as NIST's quantum-resistant digital signature standard and is considered secure against both classical and quantum attacks. Integrating Dilithium into the VTS scheme is a more challenging problem due to its complex mathematical operations (i.e. polynomial multiplications, rounding operations) and large module param-eters such as polynomials, polynomial vectors, and matrices. This work aims to provide a comprehensive exposition of VT-Dilithium scheme.  Β© 2024 IEEE.},
	author_keywords = {CRYSTALS-Dilithium; Post-Quantum Cryptog-raphy; Threshold Secret Sharing; Verifiable Timed Signatures},
	keywords = {Authentication; Authentication Protocol; Blockchain; Graph theory; Medium access control; Nanocrystallization; Photomapping; Polynomials; Public key cryptography; Quantum electronics; Channel network; CRYSTALS-dilithium; Dilithium; Post quantum; Post-quantum cryptog-raphy; Signature algorithms; Signature Scheme; Specific time; Threshold secret sharing; Verifiable timed signature; Quantum cryptography},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
