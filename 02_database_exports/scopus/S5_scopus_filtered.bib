	pages = {},
	doi = {10.1109/SSITCON66133.2025.11342250},
	url = {https://www.scopus.com/pages/publications/105033152025?origin=resultslist},
	affiliations = {Vidyavardhaka College of Engineering, Department of Computer Science and Engineering, Mysuru, India; Nitte Meenakshi Institute of Technology, Nitte (Deemed to be University), Department of Electronics and Communication Engineering, Bengaluru, India; Sreyas Institute of Engineering and Technology, Department of Computer Science and Engineering (AIML), Hyderabad, India; Dhanalakshmi Srinivasan College of Engineering and Technology, Department of Management Studies, Mamallapuram, Chennai, India; Government College for Women, Department of Computer Science and Applictaions, Kolar, India},
	abstract = {With the growing digitalization of healthcare systems, Electronic Health Records (EHRs) have facilitated seamless data exchanges. Nonetheless, they are vulnerable to intrusions, unauthorized access, and system breakdowns, due to their centralized design. Furthermore, privacy, integrity, and availability of patient data are essential issues that must be guaranteed, because health information is increasing in volume and sensitivity. Blockchain offers a decentralized and tamperresistant alternative with secure storage, transparent access control, and auditability. Smart contracts and cryptographic techniques enable fine-grained access to policies and stakeholder trust. However, interoperability, scalability, and off-chain storage difficulties hinder deployment. To address these issues, the MedLedgerChain system combines blockchain, smart contracts, and Inter Planetary File System (IPFS)-based decentralized storage. The proposed MedLedgerChain model includes homomorphic encryption, Zero-Knowledge Proofs, and hybrid optimization algorithm such as optimization using Greylag Goose Optimization (GGO) and Crayfish Optimization (CO) for efficient key management and advanced hybrid encryption standards combining (AES) and Elliptic Curve Cryptography (ECC), to securely process data. A trust-sensitive access control model and Deep Reinforcement Learning (DRL)based shard optimization improve scalability and resilience. MedLedgerChain was tested in fog/edge cloud environments based on encryption/decryption latency, transaction throughput, and access control efficiency. The results showed reduced latency, improved scalability, and secure data sharing, outperforming existing models by achieving encryption time of 3.774 s and decryption time of 3.089 s for key size of 256 bits. Β© 2025 IEEE.},
	author_keywords = {blockchain; cryptographic techniques; decentralized storage; electronic health records; homomorphic encryption; smart contracts; zero-knowledge proofs},
