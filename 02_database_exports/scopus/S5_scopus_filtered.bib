	title = {Redacting Without Regret: A Dual-Layer Framework for Policy-Compliant Blockchains},
	year = {2025},
	journal = {7th Conference on Blockchain Research and Applications for Innovative Networks and Services, BRAINS 2025},
	pages = {},
	doi = {10.1109/BRAINS67003.2025.11302930},
	url = {https://www.scopus.com/pages/publications/105031768512?origin=resultslist},
	affiliations = {IIT Kharagpur, India},
	abstract = {Blockchain's immutability and decentralized consensus make it ideal for secure and auditable data storage. However, these same properties pose major challenges under modern data protection laws, particularly the GDPR's 'Right to be Forgotten', which demand flexible data erasure capabilities. Existing redactable blockchain solutions often rely on centralized authorities or semi-decentralized models, falling short in supporting jurisdiction-aware, reversible redaction in a scalable, auditable, and compliant manner. In this work, we propose a dual-layer redaction framework for permissioned blockchains that enables geolocation-aware, policydriven data redaction while preserving structural and cryptographic integrity. Our architecture introduces two key mechanisms: (1) Local redaction, allowing region-specific suppression of content without altering the global ledger, and (2) Global redaction, enabling universally enforceable erasure when legally mandated. To support evolving regulatory environments, our system also introduces reversible redaction, allowing previously suppressed data to be reinstated when laws change, without reliance on sidechains or off-chain metadata. We formalize this model using an Operation Mapping Table (OMT) and an Active Local Transaction Table (ALT), enabling fine-grained access control and regulatory compliance. We further provide security proofs and auditability guarantees to ensure verifiable redaction integrity. Our work lays the foundation for legally adaptive, auditable blockchain systems deployable in heterogeneous and evolving compliance regimes. Β© 2025 IEEE.},
	author_keywords = {Blockchain; Dual-Layer Redaction; Legal Compliance},
	keywords = {Compliance control; Cryptography; Digital storage; Environmental regulations; Regulatory compliance; Block-chain; Centralised; Data protection laws; Data storage; Decentralized consensus; Dual-layer redaction; Dual-layers; Legal compliance; Property; Right to be forgotten; Blockchain},
