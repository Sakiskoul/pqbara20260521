@ARTICLE{Tawfeeq20251081,
	author = {Tawfeeq, Nabeel Z. and Taha, Dujan B.},
	title = {Blockchain-Based Accountability: A Systematic Literature Review},
	year = {2025},
	journal = {Mesopotamian Journal of CyberSecurity},
