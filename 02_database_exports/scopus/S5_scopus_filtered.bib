@CONFERENCE{Latif2025,
	author = {Latif, Shahid and Djenouri, Djamel and Ahmad, Jawad},
	title = {A Serverless Federated Learning Framework with Blockchain and Homomorphic Encryption},
	year = {2025},
	journal = {2025 IEEE 35th International Telecommunication Networks and Applications Conference, ITNAC 2025},
	pages = {},
	doi = {10.1109/ITNAC66378.2025.11302589},
