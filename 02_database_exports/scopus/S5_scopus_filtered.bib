@ARTICLE{Wang2023337,
	author = {Wang, Weizheng and Huang, Huakun and Yin, Zhimeng and Gadekallu, Thippa Reddy and Alazab, Mamoun and Su, Chunhua},
	title = {Smart contract token-based privacy-preserving access control system for industrial Internet of Things},
	year = {2023},
	journal = {Digital Communications and Networks},
