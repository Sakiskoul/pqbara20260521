	year = {2026},
	journal = {2026 2nd International Conference on Advances in Intelligent Computing and Applications, AICAPS 2026},
	pages = {},
	doi = {10.1109/AICAPS68631.2026.11453153},
	url = {https://www.scopus.com/pages/publications/105036840567?origin=resultslist},
	affiliations = {Kannur University, Mary Matha Arts & Science College Mananthavady, Department of Computer Science, India; NMSM Government College, Department of Mathematics, Kerala, Kalpetta, India; Mahatma Gandhi College, Department of Computer Science, Kerala, Iritty, India},
	abstract = {We propose a new adaptable cryptography strategy for use in blockchain-based Digital Evidence Management Systems. This adaptable strategy will select the best Elliptic Curve Cryptography (ECC) signing method at run-time depending on the context of the evidence being stored. A hybrid framework is developed which includes three different signing techniques - Direct Metadata, Hash-then-Sign, and Selective Field Signatures - guided by a weighted decision making process based upon the four factors of Legal Priority, Verification Frequency, System Load, and Evidence Characteristics. The system was implemented on top of the Hyperledger Fabric platform with support for distributed data storage via IPFS. The testing results were obtained from testing in 36 real-world test scenarios. The testing demonstrated the ability to identify the correct signing method for each scenario at a rate of 100 percent, select the optimal signing method among the available options at a rate of 52.8 percent, and demonstrate an average increase in system performance of 15.4 percent compared to the fixed signing method used as a baseline in the testing - peaking at a gain of 18.7 percent in high verification frequency scenarios. Security was maintained throughout testing on all tested types of evidence. The results of this work indicate that adapting the cryptography used in blockchain-based Digital Evidence Management Systems based upon the context of the evidence provides significant operational benefits while maintaining the integrity of the evidence and may provide a valid foundation for future generations of adaptive Digital Evidence Management Systems.  Β© 2026 IEEE.},
	author_keywords = {Adaptive Cryptography; Blockchain Evidence Management; Context Aware Security; ECC Signature Methods; Hyperledger Fabric; IPFS Integration; Performance Optimization},
