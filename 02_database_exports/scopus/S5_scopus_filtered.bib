	keywords = {Electronic voting; Fault tolerance; Public key cryptography; Scalability; Transparency; Voting machines; Block-chain; Centralized control; Decentralised; Decentralized ledger; Electronic voting; Secure voting system; Tamper-evident; Tamper-evident election; Tamperproof; Voting systems; Blockchain},
