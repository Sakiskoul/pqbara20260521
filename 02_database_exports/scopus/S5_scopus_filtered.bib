	keywords = {Access control; Blockchain; Diagnosis; Internet of things; Privacy-preserving techniques; Block-chain; Consortium blockchain; Internet of thing; Personal health record; Privacy preservation; Security; Security-aware; Security/privacy; Smart contract.; Smart contract},
