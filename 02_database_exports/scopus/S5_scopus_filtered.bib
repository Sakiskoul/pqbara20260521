	keywords = {Blockchain; Entropy; Industry 4.0; Number theory; Quantum cryptography; Quantum theory; Random number generation; Smart contract; Block-chain; Blockchain immutability; Cryptographic integrity; CryptoGraphics; Ethereum smart contract; Event logging; Industrial event logging; Quantum random number generation; Random-number generation; Secure loggings; Ethereum},
	correspondence_address = {B. Prieur; Medialoco LLC, Austin, United States; email: benoit.prieur@protonmail.com},
