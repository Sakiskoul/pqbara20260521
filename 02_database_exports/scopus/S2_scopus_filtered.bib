	pages = {},
	doi = {10.32604/cmc.2025.073883},
	url = {https://www.scopus.com/pages/publications/105029536913?origin=resultslist},
	affiliations = {College of Engineering, Alfaisal University, Riyadh, 11533, Saudi Arabia; School of Computer Science, National College of Business Administration and Economics, Lahore, 54000, Pakistan; Department of Computer Science and Information Technology, School Education Department, Government of Punjab, Layyah, 31200, Pakistan; Faculty of Engineering, Uni de Moncton, Moncton, E1A3E9, NB, Canada; School of Electrical Engineering, University of Johannesburg, Johannesburg, 2006, South Africa; International Institute of Techno. & Management (IITG), Avenue des Grandes Ecoles, Libreville, 1989, Gabon; Bridges for Academic Excellenceβ€”Spectrum, Center-ville, Tunis, 1001, Tunisia},
	abstract = {The advent of quantum computing poses a significant challenge to traditional cryptographic protocols, particularly those used in Secure Multiparty Computation (MPC), a fundamental cryptographic primitive for privacy-preserving computation. Classical MPC relies on cryptographic techniques such as homomorphic encryption, secret sharing, and oblivious transfer, which may become vulnerable in the post-quantum era due to the computational power of quantum adversaries. This study presents a review of 140 peer-reviewed articles published between 2000 and 2025 that used different databases like MDPI, IEEE Explore, Springer, and Elsevier, examining the applications, types, and security issues with the solution of Quantum computing in different fields. This review explores the impact of quantum computing on MPC security, assesses emerging quantum-resistant MPC protocols, and examines hybrid classical-quantum approaches aimed at mitigating quantum threats. We analyze the role of Quantum Key Distribution (QKD), post-quantum cryptography (PQC), and quantum homomorphic encryption in securing multiparty computations. Additionally, we discuss the challenges of scalability, computational efficiency, and practical deployment of quantum-secure MPC frameworks in real-world applications such as privacy-preserving AI, secure blockchain transactions, and confidential data analysis. This review provides insights into the future research directions and open challenges in ensuring secure, scalable, and quantum-resistant multiparty computation. Copyright Β© 2026 The Authors.},
	author_keywords = {blockchain security; federated learning; post-quantum cryptography (PQC); privacy-preserving computation; Quantum computing; quantum cryptography; quantum homomorphic encryption; quantum key distribution (QKD); quantum network security; secure multiparty computation (MPC)},
	keywords = {Blockchain; Computational efficiency; Distributed computer systems; Learning systems; Network security; Privacy-preserving techniques; Quantum computers; Quantum efficiency; Scalability; Block-chain; Blockchain security; Ho-momorphic encryptions; Homomorphic-encryptions; Key distribution; Networks security; Post quantum cryptography; Post-quantum cryptography; Privacy preserving computation; Quantum Computing; Quantum homomorphic encryption; Quantum key; Quantum key distribution; Quantum network; Quantum network security; Secure multi-party computation; Secure multiparty computation; Quantum cryptography},
	correspondence_address = {S. Guizani; College of Engineering, Alfaisal University, Riyadh, 11533, Saudi Arabia; email: sguizani@alfaisal.edu; T. Mazhar; School of Computer Science, National College of Business Administration and Economics, Lahore, 54000, Pakistan; email: tehseenmazhar719@gmail.com},
