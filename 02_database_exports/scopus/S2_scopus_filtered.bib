	title = {Trilemma-resilient blockchain design: Integrating storage proofs, adaptive sharding, and hybrid encoding},
	year = {2026},
	journal = {Computers and Electrical Engineering},
	volume = {134},
	pages = {},
	doi = {10.1016/j.compeleceng.2026.111145},
	url = {https://www.scopus.com/pages/publications/105034362824?origin=resultslist},
	affiliations = {Department of CSE, Ahsanullah University of Science and Technology (AUST), Dhaka, 1208, Bangladesh; Department of CSE, R.P. Shaha University, Narayanganj, 1400, Bangladesh},
	abstract = {The blockchain trilemma β€” balancing scalability, security, and decentralization β€” remains the principal obstacle to Web3 adoption. Existing platforms excel in at most two dimensions: high-throughput chains centralize validation, decentralized storage imposes prohibitive hardware costs, and sharded designs suffer high cross-shard latency. This paper introduces CrustLedger, a holistic architecture that resolves the trilemma through three innovations: (1) storage-backed Proof-of-Capacity consensus replacing energy-intensive mining with verifiable disk-space commitments and reputation-weighted voting, (2) Markov-optimized adaptive sharding that dynamically reconfigures node groupings based on real-time geographic locality and network latency, and (3) hybrid erasureβ€“network coding reducing on-chain storage by 83% versus Bitcoin while guaranteeing 99.99% durability via 5Γ—redundancy. Unlike prior work, CrustLedger addresses real-world deployment challenges: we detail and resolve proof-generation bottlenecks via lazy hashing, audit-latency spikes through pre-fetching, and Sybil attacks via grace-period slashing. The system incorporates post-quantum primitives (Arion hashing, constant-time BLS12-381) and hardware-aware countermeasures. Evaluated on 1024 globally distributed nodes (Intel N5030, 8 GB RAM, 2.5 TB HDD, $160 each), CrustLedger sustains 1480 TPS with 450 ms P95 latency, maintains 94% chain integrity under 40% Byzantine nodes, withstands 20 Gbps DDoS attacks, and keeps geographic concentration below 14% per region. Geographic sensitivity analysis confirms throughput varies by <8% even under clustered or sparse distributions, with data retrieval exceeding 98% under adversarial conditions. By achieving this balance under diverse and realistic conditions, CrustLedger demonstrates that a practical equilibrium among scalability, security, and decentralization is attainable, offering a quantum-ready and economically inclusive foundation for next-generation decentralized applications. Copyright Β© 2026. Published by Elsevier Ltd.},
	author_keywords = {Adaptive sharding; Blockchain trilemma; DDoS-resilient architecture; Decentralized storage networks; Post-quantum cryptography; Proof-of-capacity consensus},
	keywords = {Chains; Denial-of-service attack; Encoding (symbols); Network security; Quantum communication; Quantum cryptography; Random access storage; Scalability; Sensitivity analysis; Throughput; Adaptive sharding; Block-chain; Blockchain trilemma; DDoS-resilient architecture; Decentralisation; Decentralised; Decentralized storage network; Post quantum cryptography; Proof-of-capacity consensus; Storage networks; Blockchain},
	correspondence_address = {S. Reno; Department of CSE, Ahsanullah University of Science and Technology (AUST), Dhaka, 1208, Bangladesh; email: reno.saha39@gmail.com},
	publisher = {Elsevier Ltd},
