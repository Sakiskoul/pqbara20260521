}

@CONFERENCE{Lee20251075,
	author = {Lee, Yujin and Merlec, Mpyana Mwamba and Woo Jung, Jin and Souihi, Sami and In, Hoh Peter},
	title = {PQCIF: Post-Quantum Cryptography Integration Framework for Securing Blockchain-enabled Internet of Medical Things},
	year = {2025},
	journal = {International Conference on ICT Convergence},
	pages = {1075 - 1080},
	doi = {10.1109/ICTC66702.2025.11388883},
	url = {https://www.scopus.com/pages/publications/105035067646?origin=resultslist},
	affiliations = {Korea University, Department of Computer Science and Engineering, Seoul, South Korea; University of Paris-Est Creteil, LISSI-TincNET Research Team, Paris, France},
	abstract = {The convergence of blockchain technology and the Internet of Medical Things (IoMT) significantly enhances data security and interoperability in healthcare systems. However, emerging quantum computing capabilities pose critical threats to conventional cryptographic algorithms underpinning blockchain security. Moreover, as IoMT devices manage sensitive patient data and perform essential healthcare functions, ensuring robust protection against both classical and quantum attacks has become increasingly urgent. To mitigate these risks, this paper introduces a Post-Quantum Cryptography Integration Framework (PQCIF), designed to protect blockchain-enabled IoMT (BIoMT) systems and infrastructures against classical and quantum attacks. PQ-CIF is a hybrid framework leveraging NIST-standardized post-quantum cryptographic (PQC) algorithms combined with conventional public-private key pair cryptography schemes, strategically integrating them within BIoMT architectures for robust long-term security. We provide comprehensive evaluation metrics and present a detailed case study demonstrating the efficacy and minimal overhead of our proposed framework in a simulated healthcare blockchain network. Β© 2025 IEEE.},
	author_keywords = {Blockchain; Blockchain-based Internet of Medical Things (BIoMT); Data Security; Internet of Medical Things (IoMT); Post-Quantum Cryptography; Quantum Computing},
	keywords = {Health care; Medical computing; Network security; Public key cryptography; Quantum computers; Quantum cryptography; Block-chain; Blockchain-based internet of medical thing; Computing capability; Cryptographic algorithms; Healthcare systems; Integration frameworks; Internet of medical thing; Post quantum cryptography; Quantum Computing; Blockchain},
	correspondence_address = {Y. Lee; Korea University, Department of Computer Science and Engineering, Seoul, South Korea; email: yyujin98@korea.ac.kr},
	publisher = {IEEE Computer Society},
	issn = {21621233},
	isbn = {979-833155678-5},
	language = {English},
	abbrev_source_title = {Int. Conf. ICT Convergence},
	type = {Conference paper},
	publication_stage = {Final},
