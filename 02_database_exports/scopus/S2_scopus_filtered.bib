	keywords = {Authentication; Chains; Digital storage; Health care; Information management; Medical computing; Network security; Quantum computers; Quantum cryptography; Quantum theory; Block-chain; Cryptographic methods; CryptoGraphics; Healthcare data; Off-chain storage; On-chain security; Post quantum; Post-quantum cryptograph; Quantum-resistant signature; Security mechanism; Blockchain},
