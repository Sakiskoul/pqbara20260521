	correspondence_address = {E. Toe; UniversitΓ© du QuΓ©bec Γ΅ Chicoutimi, Saguenay, G7H 2B1, Canada; email: elisee.toe1@uqac.ca},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
