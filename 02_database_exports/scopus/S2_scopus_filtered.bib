	title = {Securing Blockchain Data Transactions: A Novel Cryptographic Framework for Enhanced Security and Efficiency},
	year = {2025},
	journal = {International Journal of Performability Engineering},
	volume = {21},
	number = {11},
	pages = {651 - 660},
	doi = {10.23940/ijpe.25.11.p5.651660},
