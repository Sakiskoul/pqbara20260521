@BOOK{Al-Khasawneh202645,
	author = {Al-Khasawneh, Mahmoud Ahmad and Gopal, R. and Mon, Feslin Anish and Muthiah, Deepa Mallika},
	title = {Quantum cybersecurity in IIoT-based power grids},
	year = {2026},
	journal = {Quantum Cryptography and Annealing for Securing Industrial IoT},
	pages = {45 - 59},
	doi = {10.1016/B978-0-443-38349-6.00010-5},
	url = {https://www.scopus.com/pages/publications/105033407549?origin=resultslist},
	affiliations = {Applied Science Research Center, Applied Science Private University, Amman, Jordan; School of Computing, Skyline University College, University City Sharjah, Sharjah, United Arab Emirates; Information and Communication Engineering, College of Engineering, University of Buraimi, Al Buraimi Governorate, Oman; Faculty in Department of Information Technology, University of Technology and Applied Sciences, Sultanate of Oman, Ibri, Oman; Department of Cardiovascular Technology, School of Allied Health Sciences, Galgotias University, Delhi NCR, India},
	abstract = {As the Industrial Internet of Things (IIoT) rapidly develops, it has greatly improved how smart grids operate, connect, and deliver energy. At the same time, more advanced cyber threats can now target critical infrastructure, due to this progress. Conventional information technology (IT) security approaches often encounter difficulties in protecting operational technology (OT) and communication systems in smart grids from ransomware, zero-day exploits, and attacks involving artificial intelligence. To address these weaknesses, this chapter examines using quantum-enhanced cybersecurity frameworks for IIoT-enabled power grids by combining Zero Trust Architecture, postquantum cryptography, and quantum machine learning. A Hybrid Quantum Convolutional Neural Network is presented for real-time anomaly detection, using quantum kernel methods to handle large volumes of OT/IT data. In addition, a quantum-safe blockchain method is introduced to confirm device identity and federated quantum learning is used for sharing cyber threats among grid devices. The framework is confirmed to work better than classical deep learning models in identifying ransomware, false data injection, and adversarial machine learning attacks, as shown by the latest Quantum-IIoT Intrusion Dataset. By using Quantum Key Distribution, lattice-based cryptography, and adaptive reinforcement learning, the method guarantees that the smart grid remains secure and able to recover on its own in the postquantum era. This chapter introduces new methods, studies, and unresolved challenges that help researchers and practitioners deploy quantum-safe cybersecurity for future IIoT power grids. Β© 2026 Elsevier Inc. All rights reserved.},
	author_keywords = {adaptive reinforcement learning; adversarial machine learning; anomaly detection; critical infrastructure security; cybersecurity; false data injection (FDI); federated quantum learning (FQL); Hybrid Quantum Convolutional Neural Network (HQCNN); Industrial Internet of Things; information technology (IT); intrusion detection; lattice-based cryptography; operational technology (OT); postquantum cryptography (PQC); quantum kernel methods; Quantum Key Distribution (QKD); quantum machine learning (QML); quantum-enhanced security; Quantum-IIoT Intrusion Dataset (Q-IIoTID); quantum-safe blockchain; ransomware; smart grids; Zero Trust Architecture (ZTA)},
	keywords = {Blockchain; Computer crime; Critical infrastructures; Cybersecurity; Data communication systems; Electric power transmission networks; Internet of things; Intrusion detection; Machine learning; Network security; Public works; Quantum computers; Quantum cryptography; Smart power grids; Trusted computing; Adaptive reinforcement; Adaptive reinforcement learning; Anomaly detection; Block-chain; Convolutional neural network; Critical infrastructure securities; Cyber security; False data injection; Federated quantum learning; Hybrid quantum convolutional neural network; Industrial internet of thing; Information technology; Intrusion-Detection; Kernel-methods; Key distribution; Lattice-based cryptography; Machine-learning; Operational technologies; Operational technology; Post quantum cryptography; Postquantum cryptography; Quantum kernel method; Quantum key; Quantum key distribution; Quantum learning; Quantum machine learning; Quantum machines; Quantum-enhanced security; Quantum-industrial internet of thing intrusion dataset; Quantum-safe blockchain; Reinforcement learnings; Smart grid; Zero trust architecture; Anomaly detection},
