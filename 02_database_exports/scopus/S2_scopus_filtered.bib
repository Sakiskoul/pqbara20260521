@CONFERENCE{Immanuel2025,
	author = {Immanuel, T.Paul and Kumari, K. Anitha},
	title = {Enhancing Blockchain Security with Multivariate Post-Quantum Digital Signatures},
	year = {2025},
	journal = {2025 International Conference on Intelligent Innovations in Engineering and Technology, ICIIET 2025},
	pages = {},
	doi = {10.1109/ICIIET65921.2025.11377810},
	url = {https://www.scopus.com/pages/publications/105035491423?origin=resultslist},
	affiliations = {Psg College of Technology, Department of Information Technology, TN, Coimbatore, India},
	abstract = {Blockchain technology, recognized for its decentralized, immutable, and transparent characteristics, traditionally relies on elliptic curve cryptography (ECC) to secure digital signatures and ensure transaction integrity. However, the emergence of quantum computing poses a fundamental threat to ECC, as algorithms such as Shor's can efficiently solve the elliptic curve discrete logarithm problem (ECDLP), rendering ECC-based blockchains insecure. This looming vulnerability necessitates the transition to post-quantum cryptographic (PQC) solutions. Among the various PQC families lattice-based, code-based, hash-based, and isogeny-based multivariate cryptography has emerged as the most suitable for digital signatures in blockchain applications, owing to its strong reliance on the hardness of the Multivariate Quadratic (MQ) problem, which remains intractable for both classical and quantum algorithms. Multivariate schemes provide several advantages, including fast signature generation, efficient verification, and scalability, all of which are essential for high-throughput blockchain networks. Within this family, the Unbalanced Oil and Vinegar (UOV) scheme stands out as the most efficient variant. Efficiency analysis shows that UOV achieves a 99.9% smaller private key than SPHINCS+ and 98.9% smaller than Dilithium 5, a 92.3% reduction in signature size compared to Dilithium 5, and a 99.6% lighter runtime memory requirement than GeMSS, enabling practical deployment even on resource-constrained blockchain nodes. Despite its slightly larger public key than Dilithium, UOV remains significantly more balanced than competing schemes, offering the optimal trade-off between quantum security, storage efficiency, and performance. This research explores the integration of multivariate digital signatures into blockchain, with a focus on UOV, to provide a quantum-resistant framework that ensures long-term transaction security, network scalability, and resilience in the post-quantum era.  Β© 2025 IEEE.},
	author_keywords = {Blockchain; Digital Signature; GeMSS; HFE; Multivariant Digital Signature; Post Quantum Cryptography; Rainbow; UOV},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159103-8},
	language = {English},
	abbrev_source_title = {Int. Conf. Intell. Innov. Eng. Technol., ICIIET},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wati202595,
	author = {Wati, Kurnia Mustika and Anwar, Khoirul and Sanjoyo, Danu Dwi},
	title = {A Three-Layers Defense Scheme for Resilient CRYSTALS-Dilithium in Blockchain Security},
	year = {2025},
	journal = {International Conference on Information and Communications Technology, ICOIACT},
	number = {2025},
	pages = {95 - 100},
	doi = {10.1109/ICOIACT67584.2025.11344953},
	url = {https://www.scopus.com/pages/publications/105033356822?origin=resultslist},
	affiliations = {The Center of Excellence Aicoms, Telkom University, Bandung, Indonesia; School of Electrical Engineering, Telkom University, Bandung, Indonesia},
	abstract = {Quantum computing's rapid progress threatens traditional cryptography like Elliptic Curve Digital Signature Algorithm (ECDSA) in blockchains. This paper examines CRYSTALS-Dilithium, a NIST-approved lattice-based signature scheme using Module Learning With Errors (MLWE) and Module Short Integer Solution (MSIS), for quantum-resistant blockchain security. However, Dilithium's complex key structure risks full compromise from partial leaks. We propose a three-layer defense: (1) Threshold Signature Scheme (TSS) distributes s<sub>1</sub> across 20 nodes with threshold t=15 using Multi-Party Computation (MPC) signing to avoid single points of failure; (2) Dynamic Key Rotation (DKR) enables rapid revocation of s<sub>2</sub> upon anomaly detection; (3) Verifiable Timed Signatures (VTS) leverage Timelock Puzzles (TLP) and Non-Interactive Zero-Knowledge Proofs (NIZKP) to impose timed delays, allowing detection of malicious activity. This architecture enhances post-quantum blockchain resilience, scalability, and decentralization while significantly increasing the cost of attacks. In 20-node simulations, baseline architectures fail after 4-5 node compromises, whereas our system endures up to 14, raising attack costs by a factor of 100. The combination of VTS and DKR reduces detection latency by 94.9% (from over 5 minutes to under 30 seconds). The overhead is approximately 2.5 KB per signature plus MPC operations, remaining feasible at 500 TPS for Proof-of-Work (PoW) or 100 TPS for Proof-of-Stake (PoS) systems. Β© 2025 IEEE.},
	author_keywords = {Attack Resilience; Blockchain Security; CRYSTALS-Dilithium; Lattice-Based Cryptography; Post-Quantum Cryptography},
	keywords = {Anomaly detection; Authentication; Computer architecture; Crystals; Network security; Public key cryptography; Quantum computers; Quantum cryptography; Attack resiliences; Block-chain; Blockchain security; CRYSTALS-dilithium; Dilithium; Dynamic keys; Lattice-based cryptography; Multiparty computation; Post quantum cryptography; Three-layer; Blockchain},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {2770467X},
	isbn = {979-833155408-8},
	language = {English},
	abbrev_source_title = {Int. Conf. Inf. Commun. Technol., ICOIACT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

