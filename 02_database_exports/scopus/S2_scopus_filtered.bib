	title = {Hybrid Post-Quantum Cryptography (PQC) for Patient-Centric EHR},
	year = {2025},
	journal = {Proceedings - 2025 8th International Seminar on Research of Information Technology and Intelligent Systems, ISRITI 2025},
	pages = {834 - 840},
	doi = {10.1109/ISRITI68345.2025.11393211},
	url = {https://www.scopus.com/pages/publications/105035721863?origin=resultslist},
	affiliations = {Accounting Information Systems, Universitas Teknologi Digital Indonesia, Yogyakarta, Indonesia; Study Program of Public Health, Universitas Muhammadiyah Surakarta, Surakarta, Indonesia; Dentist Professional Program, Universitas Muhammadiyah Yogyakarta, Yogyakarta, Indonesia; Informatics Study Program, Universitas Teknologi Digital Indonesia, Yogyakarta, Indonesia; Nursing Study Program, Sekolah Tinggi Ilmu Kesehatan Surya Global, Yogyakarta, Indonesia},
	abstract = {Securing Electronic Health Records (EHRs) in cloud and Internet of Medical Things (IoMT) environments requires cryptography that remains resilient against quantum-capable adversaries while preserving patient-centric consent and auditability. This study assesses the feasibility of a Hybrid Post-Quantum Cryptography (PQC) approach for patient-controlled EHR access, focusing on performance, cost, security, and usability. The proposed design integrates TLS 1.3 with hybrid key encapsulation (X25519+ML-KEM-768) and ML-DSA, Fast Healthcare Interoperability Resources (FHIR) R4 off-chain storage, Ethereum Proof-of-Authority smart contracts for grant/revoke operations and on-chain indices, and IPFS for large objects. Synthetic EHR workloads generated by Synthea were tested under realistic network impairments, with handshake latency, end-to-end read/write latency, throughput, revocation latency, and gas units as primary endpoints, and attack resilience and usability scores as secondary endpoints. Results show that Hybrid PQC increases TLS handshake latency by about 25% compared with ECC-only, while maintaining approximately 91% of baseline throughput. Revocation latency averaged 1.84 seconds and consent transactions consumed about 85k gas units, while attacks such as man-in-the-middle, downgrade, and replay were fully prevented under policy. Usability testing indicated acceptable performance with a System Usability Scale score of 78.5. These findings suggest that Hybrid PQC enables quantum-ready, auditable, and patient-centric EHR access with bounded overhead and minimal impact on clinical throughput, while also highlighting the need for multi-site validation and further optimization of PQC performance in healthcare contexts. Β© 2025 IEEE.},
	author_keywords = {Blockchain Auditability; Electronic Health Record; FHIR; Hybrid Post-Quantum Cryptography; Patient-Centric Access Control},
	keywords = {Access control; Blockchain; Chains; eHealth; Electronic document exchange; Electronic health record; Interoperability; Medical computing; Network security; Throughput; Usability engineering; Block-chain; Blockchain auditability; Electronic health; Fast healthcare interoperability resource; Health records; Healthcare Interoperability; Hybrid post-quantum cryptography; Patient-centric access control; Performance costs; Post quantum cryptography; Quantum cryptography},
