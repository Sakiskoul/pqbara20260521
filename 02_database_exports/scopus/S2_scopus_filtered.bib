	affiliations = {SRM Institute of Science and Technology Delhi-NCR Campus, Faculty of Engineering and Technology, Department of Computer Science & Engineering, Uttar Pradesh, Ghaziabad, India},
	abstract = {Blockchain technology has recently appeared as a new paradigm to provide IoT networks with security, scalability, and decentralization. But combining Blockchain with constrained IoT devices provides the following challenges: computational complexity, latency, and energy costs. This survey paper reviews recent work (2020-2024) on Blockchain-based IoT systems focusing on low-cost (PoS, PoA) consensus mechanisms as well as scalable approaches (e.g. sharding, sidechains) for workloads in real-world applications (e.g. Smart Cities, Industrial Internet). We examined 16+ cutting edge studies across such as Ethereum, Hyperledger Fabric, and IOTA, for throughput (TPS), energy sustainability, and cryptographic standards (e.g. ECC, ZKP). We show that a hybrid consensus model (e.g. PoS + DAG) or off-chain solutions (e.g. state channels, rollups) added to the performance benefits of IoT networks while still conserving energy costs. Also, we identified research challenges pertaining to Blockchain and IoT interoperability (cross-chain protocols) and post-quantum or lattice based signature cryptography that will serve as a framework for further work. It is our hope that this paper will be a helpful resource for researchers and practitioners looking to quickly, efficiently, and safely engage in Blockchain deployments for IoT.  Β© 2025 IEEE.},
	author_keywords = {Blockchain; DAG-based architectures; Energy-efficient consensus; Internet of Things; Post quantum cryptography},
	keywords = {Energy efficiency; Industrial research; Internet of things; Network security; Quantum cryptography; Scalability; Block-chain; Complexity costs; DAG-based architecture; Decentralisation; Energy; Energy cost; Energy efficient; Energy-efficient consensus; Latency costs; Post quantum cryptography; Blockchain},
	correspondence_address = {K. Saxena; SRM Institute of Science and Technology Delhi-NCR Campus, Faculty of Engineering and Technology, Department of Computer Science & Engineering, Ghaziabad, Uttar Pradesh, India; email: kshitizs@srmist.edu.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
