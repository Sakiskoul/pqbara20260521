	title = {Encryption of Quantum-Resistant Algorithms for Cybersecurity: Enhancement of Post-Quantum Communication and Financial Systems},
	year = {2025},
	journal = {Proceedings - IEEE 10th International Conference on Smart Structures and Systems, ICSSS 2025},
	pages = {},
