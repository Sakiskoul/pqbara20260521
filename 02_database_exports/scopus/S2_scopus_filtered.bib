@ARTICLE{Chaieb2025,
	author = {Chaieb, Marwa and Bou-Chaaya, Karam and Rais, Helmi},
	title = {From Blueprint to Impact: Deploying EHRVault for Secure, Patient-Centered and Privacy-Preserving Electronic Health Record Management},
