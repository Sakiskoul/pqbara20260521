	keywords = {Chains; Data privacy; Data Sharing; Digital storage; Distributed computer systems; Electronic health record; Fault tolerance; Medical computing; Network security; Quantum communication; Quantum cryptography; Random processes; Scalability; Block-chain; Consensus algorithms; Consensus mechanism; Data Sharing; Electronic health; Health records; Healthcare; Post quantum; Post quantum cryptography; Proof of trust; Blockchain; Health care},
