@ARTICLE{Singh2024,
	author = {Singh, Mukund Pratap and Singh, Jagendra and Ravi, Vinayakumar and Gupta, Preeti and Alahmadi, Tahani Jaser and Singh, Prabhishek and Shivahare, Basu Dev and Verma, Manisha},
	title = {Impact and Implications of Quantum Computing on Blockchain-based Electronic Health Record Systems},
	year = {2024},
