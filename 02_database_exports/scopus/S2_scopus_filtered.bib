	affiliations = {POLITEHNICA Bucharest, Romania},
	abstract = {This paper presents a cross-country comparative analysis of public key infrastructure (PKI) systems across seven European Union countriesβ€”Estonia, Germany, France, Romania, Italy, Spain, and the Netherlandsβ€”within the context of the evolving eIDAS 2.0 regulation. The study aims to understand how each country is preparing for the new digital identity and trust framework, focusing on aspects such as governance, mobile identity adoption, technical standards, cybersecurity, and participation in cross-border blockchain pilots. Using a qualitative, document-based methodology, we evaluate the maturity of national digital identity ecosystems based on a multi-factor index that includes population coverage, usage of electronic signatures, and the density of Qualified Trust Service Providers (QTSPs). Estonia and Germany have achieved advanced integration, while Romania and France demonstrate challenges in policy alignment and infrastructure readiness. The analysis identifies common gaps in interoperability, semantic standards, and cryptographic resilience, especially regarding post-quantum security. The study also summarizes the role of national computer security teams and EU agencies such as ENISA [2] in improving trustworthiness across PKI systems. A forward-looking section outlines the path toward harmonized wallet deployment, metadata alignment, and self-sovereign identity integration. The paper concludes with practical recommendations to accelerate policy coordination and technical upgrades necessary for seamless cross-border identity validation under eIDAS 2.0. Β© 2025, Politechnica University of Bucharest. All rights reserved.},
	author_keywords = {Cross-Border Trust; Digital Identity; eIDAS 2.0; ENISA; EU Wallet; Interoperability; PKI; Post-Quantum Cryptography; QTSP},
	keywords = {Authentication; Blockchain; Cybersecurity; Electronic document exchange; Electronic document identification systems; International cooperation; Network security; Population statistics; Public key cryptography; Quantum cryptography; Security systems; Trusted computing; Cross-border; Cross-border trust; Digital identity; EIDAS 2.0; ENISA; EU wallet; Post quantum cryptography; Public key infrastructure; Qualified trust service provider; Service provider; Trust service; Interoperability},
	publisher = {Politechnica University of Bucharest},
	issn = {22863540},
	language = {English},
	abbrev_source_title = {UPB Sci. Bull. Ser. C Electr. Eng. Comput. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

