	year = {2025},
	journal = {Proceedings of 6th International Conference on IoT Based Control Networks and Intelligent Systems, ICICNIS 2025},
	pages = {1236 - 1241},
	doi = {10.1109/ICICNIS66685.2025.11315833},
	url = {https://www.scopus.com/pages/publications/105032748358?origin=resultslist},
	affiliations = {Kalasalingam Academy of Research and Education, Department of Computer Science and Engineering, Tamilnadu, India; Kalasalingam Academy of Research and Education, B.Tech Computer Science and Engineering, Tamilnadu, India},
	abstract = {This paper presents a Quantum Resistant Identity and Access Management (IAM) System tailored for enterprise deployments to mitigate the emerging risk posed by quantum-capable adversaries to classical public-key cryptography. The system integrates NIST-aligned post-quantum cryptographic primitives, a Zero-Trust policy engine, multi-factor and biometric authentication, behavioral analytics driven by machine learning, and a quantum-safe blockchain-based audit trail. Implemented with a React + TypeScript frontend and a Supabase (PostgreSQL) backend, the design prioritizes modularity, scalability, and standards compliance. We describe the system architecture, key modules (cryptographic layer, zero-trust engine, authentication and authorization layers, and governance services), and a testing methodology that includes quantum-attack simulation, behavioral anomaly detection, and performance benchmarking. Experimental validation on a prototype demonstrates acceptable authentication latency, sub-100 ms trust score evaluation, and quantum-resistant key generation within practical bounds for enterprise use. Comparative analysis shows the solution provides unique quantum-resilience and integrated governance advantages against mainstream IAM offerings. We conclude with a roadmap for QKD integration, FIDO2 hardware token support, and AI-driven governance for continued robustness as quantum capabilities evolve. Β© 2025 IEEE.},
