	keywords = {Balancing; Compliance control; Cryptography; Data privacy; Differential privacy; Electronic document identification systems; Information management; Interoperability; Life cycle; Regulatory compliance; Block-chain; Cryptographic accumulator; CryptoGraphics; Decentralised; Decentralized identifier; Digital identity; Privacy; Revocation; Self-sovereign identity; Verifiable credential; Economic and social effects},
