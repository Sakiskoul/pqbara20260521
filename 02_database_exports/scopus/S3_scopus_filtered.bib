@ARTICLE{Li2025,
	author = {Li, Junhao and Nong, Qiang and Liu, Ziyu},
	title = {A resilient fog-enabled IoV architecture: Adaptive post-quantum security framework with generalized signcryption and blockchain-enhanced trust management},
	year = {2025},
	journal = {Journal of Network and Computer Applications},
	volume = {244},
	pages = {},
