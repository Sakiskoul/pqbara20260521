	title = {The Security Performance Analysis of Blockchain System Based on Post-Quantum Cryptography β€” A Case of Cryptocurrency Exchanges},
	year = {2025},
	journal = {Vietnam Journal of Computer Science},
	pages = {},
	doi = {10.1142/S2196888825500204},
