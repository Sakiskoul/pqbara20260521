@ARTICLE{Abdullayev2025123,
	author = {Abdullayev, Vugar and Khang, Alex and Ragimova, Nazila and Almaayah, Mohammed},
	title = {A Novel Authentication Systems in Vehicular Communication: Challenges and Future Directions},
	year = {2025},
	journal = {Journal of Cyber Security and Risk Auditing},
	volume = {2025},
	number = {3},
	pages = {123 - 135},
	doi = {10.63180/jcsra.thestap.2025.3.9},
	url = {https://www.scopus.com/pages/publications/105022927013?origin=resultslist},
	affiliations = {Department of Computer Engineering, Azerbaijan State Oil and Industry University, Baku, Azerbaijan; Department of Information Technology and Systems, Azerbaijan University of Architecture and Construction, Azerbaijan; Global Research Institute of Technology and Engineering, Raleigh, United States; INTI International University, Nilai, 71800, Malaysia},
	abstract = {The emergence of intelligent transportation systems and the widespread deployment of connected and autonomous vehicles (CAVs) have introduced unprecedented security demands in vehicular communication networks. Authentication, as a foundational security service, ensures trust among vehicles, infrastructure, and external entities. However, traditional methods such as Public Key Infrastructure (PKI) often fail to meet the stringent requirements of vehicular environments, including real-time responsiveness, scalability, and user privacy. This paper presents a comprehensive review of novel authentication systems designed for vehicular communication. We classify and analyze state-of-the-art approaches including lightweight cryptographic protocols, group-based schemes, blockchain-integrated authentication, AI-driven behavioral methods, pseudonym-based privacy-preserving mechanisms, and post-quantum crypto-graphic frameworks. Each system is evaluated in terms of latency, privacy, scalability, real-time capability, and maturity level. We further identify key challenges such as certificate revocation, interoperability, and ethical implications. Finally, the paper highlights emerging research directions including federated authentication, quantum-safe security, context-aware mechanisms, and hybrid blockchain-AI solutions. Our analysis serves as a roadmap for researchers and practitioners aiming to develop secure, efficient, and scalable authentication systems for next-generation vehicular networks. Β© 2025, Smart Technologies Academic Press. All rights reserved.},
	author_keywords = {AI-based authentication; authentication systems; blockchain; federated learning; intelligent transportation systems; post-quantum cryptography; privacy preservation; pseudonym schemes; real-time security; V2X security; Vehicular communication},
	correspondence_address = {V. Abdullayev; Department of Computer Engineering, Azerbaijan State Oil and Industry University, Baku, Azerbaijan; email: abdulvugar@mail.ru},
	publisher = {Smart Technologies Academic Press},
	issn = {30795354},
	language = {English},
	abbrev_source_title = {J. cyber secur. risk audit.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14; All Open Access; Gold Open Access}
}

@ARTICLE{Nauman2025,
	author = {Nauman, Umer and Deng, Miaolei and Zhang, Yuhong and Khan, Sheheryar},
	title = {FSDS-OTS: A quantum-resistant, AI-optimized one-time signature scheme for secure distributed ledgers},
	year = {2025},
	journal = {Cluster Computing},
	volume = {28},
	number = {11},
	pages = {},
	doi = {10.1007/s10586-025-05539-y},
	url = {https://www.scopus.com/pages/publications/105015445040?origin=resultslist},
	affiliations = {School of Information Science and Engineering, Henan University of Technology, Henan, Zhengzhou, 450001, China; School of Artificial Intelligence and Big Data, Henan University of Technology, Henan, Zhengzhou, 450001, China; School of Water Conservancy and Transportation, Zhengzhou University, Henan, Zhengzhou, 450001, China},
	abstract = {The fast progression of quantum computing (QC) presents a considerable risk to traditional cryptography techniques, such as the Elliptic Curve Digital Signature Algorithm (ECDSA) and RSA, both of which are susceptible to quantum assaults. The threat pertains to Distributed Ledger Technologies (DLTs), including blockchain, which depend on certain cryptographic principles for security and integrity. We present Future-Secure Digital Signatures (FSDS), an innovative quantum-resistant digital authentication architecture designed for next-generation ledger systems, to address this difficulty. FSDS improves current hash-based digital signatures (HBS) using lattice-based cryptography and multi-party computing (MPC), providing enhanced post-quantum security assurances. In contrast to traditional HBS schemes like the Extended Merkle Signature Scheme (XMSS), FSDS use zero-knowledge proofs (ZKPs) to enhance the efficiency of public key and signature dimensions while maintaining security integrity. Our experimental findings indicate that FSDS diminishes key size by 70% and enhances signature generation time by 65% in comparison to state-of-the-art post-quantum systems like Dilithium and SPHINCS+. Furthermore, the FSDS-One-Time Signature (FSDS-OTS) methodology utilizes homomorphic encryption (HE) to augment signature efficiency, diminishing signature size by 75% compared to conventional approaches such as Winternitz One-Time Signature (WOTS) and WOTS+. Moreover, FSDS is engineered to interact effortlessly with quantum-resistant blockchain frameworks utilizing High-Level Petri Nets (HLPNs), guaranteeing resilience, efficiency, and scalability for secure decentralized systems. These developments establish FSDS as a very versatile and effective post-quantum digital signature architecture for future-proof ledger technologies. Β© The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
	author_keywords = {Distributed ledgers security; Future-secure digital signatures (FSDS); Lattice-based cryptography; One-time signature (OTS); Post-quantum cryptography; Zero-knowledge proofs (ZKPs)},
	keywords = {Authentication; Computer architecture; Data privacy; Distributed computer systems; Distributed ledger; Electronic document identification systems; Network security; Public key cryptography; Quantum computers; Quantum efficiency; Quantum theory; Distributed ledger security; Future-secure digital signature; Lattice-based cryptography; One-time signature; Post quantum cryptography; Secure digital; Signature Scheme; Zero-knowledge proof; Zero-knowledge proofs; Quantum cryptography},
	correspondence_address = {M. Deng; School of Information Science and Engineering, Henan University of Technology, Zhengzhou, Henan, 450001, China; email: dengmiaolei@haut.edu.cn},
	publisher = {Springer},
	issn = {13867857},
	language = {English},
	abbrev_source_title = {Cluster Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Parameswari2025,
	author = {Parameswari, S. and Latha, B.},
	title = {ChainFort: Hybrid Blockchain-Orchestrated Firmware Validation and Secure Update Delivery Using PQC and Federated Trust Consensus},
	year = {2025},
	journal = {2025 IEEE Pune Section International Conference, PuneCon 2025},
	pages = {},
	doi = {10.1109/PuneCon67554.2025.11378371},
	url = {https://www.scopus.com/pages/publications/105034644633?origin=resultslist},
	affiliations = {Sri Sairam Engineering College, Department of Computer Science and Engineering, Tamilnadu, Chennai, 600132, India},
	abstract = {IoT and embedded system firmware updates are becoming more susceptible to online assaults, hacking, and a new quantum threat. This study proposes ChainFort, which is a hybrid blockchain managed framework that incorporates post-quantum cryptography (PQC), federated trust consensus (FTC), and AI-assisted anomaly detection, to safeguard the validation and distribution of firmware. Metadata of the firmware is prehashed and metadata of the network traffic is stored on a permissioned blockchain to permit tamper-proof provenance verification. The PQC layer makes use of CRYSTALS-Dilithium to sign messages and Kyber512 to encrypt them, which is quantum-resistant. ftc is dynamically trusted to nodes by using Proof-of-Federated-Authenticity (PoFA) and swarm-efficient validator selection and balances between decentralization and efficiency. A Blockchain-LSTM Fusion Monitor (BLFM) is an LSTM-based anomaly detection method, which detects the presence of an anomalous firmware behavior to roll back to a verified snapshot. Experimental analysis with sets of IoT firmware and simulated network conditions illustrates 96.8 percent anomaly detection precision, 42 percent less update latency and well-balanced trust-weighted validation of the heterogeneous nodes. The framework proposed provides a holistic, scaleable, and forward-compatible secure firmware management solution, which fills the gap between the conventional blockchain solutions and quantum-resilient, decentralized, IoT-security. Β© 2025 IEEE.},
	author_keywords = {ChainFort; Firmware; IoT Security; LSTM; Post-Quantum Cryptography; Proof-of-Federated Authenticity},
	keywords = {Anomaly detection; Authentication; Blockchain; Embedded systems; Long short-term memory; Metadata; Network security; Quantum cryptography; Trusted computing; Anomaly detection; Block-chain; Chainfort; Embedded-system; IoT security; LSTM; Post quantum cryptography; Proof-of-federated authenticity; Secure updates; System firmware; Firmware},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158834-2},
	language = {English},
	abbrev_source_title = {IEEE Pune Sect. Int. Conf., PuneCon},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

