@CONFERENCE{Velmurugan20251313,
	author = {Velmurugan, M. and Rajeev Kumar, M.},
	title = {Quantum-Resistant Cloud Blockchain Scalability using Federated Multi-Signature Aggregation and Adaptive BLS Digital Signatures},
	year = {2025},
	journal = {Proceedings of 3rd International Conference on Intelligent Cyber Physical Systems and Internet of Things, ICoICI 2025},
	pages = {1313 - 1320},
	doi = {10.1109/ICoICI65217.2025.11252633},
	url = {https://www.scopus.com/pages/publications/105030338049?origin=resultslist},
	affiliations = {Vel Tech Rangarajan Dr. Sagunthala R&d Institute of Science and Technology, Department of Computer Science and Engineering, Tamil Nadu, Chennai, 600062, India},
	abstract = {Blockchain technology, though revolutionary, still has a long way to go in becoming a scalable, secure, and efficient technology to operate in a large-scale cloud environment, especially on the impending quantum attacks. The following paper suggests a new paradigm, the Quantum-Resistant Cloud Blockchain Scalability with Federated Multi-Signature Aggregation and Adaptive BLS Digital Signatures, that is supposed to help solve these acute constraints. The suggested architecture takes advantage of federated multi-signature aggregation to allow the effortless cross-cloud interaction and safe transaction validation within distributed, multi-tenant cloud environments. The system uses adaptive BonehLynnShacham (BLS) digital signatures that are post-quantum resistant and provides strong cryptographic security and scalable block validation. The federated solution allows dynamic aggregation of signatures across different nodes of the cloud, so that communication overheads are minimized and the solution is consensus and even in adversarial or partitioned cases. The high level of performance analysis proves that this system is better in terms of transaction throughput, lower latency, and quantum and classical attack resistance compared to traditional RSA, DSA, or a standalone blockchain system using the BLS. This framework provides a solid basis of the next-generation decentralized applications in the field of finance, healthcare, and IoT, which require elastic scalability and future-proof security in heterogeneous clouds.  Β© 2025 IEEE.},
	author_keywords = {Blockchain technology; Boneh-Lynn-Shacham (BLS) digital signatures; Cryptographic Security; Large-Scale cloud environments},
	keywords = {Agglomeration; Authentication; Blockchain; Cloud security; Computer architecture; Distributed cloud; Electronic document identification systems; Network security; Quantum cryptography; Block-chain; Blockchain technology; Boneh-lynn-shacham  digital signature; Cloud environments; Cryptographic security; Efficient technology; Large-scale cloud environment; Large-scales; Multi tenants; Multi-signature; Scalability},
