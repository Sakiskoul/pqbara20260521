	keywords = {Agriculture; Antennas; Application Layer; Data privacy; Drones; Hierarchical clustering; Information management; Interoperability; Military operations; Multilayers; Network architecture; Network layers; Network security; Physical layer; Public key cryptography; Quantum communication; Quantum cryptography; Secure communication; Aerial vehicle; Block-chain; CryptoGraphics; Key-management; Lightweight encryption; Physical layer security; Post quantum cryptography; Unmanned aerial vehicle communication; Vehicle communications; Vehicle network; Blockchain},
	correspondence_address = {S. Sarkar; Department of Computer Science, Bellarmine University, Louisville, 2001 Newburg Rd, 40205, United States; email: ssarkar@bellarmine.edu},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
