	keywords = {Blockchain; Computer privacy; Differential privacy; Embedded systems; Environmental monitoring; Internet of things; Learning systems; Network security; Neural networks; Privacy-preserving techniques; Public health; AIoT; Block-chain; Blockchain security; Differential privacies; Edge computing; Environmental Monitoring; Environmental pollutions; Post quantum cryptography; Tinyml; Zero-knowledge proofs; Edge computing},
