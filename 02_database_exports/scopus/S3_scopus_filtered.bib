@ARTICLE{Cadi2025281,
	author = {Cadi, Abderrahmane and Bahnasse, Ayoub and Majdoul, Radouane},
	title = {SDN Security on IT and OT Networks: A Systematic Literature Review},
	year = {2025},
	journal = {Sustainable Civil Infrastructures},
	pages = {281 - 290},
	doi = {10.1007/978-3-031-86705-7_26},
	url = {https://www.scopus.com/pages/publications/105003635213?origin=resultslist},
	affiliations = {Laboratory LCCPS ENSAM, Hassan II University, Casablanca, Morocco; Laboratory LISPS2 ENSAM, Hassan II University, Casablanca, Morocco},
	abstract = {The rapid evolution of Software-Defined Networking (SDN) has significantly transformed the landscape of network management and configuration, particularly within Information Technology (IT) and Operations Technology (OT) environments. Despite these advancements, SDN introduces new security and privacy challenges that require further investigation. This systematic literature review (SLR) analyzes existing research from 2016 to 2024, focusing on the key security and privacy concerns in SDN, particularly across the data plane, control plane, and application plane. We categorize and evaluate the main threats, including unauthorized access, denial of service (DoS) attacks, and advanced persistent threats (APTs), while also reviewing proposed solutions such as encryption techniques, intrusion detection systems (IDS), and blockchain-based security frameworks. Our analysis highlights trends in the evolution of security solutions, revealing a shift from conventional methods such as basic encryption to more adaptive approaches that incorporate AI, machine learning, and quantum-safe protocols. This review also identifies gaps in the current body of research, particularly in the areas of SDN integration with emerging technologies such as the Internet of Things (IoT), 5G, and edge computing. We conclude with recommendations for future research to address these challenges, including the need for standardized security protocols, advanced AI-driven threat detection, and secure, scalable frameworks for SDN in IT and OT networks. Β© The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {Access Control; Cyber Attacks; DDOS; Encryption; IOT Networks; IT-OT networks; Literature Review; Privacy; SDN; Security; Software-Defined Networking; SRL},
	keywords = {Access control models; Application programs; Authorization; Information management; Medium access control; Network intrusion; Sensitive data; Cyber-attacks; DDOS; Information technology-operation technology network; IOT networks; Literature reviews; Privacy; Security; Software-defined networkings; SRL; Technology network; Authentication},
	correspondence_address = {R. Majdoul; Laboratory LCCPS ENSAM, Hassan II University, Casablanca, Morocco; email: r.majdoul@gmail.com; A. Bahnasse; Laboratory LISPS2 ENSAM, Hassan II University, Casablanca, Morocco; email: a.bahnasse@gmail.com},
