	year = {2025},
	journal = {Proceedings of 3rd International Conference on Sustainable Computing and Data Communication Systems, ICSCDS 2025},
	pages = {35 - 41},
	doi = {10.1109/ICSCDS65426.2025.11167656},
	url = {https://www.scopus.com/pages/publications/105018460491?origin=resultslist},
	affiliations = {Delta Dental Insurance Company, GA, United States; Taylor Corporation, MN, United States; Ibm Corporation, OH, United States; Piorion Solutions Inc, NY, United States; Tagore Institute of Engineering & Technology, Department of Computer Science & Engineering, Salem, India},
	abstract = {The rapid proliferation of healthcare data requires robust systems ensuring-security, privacy, and scalability. Hence, this paper puts forward a cloud-based healthcare data management framework with steep blockchain integration, biometric authentication, and DAG to address the aforementioned challenges. In this context, the blockchain acts as an immutable, tamper-proof, decentralized ledger for keeping confidential medical records. On the contrary, biometric systems would assert the identity of every accessing individual possessing patient data using biological traits such as fingerprints or retinal scans. By having the DAG implement parallel processing to increase scalability and boost transaction throughput, it avoids the long latencies of traditional blockchain systems. The proposed framework comprises capsule networks to classify diseases accurately by maintaining the spatial hierarchies inherent in medical data. The complete simulations establish that the combined system provides 98% integrity and privacy for data while substantially slashing transaction times to 50.2 ms and enhanced scalability by 3.0x compared to independent solutions. This combination of technologies yields a decentralized, secure, and efficient setup suitable for high-throughput healthcare environments. Future upgrades could include incorporation of Edge AI for local processing, federated learning to boost privacy protection during model training, and quantum-resistant cryptographic protocols to safeguard against future security threats. This work provides the foundation for future healthcare systems that can efficiently handle big-scale medical data while protecting patient confidentiality and system efficiency.  Β© 2025 IEEE.},
	author_keywords = {Biometric Authentication; Blockchain; Cloud-based System; Decentralized Health Care; Directed Acyclic Graph (DAG); Health Data Management; Privacy; Scalability; Security},
	keywords = {Authentication; Big data; Biometrics; Cryptography; Data privacy; Distributed computer systems; Health care; Hospital data processing; Information management; Medical computing; Network security; Acyclic graphs; Biometric authentication; Block-chain; Cloud-based; Cloud-based system; Decentralised; Decentralized health care; Directed acyclic graph; Health data; Health data management; Privacy; Security; Blockchain; Scalability},
