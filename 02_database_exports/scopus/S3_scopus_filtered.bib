	keywords = {Authentication; Blockchain; Combinatorial mathematics; Cryptocurrency; Quantum communication; Quantum cryptography; Secure communication; Software prototyping; Web browsers; Combinatorics; Distribution mechanism; Forward secrecy; Key distribution; Key sizes; Non-conjectured hardness; One time pads; Quantum safe; Shannon; Vernam ciphers; Quantum noise},
