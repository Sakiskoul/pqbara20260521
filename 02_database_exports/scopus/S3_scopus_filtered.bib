@ARTICLE{Qayyum2025,
	author = {Qayyum, Tariq and Trabelsi, Zouheir and Tariq, Asadullah and Adel Serhani, Mohamed and Din, Irfanud and Ahmad, Shabir},
	title = {A Quantum-Resilient Sharded Blockchain Framework for Secure V2X and Federated Learning in Intelligent Transportation Systems},
	year = {2025},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	pages = {},
	doi = {10.1109/TITS.2025.3614888},
	url = {https://www.scopus.com/pages/publications/105019094760?origin=resultslist},
	affiliations = {United Arab Emirates University, College of Information Technology, Al Ain, United Arab Emirates; University of Sharjah, College of Computing and Informatics, Sharjah, United Arab Emirates; New Uzbekistan University, Tashkent, 100007, Uzbekistan; Center of Artificial Intelligence for Medical Instruments, Incheon, 22532, South Korea},
	abstract = {The emergence of large-scale quantum computers threatens the security of classical public-key cryptosystems, making it essential to adopt post-quantum (PQ) security in Intelligent Transportation Systems (ITS). We introduce a framework that blends quantum-resilient cryptographic primitives with a sharded blockchain architecture. Each shard maintains a local ledger for its vehicle group, enabling real-time transactions and efficient certificate management without overloading any single chain. A lightweight global chain periodically anchors all shards, preserving system-wide consistency and blocking malicious revocations. Vehicles register or revoke PQ credentials via a lightweight Proof-of-Stake consensus, while roadside units (RSUs) handle signature verification to offload on-board computation. We further demonstrate practicality through a federated-learning case study in which vehicles exchange signed model updates over the same secure channel. SUMO/TraCI simulations with 2β€†000 vehicles and 10 shards show that despite PQ overhead the system sustains near real-time delays and high throughput. The framework thus offers a decentralized, quantum-resilient solution for secure Vehicle-to-Everything communications in next-generation ITS. Β© 2000-2011 IEEE.},
	author_keywords = {intelligent transportation systems (ITS); post-quantum blockchain; quantum-resilient algorithms; Quantum-resilient cryptography; sharding; vehicular communication (V2X)},
	keywords = {Blockchain; Chains; Intelligent vehicle highway systems; Network security; Public key cryptography; Quantum communication; Quantum cryptography; Qubits; Traffic control; Vehicles; Block-chain; Intelligent transportation system; Intelligent transportation systems; Post quantum; Post-quantum blockchain; Quantum-resilient algorithm; Quantum-resilient cryptography; Sharding; Vehicular communication (V2X); Vehicular communications; Intelligent systems},
	correspondence_address = {Z. Trabelsi; United Arab Emirates University, College of Information Technology, Al Ain, United Arab Emirates; email: trabelsi@uaeu.ac.ae},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15249050},
