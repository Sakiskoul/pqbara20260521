@ARTICLE{Ishchukova2025,
	author = {Ishchukova, Evgeniya and Petrenko, Sergei and Petrenko, Alexey and Gnidko, Konstantin and Nekrasov, Alexey},
	title = {Potential Vulnerabilities of Cryptographic Primitives in Modern Blockchain Platforms},
	year = {2025},
	journal = {Sci},
	volume = {7},
	number = {3},
	pages = {},
	doi = {10.3390/sci7030112},
	url = {https://www.scopus.com/pages/publications/105017183258?origin=resultslist},
	affiliations = {Scientific Center for Information Technologies and Artificial Intelligence, Sirius University of Science and Technology, Sirius Federal Territory, Sochi, 354340, Russian Federation; Institute for Computer Technologies and Information Security, Southern Federal University, Chekhova 2, Taganrog, 347922, Russian Federation},
	abstract = {Today, blockchain technologies are a separate, rapidly developing area. With rapid development, they open up a number of scientific problems. One of these problems is the problem of reliability, which is primarily associated with the use of cryptographic primitives. The threat of the emergence of quantum computers is now widely discussed, in connection with which the direction of post-quantum cryptography is actively developing. Nevertheless, the most popular blockchain platforms (such as Bitcoin and Ethereum) use asymmetric cryptography based on elliptic curves. Here, cryptographic primitives for blockchain systems are divided into four groups according to their functionality: keyless, single-key, dual-key, and hybrid. The main attention in the work is paid to the most significant cryptographic primitives for blockchain systems: keyless and single-key. This manuscript discusses possible scenarios in which, during practical implementation, the mathematical foundations embedded in the algorithms for generating a digital signature and encrypting data using algorithms based on elliptic curves are violated. In this case, vulnerabilities arise that can lead to the compromise of a private key or a substitution of a digital signature. We consider cases of vulnerabilities in a blockchain system due to incorrect use of a cryptographic primitive, describe the problem, formulate the problem statement, and assess its complexity for each case. For each case, strict calculations of the maximum computational costs are given when the conditions of the case under consideration are met. Among other things, we present a new version of the encryption algorithm for data stored in blockchain systems or transmitted between blockchain systems using elliptic curves. This algorithm is not the main blockchain algorithm and is not included in the core of modern blockchain systems. This algorithm allows the use of the same keys that system users have in order to store sensitive user data in an open blockchain database in encrypted form. At the same time, possible vulnerabilities that may arise from incorrect implementation of this algorithm are considered. The scenarios formulated in the article can be used to test the reliability of both newly created blockchain platforms and to study long-existing ones. Β© 2025 by the authors.},
	author_keywords = {blockchain; cryptanalysis; cryptography; elliptic curve; encryption; private key; public key; signature; strength},
	correspondence_address = {E. Ishchukova; Scientific Center for Information Technologies and Artificial Intelligence, Sirius University of Science and Technology, Sirius Federal Territory, Sochi, 354340, Russian Federation; email: jekky82@mail.ru},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {24134155},
	language = {English},
	abbrev_source_title = {Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Kuninets2026,
	author = {Kuninets, Artyom and Malygina, Ekaterina and Nesterenko, Alexey and Kurochkin, Alexey},
	title = {On a lattice-based post-quantum ring signature scheme},
	year = {2026},
	journal = {Journal of Computer Virology and Hacking Techniques},
	volume = {22},
	number = {1},
	pages = {},
	doi = {10.1007/s11416-025-00593-x},
	url = {https://www.scopus.com/pages/publications/105027917279?origin=resultslist},
	affiliations = {MIEM, National Research University Higher School of Economics, Moscow, Russian Federation; A Software Development Company that Provides Information Security Solutions Based on Quantum-Resistant (Post-Quantum) Encryption Algorithms, QApp, Moscow, Russian Federation; Blockchain Laborotory, Sberbank of Russia, Moscow, Russian Federation},
	abstract = {This work describes a post-quantum lattice-based linkable ring signature scheme over NTRU lattices, constructed within the Raptor framework. Our design incorporates the Ducasβ€“Prest Gaussian sampler, the signature generation and verification algorithms from the Falcon scheme, and the key generation algorithm from the Mitaka scheme. This hybrid approach combines Falconβ€™s compact signatures and fast verification with Mitakaβ€™s efficient key generation and enhanced resistance to side-channel attacks. We obtain our scheme by adapting Falconβ€™s signing and verification procedures to operate with the Ducasβ€“Prest sampler and Mitaka-style trapdoor generation. This yields a construction that maintains competitive performance for small ring sizes while avoiding floating-point arithmetic, making it more suitable for constrained or embedded platforms. The resulting scheme leverages the advantages of the original Raptor framework and the Mitaka scheme, offering a favorable balance between signature size, verification speed, and computational complexity, while enabling instantiation over a wide range of cyclotomic parameters. An additional feature of the proposed ring signature is the ability to choose an arbitrary number of ring members. Moreover, for the small ring sizes required in most blockchain applications, we achieve public key and signature sizes comparable to other lattice-based ring signatures that do not allow such flexibility in the number of ring members. Finally, we discuss signature applicability in privacy-focused blockchain protocols such as Monero, where linkable ring signatures enable unlinkability and accountability, and in confidential asset systems, where multi-asset transaction integrity and anonymity must be preserved. Β© The Author(s), under exclusive licence to Springer-Verlag France SAS, part of Springer Nature 2026.},
	author_keywords = {Blockchain technology; Lattice-based cryptography; Linkable ring signatures; Post-quantum cryptography},
	keywords = {Authentication; Blockchain; Crystal lattices; Electronic document identification systems; Embedded systems; Network security; Public key cryptography; Quantum cryptography; Side channel attack; Block-chain; Blockchain technology; Generation algorithm; Key generation; Lattice-based; Lattice-based cryptography; Linkable ring signatures; Post quantum; Post quantum cryptography; Ring signature schemes; Digital arithmetic},
	correspondence_address = {A. Kuninets; MIEM, National Research University Higher School of Economics, Moscow, Russian Federation; email: artkuninets@yandex.ru; E. Malygina; MIEM, National Research University Higher School of Economics, Moscow, Russian Federation; email: EMalygina@hse.ru; A. Kurochkin; Blockchain Laborotory, Sberbank of Russia, Moscow, Russian Federation; email: AVyKurochkin@sberbank.ru},
	publisher = {Springer-Verlag Italia s.r.l.},
