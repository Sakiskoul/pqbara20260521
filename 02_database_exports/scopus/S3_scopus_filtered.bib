@CONFERENCE{Tonoy2025422,
	author = {Tonoy, Md Thouhedul Alam and Baveja, Mannu and Chanda, Partha and Bin Taleb Abrar, Mohammad Yasir and Moon, Md. Fazle Rabbi},
	title = {Establishing Quantum-Classical Trust: Initialization and Key Exchange Phase},
	year = {2025},
	journal = {Proceedings of the 2025 International Conference on Artificial Intelligence and Emerging Technology, Global AI Summit 2025},
	pages = {422 - 425},
	doi = {10.1109/AISummit66170.2025.11411253},
	url = {https://www.scopus.com/pages/publications/105035324112?origin=resultslist},
	affiliations = {Chandigarh University, Mohali, India},
	abstract = {Quantum computing poses threats to existing cryptographic protocols like RSA and ECC. We propose QUBE-Crypto, a hybrid framework integrating Quantum Key Distribution (QKD), Post-Quantum Digital Signatures, Blockchain storage, and Pseudorandom Quantum States (PRSs). This architecture provides zero-trust authentication with provable security against classical and quantum attacks. Complexity analysis shows O(nlogn) authentication overhead with 150-260ms latency, suitable for IoT (ESP32), 5G/6G networks, and government deployments. Our system combines blockchain-secured identity registration with BB84 QKD, PRS-based challenges, and postquantum signatures (Dilithium-5, SQIsignHD), optimized for resource-constrained devices. Β© 2025 IEEE.},
