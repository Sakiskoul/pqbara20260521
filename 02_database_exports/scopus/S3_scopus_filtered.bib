	title = {Optimized Post-Quantum Attribute-Based Logging for Real-Time and Tamper-Evident Cloud Forensics},
	year = {2026},
	journal = {IEEE Transactions on Cloud Computing},
	pages = {},
	doi = {10.1109/TCC.2026.3681599},
	url = {https://www.scopus.com/pages/publications/105035665922?origin=resultslist},
	affiliations = {Thammasat University, Sirindhorn International Institute of Technology, Thailand},
	abstract = {Secure audit logging is essential for cloud forensics, yet existing schemes suffer from fundamental limitations. Classical hash-chaining, pairing-based, and RSA/ECC-based logging lose evidential validity under key compromise and quantum attacks, while blockchain-assisted approaches rely on pre-quantum primitives and periodic verification, leaving temporal windows exploitable by insiders. This paper presents Post-Quantum Attribute-Based Logging (PQ-ABL), a quantum-resilient forensic logging framework with continuous integrity assurance. PQ-ABL employs lattice-based CP-ABE to enforce fine-grained, post-quantum access control, while log payloads are efficiently protected using AES-GCM. Integrity is achieved through an epoch-driven verification model that anchors a single Merkle root per epoch on the blockchain, enabling linear-time O(N) full-epoch validation, constant-time O(1) local record consistency checking after epoch validation, and O(log N) standalone record membership verification, without requiring per-record authentication proofs during epoch validation. The key contribution is an integrity design that decouples post-quantum authorization from verification cost, eliminating forensic blind spots inherent in periodic anchoring. Security analysis proves confidentiality and integrity under standard lattice hardness assumptions. Experimental results show that PQ-ABL reduces verification latency by 31.8% and computation cost by 38.6% compared with existing post-quantum and blockchain-based logging schemes. Β© 2013 IEEE.},
	author_keywords = {audit; blockchain; cloud forensics; integrity; logging; quantum attack},
	keywords = {Access control; Computer forensics; Cost benefit analysis; Electronic crime countermeasures; Forensic engineering; Logging (forestry); Quantum cryptography; Attribute-based; Audit; Block-chain; Cloud forensics; Fundamental limitations; Integrity; Post quantum; Quantum attack; Real- time; Tamper-evident; Blockchain},
	correspondence_address = {S. Fugkeaw; Thammasat University, Sirindhorn International Institute of Technology, Thailand; email: somchart@siit.tu.ac.th},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
