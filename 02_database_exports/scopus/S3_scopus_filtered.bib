@ARTICLE{Ravisankar2025,
	author = {Ravisankar, Sivasubramanian and Maheswar, Rajagopal},
	title = {SecureEdge-MedChain: A Post-Quantum Blockchain and Federated Learning Framework for Real-Time Predictive Diagnostics in IoMT},
	year = {2025},
	journal = {Sensors},
	volume = {25},
	number = {19},
	pages = {},
	doi = {10.3390/s25195988},
