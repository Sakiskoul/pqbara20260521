@CONFERENCE{Dhayal2025786,
	author = {Dhayal, Dhruv and Preeti and Varshney, Pankaj Kr. and Wadhwani, Ganesh Kr.},
	title = {Quantum-Resistant Blockchain Authentication Protocol: Securing Decentralized Systems Against Post-Quantum Attacks},
	year = {2025},
	journal = {2025 2nd International Conference on Multidisciplinary Research and Innovations in Engineering, MRIE 2025},
	pages = {786 - 790},
	doi = {10.1109/MRIE66930.2025.11156407},
	url = {https://www.scopus.com/pages/publications/105018803099?origin=resultslist},
	affiliations = {Iitm Janakpuri, Department of Computer Science, New Delhi, India},
	abstract = {The fast growth of quantum computing makes the old modes of cryptography, be it RSA or ECC, weak to quantum attacks, especially when it employs Shor's algorithm. Threatening also builds up on the post-quantum age regarding blockchain technology and its external cryptography, which secures reliable transactions and authentication. This study will address the importance of quantum resistant blockchain authentication protocols for the security of decentralized systems against any forward-looking quantum-enabled attacks. This paper goes through different classifications of post-quantum cryptography like lattice-based, hash-based, multivariate polynomial, and code-based cryptography, taking an effort to analyze their compatibility with blockchain use cases.[8] Moreover, we also introduce the innovative quantum-resistant authentication model designed to enhance security while not compromising upon efficiency.[2] [3] Our proposed model would ensure scalability and less computational overhead by partially providing immunity to quantum adversaries through its underlying use of post-quantum signature schemes and lightweight key exchange mechanisms. This research aims at laying the foundation for developing a secure blockchain ecosystem against quantum threats, heading toward a resistant future-proof decentralized infrastructure. Β© 2025 IEEE.},
