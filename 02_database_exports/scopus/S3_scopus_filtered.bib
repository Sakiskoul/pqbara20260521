@ARTICLE{El Baraka20261,
	author = {El Baraka, Mohammed and Siham, Ezzouak},
	title = {Quantum-resistant modifications to ECDSA for blockchain security},
	year = {2026},
	journal = {Journal of Cyber Security Technology},
	volume = {10},
	number = {1},
	pages = {1 - 19},
	doi = {10.1080/23742917.2025.2458320},
	url = {https://www.scopus.com/pages/publications/85216900725?origin=resultslist},
	affiliations = {Mathematics Department, Faculty of sciences Dhar Al Mahraz, Sidi Mohammed Ben Abdellah University, Fez, Morocco},
	abstract = {Quantum computing advances, exemplified by Shorβ€™s algorithm, pose a serious threat to classical Elliptic Curve Digital Signature Algorithm (ECDSA) security. This paper proposes and analyzes three strategies for enhancing ECDSAβ€™s resistance to quantum attacks: (1) Hybrid ECDSA, which pairs ECDSA with a post-quantum signature scheme; (2) a Layered Security model that sequentially verifies classical and post-quantum signatures; and (3) Modified ECDSA, focused on tuning parameters like field size and nonce generation. We provide a unified mathematical foundation, present security arguments (including formal verification), and offer a comparative performance matrix that covers key generation, signing, and verification times. Our study underscores that each solution entails a distinct balance of performance overhead and future-proof security, thus enabling blockchain and IoT stakeholders to make informed, context-specific decisions. Β© 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {blockchain applications; ECDSA; hybrid cryptography; post-quantum security; quantum resistance},
	keywords = {Authentication; Blockchain; Electronic crime countermeasures; Quantum cryptography; Quantum electronics; Block-chain; Blockchain application; Elliptic curve digital signature algorithm; Hybrid cryptography; Post quantum; Post-quantum securities; Quantum Computing; Quantum resistance; Quantum signature; S-algorithms; Quantum computers},
	correspondence_address = {M. El Baraka; Mathematics Department, Faculty of sciences Dhar Al Mahraz, Sidi Mohammed Ben Abdellah University, Fez, 30000, Morocco; email: mohammed.elbaraka5@usmba.ac.ma},
	publisher = {Taylor and Francis Ltd.},
	issn = {23742917},
	language = {English},
	abbrev_source_title = {J. Cyber Secur. Technol.},
