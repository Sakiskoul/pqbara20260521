@CONFERENCE{Agrawal2025,
	author = {Agrawal, Arun and Jena, Akankshya and Mohanty, Pratyusha},
	title = {Quantum-Secure Blockchain Authentication Protocol for 6G Devices},
	year = {2025},
	journal = {International Conference on Emerging Technologies in Electronics and Green Energy, ICETEG 2025},
	pages = {},
	doi = {10.1109/ICETEG66194.2025.11473057},
	url = {https://www.scopus.com/pages/publications/105037576670?origin=resultslist},
	affiliations = {ITER, Siksha 'o' Anusandhan, (Deemed To Be) University, Department of Ece, Bhubaneswar, India},
	abstract = {As 6G networks are about to serve billions of devices, secure and reliable authentication is a key challenge. Conventional authentication solutions are under attack from both centralized and future quantum computing threats. This paper introduces a new authentication protocol that incorporates randomness generated by quantum mechanics and blockchain technology to achieve a lightweight, decentralized, and post-quantum secure solution for 6G scenarios. Each device creates a truly random key from a Quantum Random Number Generator (QRNG), and this key is then securely stored on a blockchain in hashed form. When the device tries to join the network, its key is checked against the blockchain ledger to provide for one-time, tamper- evident authentication without the need for centralized servers. The protocol is designed to support smart contracts for expiry and revocation of keys, rendering it appropriate for dense and highly dynamic 6G networks. Our system provides increased security, immunity against future quantum attacks, and efficient scaling for IoT, healthcare, and autonomous communication systems. Β© 2025 IEEE.},
	author_keywords = {6G Networks; Authentication; Blockchain; IoT; Post- Quantum Security; Quantum Random Number Generator (QRNG); Smart Contract},
