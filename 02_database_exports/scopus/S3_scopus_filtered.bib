@CONFERENCE{Harde2025,
	author = {Harde, Trupti Suresh and Bokade, Sweta},
	title = {Iterative and Empirical Models for Quantum Blockchain in IoT Security: A Systematic Review and Performance Analysis},
	year = {2025},
	journal = {2025 International Conference on Artificial Intelligence and Quantum Computation-Based Sensor Application, ICAIQSA 2025 - Proceedings},
	pages = {},
	doi = {10.1109/ICAIQSA67794.2025.11440460},
	url = {https://www.scopus.com/pages/publications/105036663947?origin=resultslist},
	affiliations = {Jhulelal Institute of Technology (JIT), Computer Science Engineering, Nagpur, India},
	abstract = {With billions of resource-constrained devices exchanging sensitive data over heterogeneous networks, the fast-growing expansion of the Internet of Things (IoT) has heightened the concerns of security. In this regard, classical blockchain, despite its promise, has two main disadvantages: it cannot scale properly under massive IoT traffic and it can be vulnerable to quantum adversaries. This work attempts to fill these gaps through an analytical and empirical review of thirty recent models using blockchain, post-quantum cryptography, and quantum-native approaches. Conducted under the PRISMA guidelines, this review systematically examines how its models perform with respect to common security metrics: delay, complexity, throughput, security efficiency, and packet delivery ratio. The findings of the study suggest that regular adaptive blockchains with dynamic block size optimization and lightweight hashing consistently achieve high throughput (>900 Tx/sec) and packet delivery ratios (>95%) in IoT environments making them the most feasible solution in near term. In contrast, post-quantum models, using hybrid encryption and an optimized SIKE provide significantly enhanced resilience (security efficiency in the range of 92% to 96%) while introducing computational overhead unsuited for low-power devices. The frameworks of quantum blockchain, utilizing QKD-based authentication and heap-driven key distribution, provide unsurpassed security efficiency (>95%) but stay largely constrained experimentally at this stage. The synthesis from the empirical study suggests a multi-layered approach, consisting of immediate implementations of lightweight adaptive models, mid-term enhancements through post-quantum cryptography optimization, and a long-term aim of deployment of full quantum blockchain architecture. Such insights would prove pivotal in IoT sectors with real-time requirements like health, smart grids, and industrial automation, where balancing scalability, efficiency, and quantum resilience is of utmost importance. Hence, the work provides an avenue for foundational mapping of advancement in quantum-secure IoT ecosystems.  Β© 2025 IEEE.},
	author_keywords = {Analysis; Blockchain Security; Internet of Things; IoT Privacy; Post-Quantum Cryptography; Quantum Blockchain},
	keywords = {Authentication; Iterative methods; Network security; Quantum efficiency; Quantum theory; Sensitive data; Analyze; Block-chain; Blockchain security; Empirical model; Internet of thing privacy; Iterative model; Packet delivery ratio; Post quantum cryptography; Quantum blockchain; Blockchain; Quantum cryptography},
