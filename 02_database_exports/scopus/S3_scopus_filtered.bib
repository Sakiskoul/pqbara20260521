@CONFERENCE{Kumar2025,
	author = {Kumar, A. Muthu and Anil, Kodimela and Kumar, Naidu Pavan and Prasad, Pediredla and Raju, V.V Bharath},
	title = {Enhanced Proxy Re-Encryption With Blockchain For Privacy-Preserving IOT Data Exchange},
	year = {2025},
	journal = {International Conference on Computational Robotics, Testing and Engineering Evaluation, ICCRTEE 2025},
	pages = {},
