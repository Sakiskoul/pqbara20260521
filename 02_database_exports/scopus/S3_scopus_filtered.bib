}

@BOOK{LeΓ³n-ChΓ΅vez2022251,
	author = {LeΓ³n-ChΓ΅vez, Miguel Γngel and Perin, Lucas Pandolfo and RodrΓ­guez-HenrΓ­quez, Francisco},
	title = {Post-quantum digital signatures for Bitcoin},
	year = {2022},
	journal = {Principles and Practice of Blockchains},
	pages = {251 - 270},
	doi = {10.1007/978-3-031-10507-4_11},
