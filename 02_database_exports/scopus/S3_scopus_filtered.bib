@ARTICLE{Zaghloul2025,
	author = {Zaghloul, Ahmed S. and Mohamed, Mohamed AbdElAzim and Amer, Hanan M. and Shawky, Mahmoud A.},
	title = {Quantum-resilient trust in motion: Smart-contract-driven authentication for next-gen vehicular networks},
	year = {2025},
	journal = {Computers and Electrical Engineering},
	volume = {128},
	pages = {},
	doi = {10.1016/j.compeleceng.2025.110754},
	url = {https://www.scopus.com/pages/publications/105019192187?origin=resultslist},
	affiliations = {Department of Electronics and Communications Engineering, Faculty of Engineering, Mansoura University, Mansoura, 35516, Egypt; Faculty of Engineering, Mansoura National University, Gamsa, Egypt; James Watt School of Engineering, University of Glasgow, Glasgow, G12 8QQ, United Kingdom; Faculty of Informatics & Computer Science, German International University, Cairo, Egypt; The Egyptian Technical Research and Development Centre, Cairo, 11618, Egypt},
	abstract = {Vehicular ad-hoc networks (VANETs) enable the exchange of critical traffic-related information among vehicles, thereby enhancing road safety and improving traffic management. However, the open and dynamic nature of VANETs exposes them to a range of security threats, including message tampering, impersonation, and privacy breaches. Traditional cryptographic methods, such as elliptic-curve Diffieβ€“Hellman, are increasingly vulnerable to emerging quantum computing capabilities, raising significant concerns about the future resilience of VANET security. To address these challenges, this paper proposes a lattice-based conditional privacy-preserving authentication scheme (SC-LB-CPPA) that leverages the immutable characteristics of blockchain technology. The proposed scheme employs smart contract-based blockchain for dynamic public parameter updates across regions, integrating lattice-based cryptography for quantum-resistant security. Comprehensive security analyses, including informal evaluations and formal proofs using the random oracle model, demonstrate the schemeβ€™s robustness against impersonation and message modification attacks. Furthermore, the schemeβ€™s effectiveness is validated through a practical implementation on the RemixVM. Finally, a comprehensive performance evaluation is conducted to assess the computational and communication overheads, along with the gas costs of the proposed smart contract functions. The comparative analysis confirms the superiority of the proposed approach in terms of signature generation and verification latency, as well as signature size. Β© 2025 Elsevier Ltd.},
	author_keywords = {Decentralized authentication; Lattice-based cryptography; Privacy-preserving authentication; Quantum-resistant cryptography; Smart contracts; Vehicular Ad-Hoc Networks (VANET)},
	keywords = {Authentication; Blockchain; Formal logic; Highway planning; Highway traffic control; Motor transportation; Network security; Privacy-preserving techniques; Public key cryptography; Quantum computers; Quantum cryptography; Smart contract; Block-chain; Critical traffic; Decentralised; Decentralized authentication; Lattice-based cryptography; Privacy-preserving authentication; Quantum-resistant cryptography; Vehicular ad-hoc network; Vehicular Adhoc Networks (VANETs); Vehicular networks; Vehicular ad hoc networks},
	correspondence_address = {M.A. Shawky; James Watt School of Engineering, University of Glasgow, Glasgow, G12 8QQ, United Kingdom; email: m.shawky.1@research.gla.ac.uk},
