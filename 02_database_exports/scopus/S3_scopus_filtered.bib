	author = {Saare, Murtaja Ali and Abdulhamed, Mohamed Abdulrahman and Al-Shareeda, Mahmood A. and Almaiah, Mohammed Amin and Shehab, Rami},
	title = {Artificial Intelligence-Driven and Secure 5G-VANET Architectures for Future Transportation Systems},
	year = {2025},
	journal = {Journal of Robotics and Control (JRC)},
