	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10}
}

@ARTICLE{Li2021253,
	author = {Li, Chaoyang and Tian, Yuan and Chen, Xiubo and Li, Jian},
