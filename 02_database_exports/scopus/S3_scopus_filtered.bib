	author = {Felicetti, Carmelo and Bramstedt, Mikael and Sacca, Domenico},
	title = {Exploiting RedToken for Hardware-Assisted Pre-Authentication for NIST CSF 2.0 Compliance},
	year = {2025},
	journal = {2025 7th International Conference on Blockchain Computing and Applications, BCCA 2025},
