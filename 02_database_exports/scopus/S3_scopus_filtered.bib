	abstract = {Quantum computing has recently risen to prominence as an existential risk to the existing Digital Public Infrastructure (DPI) blockchain deployments (such as RSA, ECC), whose underlying cryptographic primitives (e.g., RSA, ECC) will become computationally feasible to Shor's and Grover's quantum algorithms. In this paper, we present QUADRA (a Quantum-resistant Distributed Resilient Architecture), which incorporates lattice-based post-quantum cryptography into Hyperledger Fabric. For secure key encapsulation and authenticating users and data, QUADRA utilizes CRYSTALS-Kyber and Dilithium, respectively, thereby providing quantum resistance across all layers, from identity management to digital payment and data sharing between departments. The architecture is demonstrated by synthetic DPI workloads on Hyperledger Caliper, under the ECC baseline, TLS-PQC and TLS+TX-PQC profiles. We demonstrate that QUADRA can sustain at least 370 TPS with sub-second latency while preventing replay and MITM adversaries, and is practical for low-power devices, including Raspberry Pi peers. This proof-of-concept positions QUADRA as a scalable, public-oriented, and future-proof design for secure DPI, directly contributing to SDG 9 and SDG 16.  Β© 2025 IEEE.},
	author_keywords = {Digital Public Infrastructure (DPI); Hyperledger Fabric; Post-Quantum Cryptography (PQC); Quantum-Resistant Blockchain; Self-Sovereign Identity (SSI)},
	keywords = {Authentication; Data encapsulation; Electronic money; Public key cryptography; Quantum computers; Quantum cryptography; Block-chain; Cryptographic primitives; Digital public infrastructure; Hyperledger fabric; Post quantum cryptography; Post-quantum cryptography; Public infrastructures; Quantum Computing; Quantum-resistant blockchain; Self-sovereign identity; Blockchain},
	correspondence_address = {J.A.I.S. Masood; Vellore Institute of Technology, Department of Quantum Ai, School of Computer Science and Engineering, Vellore, Tamilnadu, 632014, India; email: jafarali.s@vit.ac.in},
